# Configuracion para alojamiento Apache, como el de Hostinger.
# Vercel y Netlify ignoran este archivo, asi que no estorba en ningun lado.

# La pagina de error del sitio, no la generica del alojamiento.
ErrorDocument 404 /404.html

# Nunca listar el contenido de una carpeta.
Options -Indexes

# El sitio genera los enlaces sin barra final. Apache, por su cuenta, redirige
# /contacto a /contacto/ con un 301 antes de servir nada: un viaje de ida y
# vuelta en cada clic, y ademas la URL que acaba viendose deja de coincidir
# con la canonica que declara la propia pagina.
#
# DirectorySlash Off apaga esa redireccion. La regla de abajo es entonces la
# que sirve el index.html de la carpeta, sin tocar la URL.
#
# El primer intento llevaba una condicion !-d, "solo si no es una carpeta",
# que impedia que la regla entrase precisamente en el unico caso para el que
# estaba escrita.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

# Las fuentes y las imagenes llevan huella en el nombre: cuando cambian,
# cambia la URL. Por eso se pueden guardar un año sin riesgo.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # El HTML no: tiene que poder cambiar en cuanto se sube algo nuevo.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain
</IfModule>
