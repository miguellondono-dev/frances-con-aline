# Variables de entorno del proyecto.
# Copia este archivo a .env y rellena los valores. .env NO se sube al repositorio.
#
# Mientras estas variables falten, los formularios siguen funcionando en el
# navegador pero el envio no llega a ningun sitio: queda registrado en el log
# del servidor con un aviso, y el usuario ve un mensaje que le pide escribir
# directamente. Es deliberado: preferimos un fallo visible a uno silencioso.

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=

# TODO [PENDIENTE] Correo de Miguel donde llegan las notificaciones.
CORREO_NOTIFICACIONES=

# Remitente verificado en Resend. Depende del dominio definitivo.
# TODO [PENDIENTE] dominio
CORREO_REMITENTE="Francés con Aline <hola@PENDIENTE-DOMINIO.example>"

# --- Google Sheets (cuenta de servicio) ---
# La hoja debe estar compartida con el correo de la cuenta de servicio, con
# permiso de edicion. Una pestaña por tipo de formulario:
#   Talleres | Tours | Test | Contacto
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada va entre comillas y con los saltos de linea como \n
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=

# --- Agendamiento (Cal.com) ---
# TODO [PENDIENTE] Cuenta de Cal.com conectada al Google Calendar de Aline,
# con la disponibilidad configurada y un evento gratuito de 30 minutos.
PUBLIC_CALCOM_ENLACE=
