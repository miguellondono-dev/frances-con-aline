---
import Logo from './Logo.astro';
import Cta from './Cta.astro';
import { NAV, SITE_NAME, CTA_AGENDA, CTA } from '../data/site';

/** Recorte del viewBox al ojo del logo, sin el aire del archivo original. */
const OJO = '195 258 860 691';

const current = Astro.url.pathname;

/** Marca la entrada activa aunque la ruta actual sea uno de sus hijos. */
function activa(item: (typeof NAV)[number]) {
  if (item.href) return current === item.href;
  return item.hijos?.some((hijo) => hijo.href === current) ?? false;
}
---

<header data-header data-scrolled="false" class="barra sticky top-0 z-40">
  <div class="shell flex items-center justify-between gap-6 py-4">
    <a
      href="/"
      class="-my-2 flex min-h-11 shrink-0 items-center gap-3 py-2 text-encre"
      aria-label={`${SITE_NAME}, ir al inicio`}
    >
      {/* Solo el ojo crece. El nombre se queda como estaba: si crecen los dos,
          el conjunto deja de ser una marca y pasa a ser un titular. */}
      <Logo class="h-8 w-auto" viewBox={OJO} />
      <span class="font-display text-[1.0625rem] font-medium tracking-[-0.02em]">
        {SITE_NAME}
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {
          NAV.map((item) =>
            item.hijos ? (
              <li>
                {/* details/summary: el teclado y el lector de pantalla
                    funcionan de fábrica, sin recrear un menú a mano. */}
                <details class="menu group relative" data-menu>
                  <summary
                    class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-panel px-3 text-body-s text-nuit transition-colors duration-fast hover:text-encre"
                    data-activa={activa(item) ? 'true' : undefined}
                  >
                    {item.label}
                    <svg viewBox="0 0 12 8" class="menu__chevron h-2 w-3" fill="none" aria-hidden="true">
                      <path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </summary>

                  <div class="absolute left-0 top-full z-50 pt-3">
                    <ul class="min-w-56 rounded-panel border border-pierre bg-blanc p-2 shadow-lift">
                      {item.hijos.map((hijo) => (
                        <li>
                          <a
                            href={hijo.href}
                            aria-current={current === hijo.href ? 'page' : undefined}
                            class="flex min-h-11 items-center rounded-panel px-3 text-body-s text-nuit transition-colors duration-fast hover:bg-papier hover:text-encre aria-[current=page]:text-encre"
                          >
                            {hijo.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={activa(item) ? 'page' : undefined}
                  class="flex min-h-11 items-center rounded-panel px-3 text-body-s text-nuit underline-offset-4 transition-colors duration-fast hover:text-encre aria-[current=page]:text-encre aria-[current=page]:underline"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <Cta href={CTA_AGENDA.href} variant="encre" class="px-5 py-3 text-body-s">
          {CTA.header}
        </Cta>
      </div>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-panel"
        class="flex h-11 min-w-11 items-center justify-center gap-2 rounded-panel border border-pierre px-3 text-body-s text-encre transition-colors duration-fast hover:border-encre lg:hidden"
      >
        <span class="sr-only">Abrir el menú</span>
        <span aria-hidden="true">Menú</span>
        <svg viewBox="0 0 16 12" class="h-3 w-4" aria-hidden="true">
          <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="nav-panel"
    data-nav-panel
    hidden
    class="fixed inset-0 z-50 flex flex-col bg-blanc lg:hidden"
  >
    <div class="shell flex items-center justify-between py-4">
      <span class="font-display text-[1.0625rem] font-medium tracking-[-0.02em]">
        {SITE_NAME}
      </span>
      <button
        type="button"
        data-nav-toggle
        class="flex h-11 min-w-11 items-center justify-center rounded-panel border border-pierre px-4 text-body-s"
      >
        Cerrar
      </button>
    </div>

    <nav aria-label="Principal, móvil" class="shell flex-1 overflow-y-auto py-6">
      <ul class="flex flex-col gap-1">
        {
          NAV.map((item) =>
            item.hijos ? (
              <li class="border-b border-pierre py-5">
                <p class="label text-nuit">{item.label}</p>
                <ul class="mt-3 flex flex-col gap-1">
                  {item.hijos.map((hijo) => (
                    <li>
                      <a
                        href={hijo.href}
                        class="flex min-h-12 items-center font-display text-title text-encre"
                      >
                        {hijo.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-14 items-center border-b border-pierre font-display text-display-m text-encre"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <Cta href={CTA_AGENDA.href} variant="encre" class="mt-8 w-full">
        {CTA.header}
      </Cta>
    </nav>
  </div>
</header>

<style>
  /**
   * La barra ocupa todo el ancho, como antes, pero no termina en un canto
   * recto: las dos esquinas de abajo van redondeadas. Arriba del todo es
   * invisible; a partir de 80px de scroll aparece el fondo translúcido con
   * difuminado, y ahí es cuando la curva se ve.
   */
  .barra {
    border-bottom: 1px solid transparent;
    border-end-start-radius: 22px;
    border-end-end-radius: 22px;
    transition:
      background-color 300ms var(--ease-smooth),
      backdrop-filter 300ms var(--ease-smooth),
      border-color 300ms var(--ease-smooth),
      box-shadow 300ms var(--ease-smooth);
  }

  .barra[data-scrolled='true'] {
    background-color: color-mix(in srgb, var(--color-blanc) 82%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--color-pierre);
    box-shadow: var(--shadow-lift);
  }

  @media (prefers-reduced-motion: reduce) {
    .barra {
      transition: none;
    }
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary[data-activa='true'] {
    color: var(--color-encre);
  }

  .menu__chevron {
    transition: transform var(--duration-fast) var(--ease-smooth);
  }

  .menu[open] .menu__chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__chevron {
      transition: none;
    }
  }
</style>
