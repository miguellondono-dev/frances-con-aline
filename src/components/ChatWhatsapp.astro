---
import Cta from './Cta.astro';
import Logo from './Logo.astro';
import { CORREO_CONTACTO, whatsapp } from '../data/site';

/**
 * TARJETA DE CONTACTO POR WHATSAPP.
 *
 * Ocupa el sitio que tenian los formularios. Miguel los quito en septiembre
 * de 2026: todo el contacto va por WhatsApp. La tarjeta enseña como empieza
 * la conversacion, con el mensaje de la burbuja, para que nadie se sorprenda
 * al salir de la web. Sin explicaciones de como funciona: Miguel no quiere
 * frases del tipo "el mensaje ya va escrito". Tampoco se ve el numero: para
 * eso esta el boton. Debajo, el correo para quien no usa WhatsApp.
 *
 * Con `dinamica`, el mensaje lo cambia un guion de la pagina (el test de
 * nivel mete ahi el resultado): se buscan [data-chat-burbuja] y
 * [data-chat-enlace] dentro de la tarjeta.
 */
interface Props {
  /** El mensaje ya escrito. Sale en la burbuja y viaja en el enlace. */
  mensaje: string;
  /** Lo que dice el boton. */
  boton: string;
  estado?: string;
  /** Asunto del correo de la alternativa. */
  asunto?: string;
  dinamica?: boolean;
  class?: string;
}

const {
  mensaje,
  boton,
  estado = 'Aquí estoy para resolver tus dudas',
  asunto,
  dinamica = false,
  class: className = '',
} = Astro.props;

const correo = asunto
  ? `mailto:${CORREO_CONTACTO}?subject=${encodeURIComponent(asunto)}`
  : `mailto:${CORREO_CONTACTO}`;
---

<div class:list={['charla-wa', className]} data-reveal data-wa-ocultar data-chat-wa={dinamica ? '' : undefined}>
  <div class="charla-wa__cabecera">
    <span class="charla-wa__avatar"><Logo viewBox="195 258 860 691" /></span>
    <div>
      <p class="charla-wa__nombre">Aline</p>
      <p class="charla-wa__estado">{estado}</p>
    </div>
  </div>

  <div class="charla-wa__conversacion" aria-hidden="true">
    <p class="charla-wa__burbuja" data-chat-burbuja>{mensaje}</p>
  </div>

  <Cta href={whatsapp(mensaje)} class="w-full" data-chat-enlace>{boton}</Cta>

  <p class="charla-wa__otra">
    ¿Prefieres correo?
    <a href={correo}>{CORREO_CONTACTO}</a>
  </p>
</div>

<style>
  .charla-wa {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-radius: 26px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-flota);
    padding: 1.75rem 1.5rem;
    color: var(--color-encre);
  }

  @media (width >= 40rem) {
    .charla-wa {
      padding: 2.25rem 2.5rem;
    }
  }

  .charla-wa__cabecera {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-pierre);
  }

  .charla-wa__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-papier) 60%, var(--color-blanc));
    color: var(--color-encre);
  }

  .charla-wa__avatar :global(svg) {
    width: 1.9rem;
    height: auto;
  }

  .charla-wa__nombre {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-encre);
  }

  .charla-wa__estado {
    font-size: var(--text-body-s);
    color: color-mix(in srgb, var(--color-encre) 62%, transparent);
  }

  /* La conversacion: el mensaje que se va a enviar, como burbuja propia. */
  .charla-wa__conversacion {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    padding: 1.5rem 1.25rem;
    border-radius: 18px;
    background-color: color-mix(in srgb, var(--color-papier) 35%, var(--color-blanc));
  }

  .charla-wa__burbuja {
    max-width: 88%;
    padding: 0.8rem 1.05rem;
    border-radius: 18px 18px 4px 18px;
    background-color: var(--color-encre);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: pre-line;
    box-shadow: 0 8px 18px -12px color-mix(in srgb, var(--color-encre) 60%, transparent);
    transform-origin: 100% 100%;
  }

  /* La burbuja salta cuando la tarjeta entra en pantalla (data-reveal). Solo
     con JS: sin el, nadie añadiria is-revealed y la burbuja no se veria. */
  :global(.js) .charla-wa__burbuja {
    animation: burbuja-sale 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 250ms both;
    animation-play-state: paused;
  }

  :global(.js) .charla-wa:global(.is-revealed) .charla-wa__burbuja {
    animation-play-state: running;
  }

  @keyframes burbuja-sale {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .charla-wa__otra {
    text-align: center;
    font-size: var(--text-body-s);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-encre) 70%, transparent);
  }

  .charla-wa__otra a {
    color: var(--color-grenat);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .charla-wa__burbuja {
      animation: none;
    }
  }
</style>
