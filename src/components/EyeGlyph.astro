---
/**
 * El ojo reducido a glifo. Se usa como separador en la barra de credibilidad
 * y como marcador de progreso en la columna del metodo.
 * Siempre decorativo: nunca lleva significado que no este ya en el texto.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 12"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M0.5 6C4.5 1.4 8 0.5 12 0.5C16 0.5 19.5 1.4 23.5 6C19.5 10.6 16 11.5 12 11.5C8 11.5 4.5 10.6 0.5 6Z"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linejoin="round"></path>
  <circle cx="12" cy="6" r="2.25" fill="currentColor"></circle>
</svg>
