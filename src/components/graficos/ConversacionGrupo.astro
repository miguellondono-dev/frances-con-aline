---
/**
 * ILUSTRACION DE LA PORTADA DE CLASES EN GRUPO.
 *
 * Una conversacion en frances entre alumnos, con una correccion en el
 * momento ("à le" pasa a "au"). Cuenta lo que es la clase sin escribirlo:
 * hablan entre ellos y el error se corrige al vuelo. Va dentro del ojo de la
 * portada hasta que haya una foto real de una clase en grupo.
 *
 * Las burbujas entran una detras de otra cuando el ojo ya se ha abierto, y
 * al final queda alguien escribiendo: los tres puntos laten sin parar.
 */
const MENSAJES = [
  { lado: 'izq', tono: 'bleu', html: 'Tu fais quoi ce week-end ?' },
  { lado: 'der', tono: 'grenat', html: 'Je vais <del>à le</del> <ins>au</ins> marché.' },
  { lado: 'izq', tono: 'azur', html: 'On y va ensemble ?' },
  { lado: 'der', tono: 'grenat', html: 'D’accord, à samedi !' },
];
---

<div class="charla" aria-hidden="true">
  <p class="charla__etiqueta">En grupo · de 2 a 5 personas</p>
  <ul class="charla__lista">
    {
      MENSAJES.map((m, i) => (
        <li class="burbuja" data-lado={m.lado} style={`--i: ${i}`}>
          <span class="burbuja__punto" data-tono={m.tono} />
          <span class="burbuja__texto" set:html={m.html} />
        </li>
      ))
    }
    <li class="burbuja burbuja--escribiendo" data-lado="izq" style={`--i: ${MENSAJES.length}`}>
      <span class="burbuja__punto" data-tono="azur" />
      <span class="burbuja__texto"><i></i><i></i><i></i></span>
    </li>
  </ul>
</div>

<style>
  .charla {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    height: 100%;
    padding: 0 12%;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-papier) 80%, var(--color-blanc)),
      color-mix(in srgb, var(--color-ciel) 55%, var(--color-blanc))
    );
  }

  .charla__etiqueta {
    align-self: center;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-encre) 60%, transparent);
  }

  .charla__lista {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .burbuja {
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
    animation: burbuja-entra 520ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(1.1s + var(--i) * 0.5s);
  }

  .burbuja[data-lado='der'] {
    flex-direction: row-reverse;
  }

  .burbuja__punto {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    border: 2px solid var(--color-blanc);
  }

  .burbuja__punto[data-tono='bleu'] {
    background-color: var(--color-bleu);
  }

  .burbuja__punto[data-tono='azur'] {
    background-color: var(--color-azur);
  }

  .burbuja__punto[data-tono='grenat'] {
    background-color: var(--color-corail);
  }

  .burbuja__texto {
    padding: 0.5rem 0.8rem;
    border-radius: 16px 16px 16px 4px;
    background-color: var(--color-blanc);
    box-shadow: 0 6px 16px -10px color-mix(in srgb, var(--color-encre) 45%, transparent);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-encre);
  }

  .burbuja[data-lado='der'] .burbuja__texto {
    border-radius: 16px 16px 4px 16px;
    background-color: var(--color-encre);
    color: var(--color-blanc);
  }

  /* La correccion: lo que sobraba, tachado; lo bueno, en rojo. */
  .burbuja__texto :global(del) {
    color: color-mix(in srgb, var(--color-blanc) 55%, transparent);
    text-decoration-thickness: 2px;
  }

  .burbuja__texto :global(ins) {
    text-decoration: none;
    font-weight: 700;
    color: var(--color-chair);
  }

  /* Alguien escribe: tres puntos que laten. */
  .burbuja--escribiendo .burbuja__texto {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.7rem 0.85rem;
  }

  .burbuja--escribiendo i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-encre) 45%, transparent);
    animation: punto-late 1.2s ease-in-out infinite;
  }

  .burbuja--escribiendo i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .burbuja--escribiendo i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes burbuja-entra {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes punto-late {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.5;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burbuja,
    .burbuja--escribiendo i {
      animation: none;
    }
  }
</style>
