---
import Cta from './Cta.astro';
import { OPINIONES, opinionesEnOrden, type Opinion } from '../data/opiniones';

/**
 * LO QUE DICEN MIS ALUMNOS.
 *
 * Opiniones reales (data/opiniones.ts). Arriba, unas comillas enormes que
 * respiran detras del arranque del titular, y el boton. Debajo, las
 * opiniones en una cinta de lado a lado de la pantalla que corre hacia la
 * izquierda sin fin y se para al pasar el raton, para poder leerlas. Las
 * tarjetas aparecen y se van por los bordes de la pantalla, tambien en
 * escritorio: a media pantalla, el fundido de la cinta quedaba feo. Flotan un
 * poco, cada una a su ritmo.
 *
 * Lo que pidio Miguel el 2026-10-19: azul para que contraste, mucho
 * movimiento, tarjetas blancas y pequenas, la frase clave en rojo y en
 * cursiva, nada de etiqueta ni de parrafo de relleno, y las opiniones cortas
 * una encima de otra (la de Miguel debajo de la de Juan Felipe).
 *
 * `fondo`: oscuro (entra con el parpadeo, como las demas secciones de tinta
 * del sitio), calido o claro, segun lo que tenga alrededor en cada pagina.
 * Va siempre justo antes de las preguntas frecuentes.
 */
interface Props {
  /** Ids de las opiniones que van primero en esta pagina. */
  primero?: string[];
  fondo?: 'oscuro' | 'calido' | 'claro';
  boton: { texto: string; href: string };
}

const { primero = [], fondo = 'oscuro', boton } = Astro.props;
const opiniones = opinionesEnOrden(primero);
const oscuro = fondo === 'oscuro';

/**
 * Los huecos de la cinta. Las opiniones cortas van de dos en dos, una encima
 * de otra, en el orden de data/opiniones.ts; las demas, solas.
 */
const CORTA = 130;
const esCorta = (o: Opinion) => o.texto.join(' ').length < CORTA;
const huecos: Opinion[][] = [];
let pareja: Opinion[] | null = null;
for (const o of opiniones) {
  if (!esCorta(o)) {
    huecos.push([o]);
  } else if (pareja) {
    pareja.push(o);
    pareja.sort((a, b) => OPINIONES.indexOf(a) - OPINIONES.indexOf(b));
    pareja = null;
  } else {
    pareja = [o];
    huecos.push(pareja);
  }
}

/** El texto partido en antes, frase clave y despues. */
const partir = (parrafo: string, clave: string) => {
  const i = parrafo.indexOf(clave);
  return i < 0 ? null : { antes: parrafo.slice(0, i), clave, despues: parrafo.slice(i + clave.length) };
};

/** Iniciales para el circulo: "Blanca María" -> "BM". */
const iniciales = (nombre: string) =>
  nombre
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section
  class:list={['opiniones', `opiniones--${fondo}`, { 'fondo-calido': fondo === 'calido' }]}
  data-blink={oscuro ? 'closed' : undefined}
  aria-labelledby="opiniones-titulo"
  style={`--duracion: ${huecos.length * 9}s`}
>
  <div class="opiniones__brillo" aria-hidden="true"></div>

  <div class="shell relative z-10 py-section">
    <div class="opiniones__reparto">
      <div class="opiniones__cabecera">
        <span class="opiniones__comillas" aria-hidden="true">“</span>
        <h2 id="opiniones-titulo" class="titulo-seccion opiniones__titulo" data-palabras data-repite>
          Lo que dicen mis alumnos
        </h2>
      </div>

      <div class="opiniones__pista" data-reveal>
        <div class="opiniones__riel">
          {
            [false, true].map((copia) => (
              <ul class="opiniones__tira" aria-hidden={copia ? 'true' : undefined}>
                {huecos.map((hueco, h) => (
                  <li class="opiniones__hueco" style={`--h: ${h}`}>
                    {hueco.map((o) => (
                      <figure class:list={['opinion', `opinion--tono-${opiniones.indexOf(o) % 4}`]}>
                        <span class="opinion__comilla" aria-hidden="true">
                          “
                        </span>
                        <blockquote class="opinion__texto">
                          {o.texto.map((parrafo) => {
                            const p = partir(parrafo, o.clave);
                            // En una sola linea: con saltos, Astro mete un
                            // espacio entre la frase y el punto que la sigue.
                            // prettier-ignore
                            return p ? (
                              <p>{p.antes}<em class="opinion__clave">{p.clave}</em>{p.despues}</p>
                            ) : (
                              <p>{parrafo}</p>
                            );
                          })}
                        </blockquote>
                        <figcaption class="opinion__autor">
                          <span class="opinion__avatar" aria-hidden="true">
                            {iniciales(o.nombre)}
                          </span>
                          <span>
                            <span class="opinion__nombre">{o.nombre}</span>
                            {o.nota && <span class="opinion__nota">{o.nota}</span>}
                          </span>
                        </figcaption>
                      </figure>
                    ))}
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>

      <div class="opiniones__accion" data-reveal>
        <Cta href={boton.href}>{boton.texto}</Cta>
      </div>
    </div>
  </div>

  {
    oscuro && (
      <>
        <span class="blink-lid blink-lid--top" aria-hidden="true" />
        <span class="blink-lid blink-lid--bottom" aria-hidden="true" />
      </>
    )
  }
</section>

<script>
  /* La cinta, el brillo y las tarjetas solo se mueven mientras la seccion
     esta a la vista: fuera de pantalla no gastan nada. */
  const secciones = document.querySelectorAll<HTMLElement>('.opiniones');
  const io = new IntersectionObserver(
    (entradas) =>
      entradas.forEach((e) => (e.target as HTMLElement).toggleAttribute('data-vivo', e.isIntersecting)),
    { rootMargin: '160px 0px' },
  );
  secciones.forEach((s) => io.observe(s));
</script>

<style>
  .opiniones {
    position: relative;
    overflow: clip;
  }

  /* El azul que ya tenia: la noche entra arriba a la izquierda y se cierra
     en tinta. */
  .opiniones--oscuro {
    background-image: linear-gradient(160deg, var(--color-nuit), var(--color-encre) 70%);
    color: var(--color-blanc);
  }

  .opiniones--claro {
    background-color: var(--color-blanc);
  }

  /* Un brillo azul que se pasea despacio por el fondo. Solo en oscuro, y
     movido con transform, no con background-position. */
  .opiniones__brillo {
    display: none;
  }

  .opiniones--oscuro .opiniones__brillo {
    display: block;
    position: absolute;
    top: -30%;
    left: -15%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-bleu) 42%, transparent),
      transparent 62%
    );
    pointer-events: none;
    animation: opiniones-brillo 16s ease-in-out infinite alternate;
  }

  @keyframes opiniones-brillo {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(55%, 30%) scale(1.15);
    }
  }

  /* ------------------------------------------------------------------
     Reparto. Movil: titular, cinta y boton, uno debajo de otro.
     Escritorio: titular a la izquierda y boton a la derecha en la misma
     fila; debajo, la cinta de lado a lado.
     ------------------------------------------------------------------ */
  .opiniones__reparto {
    display: grid;
    grid-template-areas: 'titulo' 'pista' 'accion';
    row-gap: 2rem;
  }

  .opiniones__cabecera {
    grid-area: titulo;
    position: relative;
  }

  .opiniones__pista {
    grid-area: pista;
  }

  .opiniones__accion {
    grid-area: accion;
  }

  @media (width >= 64rem) {
    .opiniones__reparto {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'titulo accion'
        'pista pista';
      align-items: end;
      column-gap: 3rem;
      row-gap: 2.5rem;
    }
  }

  /* Comillas enormes detras del arranque del titular, que respiran despacio.
     Asi las queria Miguel: arriba a la izquierda, asomando sobre "Lo". */
  .opiniones__comillas {
    position: absolute;
    top: -3rem;
    left: -0.9rem;
    font-family: var(--font-display);
    font-size: 12rem;
    font-weight: 800;
    line-height: 1;
    color: color-mix(in srgb, var(--color-grenat) 34%, transparent);
    pointer-events: none;
    animation: opiniones-respira 6s ease-in-out infinite alternate;
  }

  .opiniones--claro .opiniones__comillas,
  .opiniones--calido .opiniones__comillas {
    color: color-mix(in srgb, var(--color-grenat) 14%, transparent);
  }

  @keyframes opiniones-respira {
    from {
      transform: translateY(0) rotate(0deg);
    }
    to {
      transform: translateY(-10px) rotate(-5deg);
    }
  }

  /* En una linea siempre que quepa: partido en dos dejaba un hueco grande
     al lado. Solo en el movil, donde no cabe, se parte. */
  .opiniones__titulo {
    position: relative;
    color: var(--color-blanc);
  }

  @media (width >= 40rem) {
    .opiniones__titulo {
      white-space: nowrap;
    }
  }

  .opiniones--claro .opiniones__titulo,
  .opiniones--calido .opiniones__titulo {
    color: var(--color-encre);
  }

  /* ------------------------------------------------------------------
     La cinta
     ------------------------------------------------------------------ */
  /* De borde a borde de la pantalla, con un fundido corto solo en los
     bordes: las tarjetas entran y salen por ahi, no a media pantalla. */
  .opiniones__pista {
    --borde: clamp(1rem, 5vw, 4.5rem);
    margin-inline: calc(50% - 50vw);
    padding-block: 1rem 1.5rem;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--borde),
      #000 calc(100% - var(--borde)),
      transparent
    );
  }

  .opiniones__riel {
    display: flex;
    width: max-content;
    animation: opiniones-cinta var(--duracion) linear infinite;
  }

  /* Dos copias iguales seguidas: al llegar a la mitad, la segunda esta
     justo donde empezo la primera y el salto no se ve. */
  @keyframes opiniones-cinta {
    to {
      transform: translateX(-50%);
    }
  }

  .opiniones__tira {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0 1rem 0 0;
    list-style: none;
  }

  /* Cada hueco flota un poco, con su propio desfase. */
  .opiniones__hueco {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    animation: opiniones-flota 5.5s ease-in-out infinite alternate;
    animation-delay: calc(var(--h) * -1.4s);
  }

  @keyframes opiniones-flota {
    from {
      transform: translateY(-7px);
    }
    to {
      transform: translateY(7px);
    }
  }

  /* Quieto fuera de pantalla, y parado bajo el raton para leer. */
  :global(.js) .opiniones:not([data-vivo]) :is(.opiniones__riel, .opiniones__hueco, .opiniones__brillo),
  .opiniones__pista:hover .opiniones__riel,
  .opiniones__pista:hover .opiniones__hueco {
    animation-play-state: paused;
  }

  /* ------------------------------------------------------------------
     La tarjeta: blanca y pequena
     ------------------------------------------------------------------ */
  .opinion {
    position: relative;
    width: 16.5rem;
    margin: 0;
    padding: 1.1rem 1.2rem 1rem;
    border-radius: 18px;
    background-color: var(--color-blanc);
    color: var(--color-encre);
    box-shadow: 0 16px 34px -22px color-mix(in srgb, var(--color-encre) 80%, transparent);
    transition: transform 520ms var(--ease-fluid);
  }

  @media (width >= 48rem) {
    .opinion {
      width: 18.5rem;
    }
  }

  .opiniones--claro .opinion,
  .opiniones--calido .opinion {
    box-shadow:
      var(--shadow-flota),
      inset 0 0 0 1px color-mix(in srgb, var(--color-pierre) 85%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .opinion:hover {
      transform: translateY(-6px) rotate(-1deg) scale(1.02);
    }
  }

  .opinion__comilla {
    display: block;
    height: 1rem;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-grenat);
  }

  .opinion__texto {
    display: grid;
    gap: 0.45rem;
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-encre) 76%, transparent);
  }

  /* La frase clave, como la palabra roja de los titulares: cursiva de verdad
     y el rojo del sitio. */
  .opinion__clave {
    font-style: italic;
    font-weight: 600;
    color: var(--color-lie);
  }

  .opinion__autor {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--color-encre) 8%, transparent);
  }

  /* Cada avatar con un color de la marca, por turnos. */
  .opinion__avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .opinion--tono-1 .opinion__avatar {
    background-color: var(--color-bleu);
  }

  .opinion--tono-2 .opinion__avatar {
    background-color: var(--color-chair);
    color: var(--color-encre);
  }

  .opinion--tono-3 .opinion__avatar {
    background-color: var(--color-nuit);
  }

  .opinion__nombre {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-encre);
  }

  .opinion__nota {
    display: block;
    font-size: 0.78rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-encre) 62%, transparent);
  }

  /* ------------------------------------------------------------------
     El parpadeo de las secciones de tinta: los parpados blancos se abren
     al entrar y se cierran al salir del todo. Lo mueve motion.ts.
     ------------------------------------------------------------------ */
  .blink-lid {
    position: absolute;
    left: -2%;
    width: 104%;
    height: 56%;
    background-color: var(--color-blanc);
    pointer-events: none;
    z-index: 20;
    will-change: transform;
    transition: transform 900ms var(--ease-smooth);
  }

  .blink-lid--top {
    top: 0;
    border-radius: 0 0 50% 50% / 0 0 22% 22%;
    transform: translateY(-102%);
  }

  .blink-lid--bottom {
    bottom: 0;
    border-radius: 50% 50% 0 0 / 22% 22% 0 0;
    transform: translateY(102%);
    transition-delay: 80ms;
  }

  :global(.js) [data-blink='closed'] .blink-lid--top,
  :global(.js) [data-blink='closed'] .blink-lid--bottom {
    transform: translateY(0);
  }

  /* Sin movimiento: la cinta se queda quieta, sin la copia, y se recorre
     deslizando. */
  @media (prefers-reduced-motion: reduce) {
    .opiniones__comillas,
    .opiniones__brillo,
    .opiniones__riel,
    .opiniones__hueco {
      animation: none !important;
    }

    .opiniones__pista {
      overflow-x: auto;
    }

    .opiniones__tira[aria-hidden='true'] {
      display: none;
    }

    .opinion {
      transition: none;
    }

    .blink-lid {
      transition: none !important;
    }

    :global(.js) [data-blink='closed'] .blink-lid--top {
      transform: translateY(-102%) !important;
    }

    :global(.js) [data-blink='closed'] .blink-lid--bottom {
      transform: translateY(102%) !important;
    }
  }
</style>
