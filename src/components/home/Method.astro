---
/**
 * LINEA DE TIEMPO DE PASOS.
 *
 * La usan el inicio ("Cómo es una clase conmigo", cuatro pasos) y las paginas
 * de clases ("Cómo empezamos", tres). Sin props se pinta la del inicio tal
 * cual estaba.
 *
 * El carril se llena en rojo mientras se baja por la seccion y cada paso se
 * enciende cuando el relleno llega a su punto: el numero pasa a rojo y la
 * tarjeta sube a su sitio. No hay pista alta ni bloque pegado: la seccion mide
 * lo que mide y la rueda va como siempre.
 *
 * Historia, para no repetirla:
 *  - Primero fue un bloque pegado tres pantallas que enseñaba un paso cada vez
 *    con el siguiente borroso: 2.880px para cuatro frases y un paso ilegible.
 *  - Despues, los cuatro en fila con una entrada de 24px: Miguel la vio plana,
 *    sin animacion y con mucho blanco.
 *
 * Solo se animan transform y opacity. El relleno lo mueve setupMetodo en
 * motion.ts. Sin JavaScript, o con movimiento reducido, se ve el estado final:
 * carril lleno y todos los pasos encendidos.
 */
interface Props {
  titulo?: string;
  pasos?: { titulo: string; texto: string }[];
  /** Fondo de la seccion. Depende de las vecinas: no se repite el tono. */
  fondo?: string;
  /**
   * Quien mueve el carril. Por defecto Motion (setupMetodo en motion.ts); en
   * las paginas de clases con GSAP lo mueve clases-gsap.ts.
   */
  motor?: 'motion' | 'gsap';
}

const PASOS_INICIO = [
  {
    titulo: 'Empezamos escuchándote',
    texto:
      'La primera media hora la dedico a oírte hablar sin corregirte, para saber de dónde partimos.',
  },
  {
    titulo: 'Decidimos juntos hacia dónde vamos',
    texto:
      'Elegimos qué necesitas primero y qué puede esperar, y lo cambiamos cuando cambia tu vida.',
  },
  {
    titulo: 'Traemos la vida real a la clase',
    texto:
      'Trabajamos con lo que te vas a encontrar de verdad: un menú, una canción, un formulario.',
  },
  {
    titulo: 'No te dejo solo entre clase y clase',
    texto:
      'Te dejo algo corto para hacer y lo miramos juntos al empezar la siguiente.',
  },
];

const {
  titulo = 'Cómo es una clase conmigo',
  pasos = PASOS_INICIO,
  fondo = 'bg-blanc',
  motor = 'motion',
} = Astro.props;
---

{/* En el inicio va en blanco a proposito: la seccion de arriba y la de abajo
    ya llevan tono, y repetirlo ahi satura la pagina. Miguel lo pidio asi. */}
<section class={`metodo ${fondo}`} aria-labelledby="metodo-titulo">
  <div class="shell metodo__shell">
    {/* El mismo titular que "Formas de aprender francés": centrado, en negrita
        y con la misma entrada palabra por palabra. */}
    <div class="flex flex-col items-center text-center">
      <h2 id="metodo-titulo" class="metodo__titulo" data-palabras data-repite>
        {titulo}
      </h2>
    </div>

    {/* --pasos va en el contenedor y no en la lista: el carril es hermano de
        la lista y tambien lo necesita para su posicion sin guion. */}
    <div
      class="recorrido"
      data-metodo
      data-motor={motor === 'gsap' ? 'gsap' : undefined}
      style={`--pasos: ${pasos.length}`}
    >
      <span class="carril" aria-hidden="true">
        <span class="carril__relleno" data-metodo-relleno></span>
      </span>

      <ol class="recorrido__pasos">
        {
          pasos.map((paso, i) => (
            <li class="paso" data-metodo-paso>
              <span class="paso__punto" aria-hidden="true">
                <span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
              </span>

              <article class="paso__tarjeta tarjeta-sitio">
                <h3 class="paso__titulo">{paso.titulo}</h3>
                <p class="paso__texto">{paso.texto}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* El relleno pequeño del sitio: con el grande sobraba blanco arriba y abajo. */
  .metodo__shell {
    padding-block: var(--spacing-section-sm);
  }

  .metodo__titulo {
    font-family: var(--font-display);
    font-size: var(--text-display-l);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--color-encre);
    /* En una sola linea: Miguel lo pidio asi. Sin tope de ancho; en un movil
       estrecho no cabe y parte, y ahi balance reparte las dos lineas. */
    text-wrap: balance;
  }

  /* --- El recorrido --- */

  /**
   * En movil y tableta, una columna centrada con el carril en vertical a la
   * izquierda. En escritorio, la fila de pasos con el carril en horizontal
   * por encima de las tarjetas.
   */
  .recorrido {
    --punto: 3.25rem;
    position: relative;
    max-width: 42rem;
    margin: 2.75rem auto 0;
  }

  @media (width >= 64rem) {
    .recorrido {
      max-width: none;
      margin-top: 3.25rem;
    }
  }

  /**
   * El carril. Su inicio y su largo los mide el guion, de centro a centro de
   * los puntos; los valores de aqui son solo para cuando no hay guion.
   */
  .carril {
    position: absolute;
    top: var(--carril-inicio, calc(var(--punto) / 2));
    left: calc(var(--punto) / 2 - 1px);
    width: 2px;
    height: var(--carril-largo, calc(100% - var(--punto)));
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-encre) 12%, transparent);
    pointer-events: none;
  }

  /* El relleno. Sin guion esta lleno; con guion, el scroll decide cuanto. */
  .carril__relleno {
    position: absolute;
    inset: 0;
    background-color: var(--color-grenat);
    transform-origin: top center;
    will-change: transform;
  }

  @media (width >= 64rem) {
    /* Sin guion: del centro de la primera columna al de la ultima. */
    .carril {
      top: calc(var(--punto) / 2 - 1px);
      left: var(--carril-inicio, calc(50% / var(--pasos, 4)));
      width: var(--carril-largo, calc(100% - 100% / var(--pasos, 4)));
      height: 2px;
    }

    .carril__relleno {
      transform-origin: left center;
    }
  }

  .recorrido__pasos {
    display: grid;
    gap: 1.25rem;
  }

  @media (width >= 64rem) {
    /* Sin hueco entre columnas: asi el centro de cada punto cae justo en el
       centro de su columna y el carril los une. */
    .recorrido__pasos {
      grid-template-columns: repeat(var(--pasos, 4), minmax(0, 1fr));
      gap: 0;
    }
  }

  .paso {
    display: grid;
    grid-template-columns: var(--punto) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  @media (width >= 64rem) {
    .paso {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-inline: 0.625rem;
    }
  }

  /* --- El punto --- */

  /**
   * Un disco blanco con el numero. Al encenderse, un disco rojo crece desde
   * dentro y el numero pasa a blanco. El rojo es un pseudoelemento que solo
   * cambia de escala y de opacidad.
   */
  .paso__punto {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--punto);
    height: var(--punto);
    border-radius: 50%;
    background-color: var(--color-blanc);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-encre) 12%, transparent);
  }

  .paso__punto::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--color-grenat);
    transition:
      transform 520ms var(--ease-fluid),
      opacity 360ms ease-out;
  }

  .paso__numero {
    position: relative;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-blanc);
    transition: color 360ms ease;
  }

  /* --- La tarjeta --- */

  .paso__tarjeta {
    width: 100%;
    padding: 1.35rem 1.4rem 1.5rem;
  }

  @media (width >= 64rem) {
    .paso__tarjeta {
      flex: 1;
      margin-top: 1.25rem;
      text-align: center;
    }
  }

  /* La sombra alta, en capa propia: se enciende con opacidad, no animando la
     sombra. */
  .paso__tarjeta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: var(--shadow-alta);
    transition: opacity 520ms var(--ease-fluid);
  }

  .paso__titulo {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-encre);
    text-wrap: balance;
  }

  /* En la fila, el titulo reserva dos lineas para que los textos arranquen a
     la misma altura en todas las tarjetas. */
  @media (width >= 64rem) {
    .paso__titulo {
      min-height: 2.3em;
    }
  }

  .paso__texto {
    margin-top: 0.6rem;
    font-size: var(--text-body);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-encre) 72%, transparent);
    text-wrap: pretty;
  }

  /* --- Apagado hasta que llega el carril --- */

  /**
   * Solo cuando el guion esta vivo. Apagado no es invisible: la tarjeta se
   * queda al 60 por ciento, se lee, y baja 14px para poder subir.
   */
  .recorrido[data-vivo='true'] .paso__tarjeta {
    transition:
      transform 700ms var(--ease-fluid),
      opacity 500ms ease-out;
  }

  .recorrido[data-vivo='true'] .paso:not([data-activo='true']) .paso__tarjeta {
    transform: translateY(14px);
    opacity: 0.6;
  }

  .recorrido[data-vivo='true'] .paso:not([data-activo='true']) .paso__tarjeta::after {
    opacity: 0;
  }

  .recorrido[data-vivo='true'] .paso:not([data-activo='true']) .paso__punto::before {
    transform: scale(0.4);
    opacity: 0;
  }

  .recorrido[data-vivo='true'] .paso:not([data-activo='true']) .paso__numero {
    color: color-mix(in srgb, var(--color-bleu) 60%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .paso__punto::before,
    .paso__numero,
    .paso__tarjeta,
    .paso__tarjeta::after,
    .recorrido[data-vivo='true'] .paso__tarjeta {
      transition: none;
    }
  }
</style>
