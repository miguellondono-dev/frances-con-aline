---
import ChatWhatsapp from './ChatWhatsapp.astro';
import { Picture } from 'astro:assets';
import Cta from './Cta.astro';
import EscenaTaller from './graficos/EscenaTaller.astro';
import type { TipoEscenaTaller } from './graficos/escenas';
import { whatsapp } from '../data/site';
import {
  estadoDe,
  hechos,
  mensajeAviso,
  mensajeInscripcion,
  type Taller,
} from '../data/talleres';

/**
 * La pagina de un taller. Teatro y acuarela son el mismo producto con otra
 * materia, asi que comparten plantilla: si el orden de la informacion cambia,
 * cambia en los dos a la vez y no se pueden desalinear.
 *
 * Tres estados:
 *  - Con tanda y plazas abiertas: "Inscribirme" y hasta cuando se puede.
 *  - Con tanda y plazas cerradas: "Avísame del próximo". Pasa solo al llegar
 *    la fecha de cierre (scripts/talleres-estado.ts).
 *  - Sin tanda: "Próximamente" y "Avísame".
 */

interface Props {
  taller: Taller;
  /** La foto del encabezado. La mas fuerte que haya. */
  portada: ImageMetadata;
  portadaAlt: string;
  /** Un reel vertical para la cabecera. Si lo hay, va en lugar de la foto. */
  reel?: { src: string; poster: ImageMetadata; alt: string };
}

const { taller: t, portada, portadaAlt, reel } = Astro.props;

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
  { name: t.nombre, path: `/talleres/${t.slug}` },
];

const idForma = `plaza-${t.slug}`;

const tanda = t.tanda;

/**
 * La escena de cada cosa que se practica, en el orden de talleres.ts. Si un
 * taller nuevo no tiene las suyas, sale la mezcla de color por defecto.
 */
const ESCENAS: Record<string, TipoEscenaTaller[]> = {
  acuarela: ['mezcla', 'vocabulario', 'boceto', 'lamina'],
  teatro: ['voz', 'trabalenguas', 'expresiones', 'escena', 'mascara'],
};
const escenaDe = (i: number): TipoEscenaTaller => ESCENAS[t.slug]?.[i] ?? 'mezcla';

/**
 * El mosaico de "Lo que vas a conseguir": filas de dos, ancha y estrecha y
 * luego estrecha y ancha. Si queda una sola al final, ocupa la fila entera.
 */
const total = t.practica.length;
const forma = (i: number) =>
  total % 2 === 1 && i === total - 1 ? 'entera' : i % 4 === 0 || i % 4 === 3 ? 'ancha' : 'estrecha';
/** Si al compilar ya habia pasado el cierre, sale cerrado de entrada. */
const cerradoYa = estadoDe(t) === 'cerrado' ? '' : undefined;

---

<section class="cabecera">
  <div class="shell pt-14 pb-section-sm">

    <div class="cabecera__reparto">
      <div class="cabecera__texto">
        <h1 class="cabecera__titulo" data-palabras data-repite>
          {
            t.acento && t.titular.includes(t.acento) ? (
              <>
                {t.titular.slice(0, t.titular.indexOf(t.acento))}
                <em class="destacado">{t.acento}</em>
                {t.titular.slice(t.titular.indexOf(t.acento) + t.acento.length)}
              </>
            ) : (
              t.titular
            )
          }
        </h1>

        <p class="measure mt-7 text-body text-nuit" data-reveal>
          {t.parrafos[0]}
        </p>

        {/*
          Los mismos tres hechos que en la rejilla y en el mismo orden. Quien
          llega desde la tarjeta encuentra los datos donde ya los vio.
        */}
        <dl class="hechos" data-reveal>
          {
            hechos(t).map((h) => (
              <div class="hechos__par">
                <dt class="hechos__clave">{h.clave}</dt>
                <dd class="hechos__valor">{h.valor}</dd>
              </div>
            ))
          }
        </dl>

        <div
          class="cabecera__acciones"
          data-reveal
          data-taller-cierre={tanda?.iso.cierre}
          data-taller-cerrado={cerradoYa}
        >
          {
            tanda ? (
              <>
                <div class="si-abierto">
                  <Cta href={whatsapp(mensajeInscripcion(t))} variant="grenat">
                    Inscribirme
                  </Cta>
                  <p class="aviso-estado">
                    <span class="aviso-estado__punto" aria-hidden="true" />
                    Plazas abiertas hasta el {tanda.cierre}
                  </p>
                </div>
                <div class="si-cerrado">
                  <Cta href={whatsapp(mensajeAviso(t))}>Avísame del próximo</Cta>
                  <p class="aviso-estado aviso-estado--cerrado">Plazas cerradas para esta fecha</p>
                </div>
              </>
            ) : (
              <>
                <Cta href={whatsapp(mensajeAviso(t))} variant="grenat">
                  Avísame
                </Cta>
                <p class="aviso-estado aviso-estado--proximo">
                  <span class="aviso-estado__punto" aria-hidden="true" />
                  Próximamente
                </p>
              </>
            )
          }
        </div>
      </div>

      {
        reel ? (
          /* El reel: vertical, sin sonido y en bucle mientras se ve, sobre una
             carta roja girada que le da fondo. Con pausa y sonido a mano. */
          <div class="reel" data-reveal="fade" data-reel>
            <span class="reel__fondo" aria-hidden="true" />
            <div class="reel__marco">
              <video
                class="reel__video"
                src={reel.src}
                poster={reel.poster.src}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={reel.alt}
                data-reel-video
              />
              <div class="reel__controles">
                <button class="reel__boton" type="button" data-reel-pausa aria-label="Pausar el vídeo">
                  <svg class="reel__icono reel__icono--pausa" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5.5h2.6v13H8zM13.4 5.5H16v13h-2.6z" fill="currentColor" />
                  </svg>
                  <svg class="reel__icono reel__icono--play" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8.5 5.5v13L19 12z" fill="currentColor" />
                  </svg>
                </button>
                <button class="reel__boton" type="button" data-reel-sonido aria-label="Activar el sonido">
                  <svg class="reel__icono reel__icono--mudo" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
                    <path d="M16 9.5l5 5M21 9.5l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  <svg class="reel__icono reel__icono--sonido" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
                    <path d="M15.5 9a4 4 0 010 6M18 6.5a7.5 7.5 0 010 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        ) : (
          <div class="cabecera__foto" data-reveal="fade">
            <Picture
              src={portada}
              alt={portadaAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900]}
              sizes="(min-width: 64rem) 28rem, 92vw"
              class="cabecera__img"
              loading="eager"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<!-- Que se practica. Cosas nombrables, no promesas. -->
<!-- Que hacemos. El mismo mosaico que "Lo que vas a conseguir" en las paginas
     de clases: cada cosa que se practica con su mini escena animada, su
     numero y su nombre. Las tarjetas sueltas con un numero que habia antes
     parecian de plantilla. -->
<section class="practica" aria-labelledby="practica">
  <div class="shell py-section">
    <div class="practica__cabecera">
      <h2 id="practica" class="titulo-seccion text-encre" data-palabras data-repite>
        Qué <em class="destacado">hacemos</em> en el taller
      </h2>
      <p class="practica__frase" data-reveal>
        {t.parrafos[1]}
      </p>
    </div>

    <ol class="mosaico">
      {
        t.practica.map((cosa, i) => (
          <li class:list={['logro', `logro--${forma(i)}`]} data-logro-taller data-reveal style={`--i: ${i}`}>
            <article class="logro__tarjeta">
              <div class:list={['logro__escena', i % 2 === 0 ? 'logro__escena--calida' : 'logro__escena--fria']}>
                <EscenaTaller tipo={escenaDe(i)} />
              </div>
              <div class="logro__cuerpo">
                <span class="logro__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="logro__titulo">{cosa}</h3>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Reserva. No se cobra aqui: se cierra por WhatsApp. -->
<section
  class="reserva"
  id={idForma}
  aria-labelledby={`${idForma}-titulo`}
  data-taller-cierre={tanda?.iso.cierre}
  data-taller-cerrado={cerradoYa}
>
  <div class="shell py-section">
    {
      tanda && (
        <div class="si-abierto">
          <div class="reserva__caja">
            <div>
              <h2 id={`${idForma}-titulo`} class="text-display-m text-encre" data-reveal>
                Inscríbete
              </h2>
              <p class="measure mt-5 text-body text-nuit" data-reveal>
                Escríbeme por WhatsApp y te confirmo la plaza, con la dirección
                exacta y la forma de pago.
              </p>

              <p class="reserva__resumen" data-reveal>
                <span class="reserva__precio numerals">{tanda.precio} €</span>
                <span class="reserva__detalle">
                  {t.sesiones > 1 ? `las ${t.sesiones} sesiones, no cada una` : 'la sesión'}
                </span>
              </p>
              <p class="reserva__fecha" data-reveal>
                {tanda.cuando} · {tanda.hora}
              </p>
            </div>

            <ChatWhatsapp
              mensaje={mensajeInscripcion(t)}
              boton="Inscribirme"
              asunto={`Quiero una plaza en el taller de ${t.slug}`}
            />
          </div>
        </div>
      )
    }

    <div class={tanda ? 'si-cerrado' : undefined}>
      <div class="reserva__caja">
        <div>
          <h2 id={tanda ? undefined : `${idForma}-titulo`} class="text-display-m text-encre" data-reveal>
            {tanda ? '¿Te aviso del próximo?' : '¿Te aviso de las fechas?'}
          </h2>
          <p class="measure mt-5 text-body text-nuit" data-reveal>
            {
              tanda
                ? 'Las plazas de esta fecha ya están cerradas. Escríbeme y te cuento cuándo es el próximo.'
                : 'Estoy preparando las próximas fechas. Escríbeme y te las cuento en cuanto estén.'
            }
          </p>
        </div>

        <ChatWhatsapp
          mensaje={mensajeAviso(t)}
          boton="Avísame"
          asunto={`Avísame del próximo taller de ${t.slug}`}
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Fondos: el mismo lenguaje del inicio --- */

  .cabecera {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 44%, var(--color-blanc)) 40%,
      color-mix(in srgb, var(--color-papier) 26%, var(--color-blanc)) 78%,
      var(--color-blanc) 100%
    );
  }

  .practica {
    background-color: var(--color-blanc);
  }

  .reserva {
    background-color: var(--color-blanc);
  }

  /* --- Cabecera --- */

  .cabecera__reparto {
    display: grid;
    gap: 3rem;
  }

  @media (width >= 64rem) {
    .cabecera__reparto {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: 4rem;
    }
  }

  /* El mismo titular que el resto de paginas interiores (titulo-portada en
     global.css). */
  .cabecera__titulo {
    margin-top: 2rem;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.5rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--color-encre);
  }

  .cabecera__foto {
    overflow: hidden;
    border-radius: 26px;
    box-shadow: var(--shadow-alta);
  }

  .cabecera__img {
    display: block;
    height: 100%;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* --- El reel --- */

  .reel {
    position: relative;
    justify-self: center;
    width: min(100%, 21rem);
    margin: 1rem 0;
  }

  /* La carta de detras: roja, girada, asomando por un lado. */
  .reel__fondo {
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background-image: linear-gradient(160deg, var(--color-corail), var(--color-grenat) 70%);
    transform: rotate(6deg) translate(4%, 2%);
    animation: reel-respira 7s ease-in-out infinite alternate;
  }

  @keyframes reel-respira {
    from {
      transform: rotate(6deg) translate(4%, 2%);
    }
    to {
      transform: rotate(4deg) translate(5%, 0);
    }
  }

  .reel__marco {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    border-radius: 26px;
    background-color: var(--color-encre);
    box-shadow: var(--shadow-alta);
  }

  .reel__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Los dos botones, de cristal oscuro, abajo a la izquierda. */
  .reel__controles {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    gap: 0.5rem;
  }

  .reel__boton {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-encre) 55%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-blanc) 22%, transparent);
    color: var(--color-blanc);
    cursor: pointer;
    transition:
      transform 320ms var(--ease-fluid),
      background-color 320ms var(--ease-smooth);
  }

  .reel__boton:hover {
    transform: scale(1.08);
    background-color: var(--color-grenat);
  }

  .reel__boton:active {
    transform: scale(0.96);
  }

  .reel__boton:focus-visible {
    outline: 2px solid var(--color-blanc);
    outline-offset: 2px;
  }

  .reel__icono {
    width: 1.2rem;
    height: 1.2rem;
  }

  .reel__icono--play,
  .reel__icono--sonido,
  .reel[data-pausado] .reel__icono--pausa,
  .reel[data-sonido] .reel__icono--mudo {
    display: none;
  }

  .reel[data-pausado] .reel__icono--play,
  .reel[data-sonido] .reel__icono--sonido {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .reel__fondo {
      animation: none;
    }
  }

  .cabecera__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }

  /* El estado de las plazas: un punto que late cuando estan abiertas. */
  .aviso-estado {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.45rem 0.9rem 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-blanc) 75%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 10%, transparent);
    font-size: var(--text-body-s);
    font-weight: 500;
    color: var(--color-encre);
  }

  .aviso-estado--cerrado {
    color: color-mix(in srgb, var(--color-encre) 70%, transparent);
  }

  .aviso-estado__punto {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
  }

  .aviso-estado--proximo .aviso-estado__punto {
    background-color: var(--color-azur);
  }

  .aviso-estado__punto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: inherit;
    animation: aviso-late 1.8s ease-out infinite;
  }

  @keyframes aviso-late {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.8);
    }
  }

  .reserva__fecha {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-encre);
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso-estado__punto::after {
      animation: none;
    }
  }

  /* --- Los tres hechos --- */

  /* Tres o cuatro datos segun el taller: se reparten solos y, si no caben,
     bajan de linea en vez de apretarse. */
  .hechos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--color-pierre);
    padding-top: 1.5rem;
  }

  .hechos__par {
    display: grid;
    gap: 0.35rem;
  }

  .hechos__clave {
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-encre) 55%, transparent);
  }

  .hechos__valor {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-encre);
  }

  /* --- Que se hace --- */

  .practica__cabecera {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .practica__frase {
    margin-top: 1.1rem;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-nuit);
  }

  /* --- El mosaico (el mismo de "Lo que vas a conseguir") ---
     Una columna en movil, dos en tableta y, en escritorio, tres columnas
     donde cada fila junta una tarjeta ancha (dos columnas) y una estrecha,
     alternando el lado. */
  .mosaico {
    display: grid;
    gap: 1rem;
    max-width: 70rem;
    margin: 2.75rem auto 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .logro--entera {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    .mosaico {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .logro--ancha {
      grid-column: span 2;
    }
  }

  .logro:global(.is-revealed) {
    transition-delay: calc(var(--i, 0) * 110ms);
  }

  .logro__tarjeta {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    padding: 0.55rem;
    border-radius: 28px;
    background-color: var(--color-blanc);
    box-shadow:
      var(--shadow-flota),
      inset 0 0 0 1px color-mix(in srgb, var(--color-pierre) 85%, transparent);
    transition:
      transform 520ms var(--ease-fluid),
      box-shadow 520ms var(--ease-fluid);
  }

  @media (hover: hover) and (pointer: fine) {
    .logro__tarjeta:hover {
      transform: translateY(-6px);
      box-shadow:
        var(--shadow-alta),
        inset 0 0 0 1px color-mix(in srgb, var(--color-pierre) 85%, transparent);
    }
  }

  /* El hueco de la escena: un tono de la marca con una trama de puntos muy
     suave. Calido y frio se alternan. */
  .logro__escena {
    position: relative;
    height: 13rem;
    overflow: hidden;
    border-radius: 22px;
    background-size:
      16px 16px,
      auto;
  }

  .logro__escena--fria {
    background-image:
      radial-gradient(color-mix(in srgb, var(--color-encre) 9%, transparent) 1px, transparent 1.5px),
      radial-gradient(
        circle at 25% 15%,
        color-mix(in srgb, var(--color-ciel) 48%, var(--color-blanc)),
        color-mix(in srgb, var(--color-ciel) 20%, var(--color-blanc)) 75%
      );
  }

  .logro__escena--calida {
    background-image:
      radial-gradient(color-mix(in srgb, var(--color-encre) 8%, transparent) 1px, transparent 1.5px),
      radial-gradient(
        circle at 75% 15%,
        color-mix(in srgb, var(--color-papier) 95%, var(--color-blanc)),
        color-mix(in srgb, var(--color-papier) 45%, var(--color-blanc)) 75%
      );
  }

  .logro__cuerpo {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.15rem 1rem 0.95rem;
  }

  /* El numero, en rojo y con una raya corta detras. */
  .logro__num {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-grenat);
  }

  .logro__num::after {
    content: '';
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-grenat) 40%, transparent);
  }

  .logro__titulo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-encre);
  }

  @media (prefers-reduced-motion: reduce) {
    .logro__tarjeta {
      transition: none;
    }
  }

  /* --- Galeria --- */

  /* --- Reserva --- */

  .reserva__caja {
    display: grid;
    gap: 2.5rem;
    border-radius: 26px;
    background-color: color-mix(in srgb, var(--color-papier) 34%, var(--color-blanc));
    padding: 2.25rem 1.75rem;
  }

  @media (width >= 64rem) {
    .reserva__caja {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: 4rem;
      padding: 3.25rem 3rem;
    }
  }

  /* El precio sale una sola vez en toda la pagina, y sale aqui: pegado al
     boton, que es donde se decide. En la cabecera va como dato, no repetido. */
  .reserva__resumen {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 2rem 0 0;
  }

  .reserva__precio {
    font-size: var(--text-display-m);
    font-weight: 600;
    line-height: 1;
    color: var(--color-encre);
  }

  .reserva__detalle {
    font-size: var(--text-body-s);
    color: color-mix(in srgb, var(--color-encre) 66%, transparent);
  }
</style>

<script>
  import '../scripts/talleres-estado';

  /* Las escenas de "Qué hacemos" solo se mueven mientras su tarjeta se ve:
     [data-vivo] al entrar, fuera al salir, y nunca con movimiento reducido. */
  const logros = document.querySelectorAll<HTMLElement>('[data-logro-taller]');
  if (logros.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          const tarjeta = e.target as HTMLElement;
          if (e.isIntersecting) tarjeta.dataset.vivo = 'true';
          else delete tarjeta.dataset.vivo;
        }),
      { threshold: 0.3 },
    );
    logros.forEach((l) => io.observe(l));
  }

  /* El reel corre solo mientras esta a la vista, y nunca si quien entra
     prefiere menos movimiento. Si alguien lo pausa, se queda pausado. */
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const video = reel.querySelector<HTMLVideoElement>('[data-reel-video]');
    const pausa = reel.querySelector<HTMLButtonElement>('[data-reel-pausa]');
    const sonido = reel.querySelector<HTMLButtonElement>('[data-reel-sonido]');
    if (!video || !pausa || !sonido) return;

    let pausadoAMano = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const marcar = () => {
      reel.toggleAttribute('data-pausado', video.paused);
      pausa.setAttribute('aria-label', video.paused ? 'Reproducir el vídeo' : 'Pausar el vídeo');
    };
    video.addEventListener('play', marcar);
    video.addEventListener('pause', marcar);
    marcar();

    new IntersectionObserver(
      ([entrada]) => {
        if (entrada.isIntersecting && !pausadoAMano) void video.play().catch(() => marcar());
        else if (!entrada.isIntersecting) video.pause();
      },
      { threshold: 0.35 },
    ).observe(video);

    pausa.addEventListener('click', () => {
      if (video.paused) {
        pausadoAMano = false;
        void video.play();
      } else {
        pausadoAMano = true;
        video.pause();
      }
    });

    sonido.addEventListener('click', () => {
      video.muted = !video.muted;
      reel.toggleAttribute('data-sonido', !video.muted);
      sonido.setAttribute('aria-label', video.muted ? 'Activar el sonido' : 'Quitar el sonido');
      if (!video.muted && video.paused) {
        pausadoAMano = false;
        void video.play();
      }
    });
  });
</script>
