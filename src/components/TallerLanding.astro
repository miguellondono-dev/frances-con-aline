<script>
  import '../scripts/talleres-estado';

  /* Las laminas se turnan: la de delante sale y pasa al fondo cada 3,8 s.
     Solo mientras se ven, nunca con movimiento reducido, y se paran al pasar
     el raton para poder mirarlas. */
  document.querySelectorAll<HTMLElement>('[data-baraja]').forEach((baraja) => {
    const laminas = Array.from(baraja.querySelectorAll<HTMLElement>('[data-baraja-lamina]'));
    if (laminas.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let visible = false;
    let encima = false;
    const turno = () => {
      if (!visible || encima) return;
      laminas.forEach((l) => {
        const pos = Number(l.dataset.pos);
        if (pos === 0) {
          l.setAttribute('data-sale', '');
          l.addEventListener('animationend', () => l.removeAttribute('data-sale'), { once: true });
          l.dataset.pos = String(laminas.length - 1);
        } else {
          l.dataset.pos = String(pos - 1);
        }
      });
    };

    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(baraja);
    baraja.addEventListener('pointerenter', () => (encima = true));
    baraja.addEventListener('pointerleave', () => (encima = false));
    window.setInterval(turno, 3800);
  });

  /* Las escenas de "Qué hacemos" solo se mueven mientras su tarjeta se ve:
     [data-vivo] al entrar, fuera al salir, y nunca con movimiento reducido. */
  const logros = document.querySelectorAll<HTMLElement>('[data-logro-taller]');
  if (logros.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          const tarjeta = e.target as HTMLElement;
          if (e.isIntersecting) tarjeta.dataset.vivo = 'true';
          else delete tarjeta.dataset.vivo;
        }),
      { threshold: 0.3 },
    );
    logros.forEach((l) => io.observe(l));
  }

  /* El reel corre solo mientras esta a la vista, y nunca si quien entra
     prefiere menos movimiento. Si alguien lo pausa, se queda pausado. */
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const video = reel.querySelector<HTMLVideoElement>('[data-reel-video]');
    const pausa = reel.querySelector<HTMLButtonElement>('[data-reel-pausa]');
    const sonido = reel.querySelector<HTMLButtonElement>('[data-reel-sonido]');
    if (!video || !pausa || !sonido) return;

    let pausadoAMano = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const marcar = () => {
      reel.toggleAttribute('data-pausado', video.paused);
      pausa.setAttribute('aria-label', video.paused ? 'Reproducir el vídeo' : 'Pausar el vídeo');
    };
    video.addEventListener('play', marcar);
    video.addEventListener('pause', marcar);
    marcar();

    new IntersectionObserver(
      ([entrada]) => {
        if (entrada.isIntersecting && !pausadoAMano) void video.play().catch(() => marcar());
        else if (!entrada.isIntersecting) video.pause();
      },
      { threshold: 0.35 },
    ).observe(video);

    pausa.addEventListener('click', () => {
      if (video.paused) {
        pausadoAMano = false;
        void video.play();
      } else {
        pausadoAMano = true;
        video.pause();
      }
    });

    sonido.addEventListener('click', () => {
      video.muted = !video.muted;
      reel.toggleAttribute('data-sonido', !video.muted);
      sonido.setAttribute('aria-label', video.muted ? 'Activar el sonido' : 'Quitar el sonido');
      if (!video.muted && video.paused) {
        pausadoAMano = false;
        void video.play();
      }
    });
  });
</script>
