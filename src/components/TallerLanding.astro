---
import ChatWhatsapp from './ChatWhatsapp.astro';
import { Image, Picture } from 'astro:assets';
import Cta from './Cta.astro';
import EscenaTaller from './graficos/EscenaTaller.astro';
import type { TipoEscenaTaller } from './graficos/escenas';
import { whatsapp } from '../data/site';
import {
  estadoDe,
  hechos,
  mensajeAviso,
  mensajeInscripcion,
  mensajePregunta,
  type Taller,
} from '../data/talleres';

/**
 * La pagina de un taller. Teatro y acuarela son el mismo producto con otra
 * materia, asi que comparten plantilla: si el orden de la informacion cambia,
 * cambia en los dos a la vez y no se pueden desalinear.
 *
 * Tres estados:
 *  - Con tanda y plazas abiertas: "Inscribirme" y hasta cuando se puede.
 *  - Con tanda y plazas cerradas: "Avísame del próximo". Pasa solo al llegar
 *    la fecha de cierre (scripts/talleres-estado.ts).
 *  - Sin tanda: "Próximamente" y "Avísame".
 */

interface Props {
  taller: Taller;
  /** La foto del encabezado. La mas fuerte que haya. */
  portada: ImageMetadata;
  portadaAlt: string;
  /** Un reel vertical para la cabecera. Si lo hay, va en lugar de la foto. */
  reel?: { src: string; poster: ImageMetadata; alt: string };
  /**
   * Laminas para la cabecera: van apiladas y se turnan delante. Si las hay,
   * van en lugar de la foto. Solo las usa acuarela.
   */
  laminas?: { src: ImageMetadata; alt: string }[];
  /**
   * Quien hace el taller y donde: personas con su retrato (y su firma, si la
   * tiene) o un sitio con su logo. Solo lo usa acuarela, que tiene artista
   * invitada y galeria.
   */
  equipo?: {
    rol: string;
    nombre: string;
    texto: string;
    /** Retrato recortado, con el fondo transparente. */
    foto?: ImageMetadata;
    /** En lugar del retrato: el logo del sitio. */
    logo?: ImageMetadata;
    /** La firma, encima del retrato, como en una lamina firmada. */
    firma?: ImageMetadata;
    alt: string;
    enlace?: { href: string; texto: string };
  }[];
}

const { taller: t, portada, portadaAlt, reel, laminas = [], equipo = [] } = Astro.props;

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
  { name: t.nombre, path: `/talleres/${t.slug}` },
];

const idForma = `plaza-${t.slug}`;

const tanda = t.tanda;

/**
 * Con link de pago, "Inscribirme" lleva a pagar y WhatsApp queda para las
 * dudas. Sin el, la plaza se cierra por WhatsApp como siempre.
 */
const pago = tanda?.pago;
const inscribirme = pago ?? whatsapp(mensajeInscripcion(t));

/** Lo que hay que saber antes de pagar, pegado al precio. Solo lo que este. */
const condiciones = [
  t.incluye && `Incluye ${t.incluye.charAt(0).toLowerCase()}${t.incluye.slice(1)}`,
  t.nivel && `Nivel de francés: ${t.nivel.charAt(0).toLowerCase()}${t.nivel.slice(1)}`,
  tanda?.plazas && `${tanda.plazas} plazas`,
].filter(Boolean) as string[];

/**
 * La escena de cada cosa que se practica, en el orden de talleres.ts. Si un
 * taller nuevo no tiene las suyas, sale la mezcla de color por defecto.
 */
const ESCENAS: Record<string, TipoEscenaTaller[]> = {
  acuarela: ['mezcla', 'vocabulario', 'boceto', 'lamina'],
  teatro: ['voz', 'trabalenguas', 'expresiones', 'escena', 'mascara'],
};
const escenaDe = (i: number): TipoEscenaTaller => ESCENAS[t.slug]?.[i] ?? 'mezcla';

/**
 * El mosaico de "Lo que vas a conseguir": filas de dos, ancha y estrecha y
 * luego estrecha y ancha. Si queda una sola al final, ocupa la fila entera.
 */
const total = t.practica.length;
const forma = (i: number) =>
  total % 2 === 1 && i === total - 1 ? 'entera' : i % 4 === 0 || i % 4 === 3 ? 'ancha' : 'estrecha';
/** Si al compilar ya habia pasado el cierre, sale cerrado de entrada. */
const cerradoYa = estadoDe(t) === 'cerrado' ? '' : undefined;

---

<section class="cabecera">
  <div class="shell pt-14 pb-section-sm">

    <div class="cabecera__reparto">
      <div class="cabecera__texto">
        <h1 class="cabecera__titulo" data-palabras data-repite>
          {
            t.acento && t.titular.includes(t.acento) ? (
              <>
                {t.titular.slice(0, t.titular.indexOf(t.acento))}
                <em class="destacado">{t.acento}</em>
                {t.titular.slice(t.titular.indexOf(t.acento) + t.acento.length)}
              </>
            ) : (
              t.titular
            )
          }
        </h1>

        <p class="measure mt-7 text-body text-nuit" data-reveal>
          {t.parrafos[0]}
        </p>

        {/*
          Los mismos tres hechos que en la rejilla y en el mismo orden. Quien
          llega desde la tarjeta encuentra los datos donde ya los vio.
        */}
        <dl class="hechos" data-reveal>
          {
            hechos(t).map((h) => (
              <div class="hechos__par">
                <dt class="hechos__clave">{h.clave}</dt>
                <dd class="hechos__valor">{h.valor}</dd>
              </div>
            ))
          }
        </dl>

        <div
          class="cabecera__acciones"
          data-reveal
          data-taller-cierre={tanda?.iso.cierre}
          data-taller-cerrado={cerradoYa}
        >
          {
            tanda ? (
              <>
                <div class="si-abierto">
                  <Cta href={inscribirme} variant="grenat">
                    {pago ? 'Reservar mi plaza' : 'Inscribirme'}
                  </Cta>
                  <p class="aviso-estado">
                    <span class="aviso-estado__punto" aria-hidden="true" />
                    Plazas abiertas hasta el {tanda.cierre}
                  </p>
                </div>
                <div class="si-cerrado">
                  <Cta href={whatsapp(mensajeAviso(t))}>Avísame del próximo</Cta>
                  <p class="aviso-estado aviso-estado--cerrado">Plazas cerradas para esta fecha</p>
                </div>
              </>
            ) : (
              <>
                <Cta href={whatsapp(mensajeAviso(t))} variant="grenat">
                  Avísame
                </Cta>
                <p class="aviso-estado aviso-estado--proximo">
                  <span class="aviso-estado__punto" aria-hidden="true" />
                  Próximamente
                </p>
              </>
            )
          }
        </div>
      </div>

      {
        laminas.length > 0 ? (
          /* Las laminas: apiladas sobre una mancha de acuarela de la marca.
             Cada pocos segundos la de delante se aparta y pasa al fondo. */
          <div class="baraja" data-reveal="fade" data-baraja>
            <span class="baraja__mancha baraja__mancha--a" aria-hidden="true" />
            <span class="baraja__mancha baraja__mancha--b" aria-hidden="true" />
            <ul class="baraja__pila">
              {laminas.map((l, i) => (
                <li class="baraja__lamina" data-pos={i} data-baraja-lamina>
                  <Picture
                    src={l.src}
                    alt={l.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[360, 540, 720]}
                    sizes="(min-width: 64rem) 20rem, 72vw"
                    class="baraja__img"
                    loading="eager"
                  />
                </li>
              ))}
            </ul>
          </div>
        ) : reel ? (
          /* El reel: vertical, sin sonido y en bucle mientras se ve, sobre una
             carta roja girada que le da fondo. Con pausa y sonido a mano. */
          <div class="reel" data-reveal="fade" data-reel>
            <span class="reel__fondo" aria-hidden="true" />
            <div class="reel__marco">
              <video
                class="reel__video"
                src={reel.src}
                poster={reel.poster.src}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={reel.alt}
                data-reel-video
              />
              <div class="reel__controles">
                <button class="reel__boton" type="button" data-reel-pausa aria-label="Pausar el vídeo">
                  <svg class="reel__icono reel__icono--pausa" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5.5h2.6v13H8zM13.4 5.5H16v13h-2.6z" fill="currentColor" />
                  </svg>
                  <svg class="reel__icono reel__icono--play" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8.5 5.5v13L19 12z" fill="currentColor" />
                  </svg>
                </button>
                <button class="reel__boton" type="button" data-reel-sonido aria-label="Activar el sonido">
                  <svg class="reel__icono reel__icono--mudo" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
                    <path d="M16 9.5l5 5M21 9.5l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  <svg class="reel__icono reel__icono--sonido" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
                    <path d="M15.5 9a4 4 0 010 6M18 6.5a7.5 7.5 0 010 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        ) : (
          <div class="cabecera__foto" data-reveal="fade">
            <Picture
              src={portada}
              alt={portadaAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900]}
              sizes="(min-width: 64rem) 28rem, 92vw"
              class="cabecera__img"
              loading="eager"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<!-- Que se practica. Cosas nombrables, no promesas. -->
<!-- Que hacemos. El mismo mosaico que "Lo que vas a conseguir" en las paginas
     de clases: cada cosa que se practica con su mini escena animada, su
     numero y su nombre. Las tarjetas sueltas con un numero que habia antes
     parecian de plantilla. -->
<section class="practica" aria-labelledby="practica">
  <div class="shell py-section">
    <div class="practica__cabecera">
      <h2 id="practica" class="titulo-seccion text-encre" data-palabras data-repite>
        Qué <em class="destacado">hacemos</em> en el taller
      </h2>
      <p class="practica__frase" data-reveal>
        {t.parrafos[1]}
      </p>
    </div>

    <ol class="mosaico">
      {
        t.practica.map((cosa, i) => (
          <li class:list={['logro', `logro--${forma(i)}`]} data-logro-taller data-reveal style={`--i: ${i}`}>
            <article class="logro__tarjeta">
              <div class:list={['logro__escena', i % 2 === 0 ? 'logro__escena--calida' : 'logro__escena--fria']}>
                <EscenaTaller tipo={escenaDe(i)} />
              </div>
              <div class="logro__cuerpo">
                <span class="logro__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="logro__titulo">{cosa}</h3>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Programa. La mañana hora a hora: quien reserva quiere saber a que hora
     llega, que hace y a que hora se va. -->
{
  tanda?.programa && (
    <section class="programa" aria-labelledby="programa">
      <div class="shell py-section">
        <div class="practica__cabecera">
          <h2 id="programa" class="titulo-seccion text-encre" data-palabras data-repite>
            Cómo es la <em class="destacado">mañana</em>
          </h2>
          <p class="practica__frase" data-reveal>
            {tanda.cuando}, de {tanda.hora}, en la {tanda.lugar ?? t.ciudad}.
          </p>
        </div>

        <ol class="horario">
          {tanda.programa.map((p, i) => (
            <li class="horario__paso logro" data-reveal style={`--i: ${i}`}>
              <span class="horario__hora numerals">{p.hora}</span>
              <span class="horario__punto" aria-hidden="true" />
              <span class="horario__titulo">{p.titulo}</span>
              <span class="horario__detalle">{p.detalle}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<!-- Equipo. Las mismas tarjetas del mosaico, con un retrato o un logo donde
     van las escenas. La firma de la artista va encima, como en una lamina. -->
{
  equipo.length > 0 && (
    <section class="equipo" aria-labelledby="equipo">
      <div class="shell py-section">
        <div class="practica__cabecera">
          <h2 id="equipo" class="titulo-seccion text-encre" data-palabras data-repite>
            Con quién y dónde <em class="destacado">pintas</em>
          </h2>
        </div>

        <ul class="equipo__rejilla">
          {equipo.map((p, i) => (
            <li class="logro" data-reveal style={`--i: ${i}`}>
              <article class="logro__tarjeta">
                <div
                  class:list={[
                    'logro__escena',
                    'equipo__escena',
                    i % 2 === 0 ? 'logro__escena--calida' : 'logro__escena--fria',
                  ]}
                >
                  {p.foto && (
                    <Picture
                      src={p.foto}
                      alt={p.alt}
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      widths={[320, 480, 640]}
                      sizes="(min-width: 64rem) 22rem, 90vw"
                      class="equipo__foto"
                    />
                  )}
                  {p.logo && <Image src={p.logo} alt={p.alt} widths={[320, 640]} sizes="16rem" class="equipo__logo" />}
                  {p.firma && <Image src={p.firma} alt="" widths={[240, 480]} sizes="11rem" class="equipo__firma" />}
                </div>
                <div class="logro__cuerpo">
                  <span class="logro__num">{p.rol}</span>
                  <h3 class="logro__titulo">{p.nombre}</h3>
                  <p class="equipo__texto">{p.texto}</p>
                  {p.enlace && (
                    <a
                      class="equipo__enlace"
                      href={p.enlace.href}
                      target={p.enlace.href.startsWith('http') ? '_blank' : undefined}
                      rel={p.enlace.href.startsWith('http') ? 'noopener' : undefined}
                    >
                      {p.enlace.texto}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<!-- Reserva. Con link de pago se paga en su pagina; sin el, se cierra por WhatsApp. -->
<section
  class="reserva"
  id={idForma}
  aria-labelledby={`${idForma}-titulo`}
  data-taller-cierre={tanda?.iso.cierre}
  data-taller-cerrado={cerradoYa}
>
  <div class="shell py-section">
    {
      tanda && (
        <div class="si-abierto">
          <div class="reserva__caja">
            <div>
              <h2 id={`${idForma}-titulo`} class="text-display-m text-encre" data-reveal>
                Inscríbete
              </h2>
              <p class="measure mt-5 text-body text-nuit" data-reveal>
                {
                  pago
                    ? 'Pagas en línea con tarjeta, Apple Pay o Google Pay, y te llega la confirmación con la dirección exacta.'
                    : 'Escríbeme por WhatsApp y te confirmo la plaza, con la dirección exacta y la forma de pago.'
                }
              </p>

              <p class="reserva__resumen" data-reveal>
                <span class="reserva__precio numerals">{tanda.precio} €</span>
                <span class="reserva__detalle">
                  {t.sesiones > 1 ? `las ${t.sesiones} sesiones, no cada una` : 'la sesión'}
                </span>
              </p>
              <p class="reserva__fecha" data-reveal>
                {tanda.cuando} · {tanda.hora}
                {tanda.lugar && <span class="reserva__lugar">{tanda.lugar}</span>}
              </p>

              {
                condiciones.length > 0 && (
                  <ul class="reserva__condiciones" data-reveal>
                    {condiciones.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                )
              }

              {tanda.cancelacion && <p class="reserva__letra" data-reveal>{tanda.cancelacion}</p>}

              {
                pago && (
                  <div class="reserva__pagar" data-reveal>
                    <Cta href={pago} variant="grenat">
                      Reservar mi plaza · {tanda.precio} €
                    </Cta>
                  </div>
                )
              }
            </div>

            <ChatWhatsapp
              mensaje={pago ? mensajePregunta(t) : mensajeInscripcion(t)}
              boton={pago ? 'Preguntar' : 'Inscribirme'}
              asunto={pago ? `Una pregunta sobre el taller de ${t.slug}` : `Quiero una plaza en el taller de ${t.slug}`}
            />
          </div>
        </div>
      )
    }

    <div class={tanda ? 'si-cerrado' : undefined}>
      <div class="reserva__caja">
        <div>
          <h2 id={tanda ? undefined : `${idForma}-titulo`} class="text-display-m text-encre" data-reveal>
            {tanda ? '¿Te aviso del próximo?' : '¿Te aviso de las fechas?'}
          </h2>
          <p class="measure mt-5 text-body text-nuit" data-reveal>
            {
              tanda
                ? 'Las plazas de esta fecha ya están cerradas. Escríbeme y te cuento cuándo es el próximo.'
                : 'Estoy preparando las próximas fechas. Escríbeme y te las cuento en cuanto estén.'
            }
          </p>
        </div>

        <ChatWhatsapp
          mensaje={mensajeAviso(t)}
          boton="Avísame"
          asunto={`Avísame del próximo taller de ${t.slug}`}
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Fondos: el mismo lenguaje del inicio --- */

  .cabecera {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 44%, var(--color-blanc)) 40%,
      color-mix(in srgb, var(--color-papier) 26%, var(--color-blanc)) 78%,
      var(--color-blanc) 100%
    );
  }

  .practica {
    background-color: var(--color-blanc);
  }

  .reserva {
    background-color: var(--color-blanc);
  }

  /* --- Cabecera --- */

  .cabecera__reparto {
    display: grid;
    gap: 3rem;
  }

  @media (width >= 64rem) {
    .cabecera__reparto {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: 4rem;
    }
  }

  /* El mismo titular que el resto de paginas interiores (titulo-portada en
     global.css). */
  .cabecera__titulo {
    margin-top: 2rem;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.5rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--color-encre);
  }

  .cabecera__foto {
    overflow: hidden;
    border-radius: 26px;
    box-shadow: var(--shadow-alta);
  }

  .cabecera__img {
    display: block;
    height: 100%;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* --- Las laminas de acuarela --- */

  .baraja {
    position: relative;
    justify-self: center;
    width: min(100%, 21rem);
    margin: 2rem 0;
  }

  /* El fondo: dos manchas de acuarela de la marca que respiran despacio. */
  .baraja__mancha {
    position: absolute;
    border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%;
    filter: blur(2px);
    pointer-events: none;
  }

  .baraja__mancha--a {
    inset: -8% -14% 18% -10%;
    background: radial-gradient(
      circle at 40% 40%,
      color-mix(in srgb, var(--color-chair) 70%, var(--color-blanc)),
      color-mix(in srgb, var(--color-papier) 40%, transparent) 70%
    );
    animation: baraja-mancha 9s ease-in-out infinite alternate;
  }

  .baraja__mancha--b {
    inset: 30% -18% -10% 22%;
    background: radial-gradient(
      circle at 60% 55%,
      color-mix(in srgb, var(--color-ciel) 75%, var(--color-blanc)),
      color-mix(in srgb, var(--color-ciel) 25%, transparent) 70%
    );
    animation: baraja-mancha 11s ease-in-out infinite alternate-reverse;
  }

  @keyframes baraja-mancha {
    to {
      border-radius: 56% 44% 44% 56% / 42% 58% 42% 58%;
      transform: rotate(8deg) scale(1.04);
    }
  }

  .baraja__pila {
    position: relative;
    aspect-ratio: 4 / 5;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Cada lamina con un paspartu blanco, como una lamina montada. La
     posicion (delante, segunda, tercera) la pone data-pos. */
  .baraja__lamina {
    position: absolute;
    inset: 0;
    padding: 0.6rem;
    border-radius: 20px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-alta);
    transition:
      transform 900ms var(--ease-fluid),
      opacity 600ms var(--ease-smooth);
  }

  .baraja__lamina[data-pos='0'] {
    z-index: 3;
    transform: rotate(-3deg);
  }

  .baraja__lamina[data-pos='1'] {
    z-index: 2;
    transform: translate(9%, 3%) rotate(5deg) scale(0.95);
  }

  .baraja__lamina[data-pos='2'] {
    z-index: 1;
    transform: translate(-8%, 5%) rotate(-9deg) scale(0.9);
  }

  /* La que se va: sale hacia la izquierda y entra por detras. */
  .baraja__lamina[data-sale] {
    animation: baraja-sale 900ms var(--ease-fluid);
  }

  @keyframes baraja-sale {
    0% {
      z-index: 3;
      transform: rotate(-3deg);
    }
    45% {
      z-index: 3;
      transform: translate(-62%, -4%) rotate(-16deg);
    }
    55% {
      z-index: 0;
      transform: translate(-62%, -4%) rotate(-16deg);
    }
    100% {
      z-index: 1;
