---
import logoWhatsapp from '@phosphor-icons/core/fill/whatsapp-logo-fill.svg?raw';
import type { Pregunta } from '../data/faq';
import { whatsapp, WA } from '../data/site';

/**
 * PREGUNTAS FRECUENTES.
 *
 * details/summary nativo: funciona sin JavaScript, es accesible por teclado de
 * fabrica y el texto de la respuesta esta siempre en el DOM, asi que los
 * buscadores lo leen aunque este plegado.
 * Las tres primeras van abiertas para que la primera respuesta se vea entera.
 *
 * Al final de la lista, la salida para quien no encontro su pregunta: va
 * despues de las preguntas y no debajo del titular, que es donde la pidio
 * Miguel, y abre WhatsApp con el mensaje ya escrito.
 */
interface Props {
  preguntas: Pregunta[];
  titulo?: string;
  /** Ancla del bloque, para enlazarlo desde otras paginas. */
  id?: string;
  /** Nivel del encabezado de cada pregunta, para no romper la jerarquia. */
  nivel?: 'h3' | 'h4';
}

const {
  preguntas,
  titulo = 'Preguntas frecuentes',
  id = 'preguntas',
  nivel = 'h3',
} = Astro.props;

const Encabezado = nivel;
const icono = logoWhatsapp.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<section class="bg-blanc" aria-labelledby={`${id}-titulo`}>
  <div class="shell grid gap-8 py-section lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <div class="faq-cabecera lg:sticky lg:top-28">
        {/* Un signo de pregunta enorme detras del titular, que respira, como
            las comillas de las opiniones. Antes el titular iba fino y solo. */}
        <span class="faq-signo" aria-hidden="true">?</span>
        <h2 id={`${id}-titulo`} class="titulo-seccion faq-titulo text-encre" data-palabras data-repite>
          {titulo}
        </h2>
      </div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6" id={id}>
      {
        preguntas.map((pregunta, i) => (
          <details class="faq-item" data-reveal>
            <summary class="faq-summary flex cursor-pointer list-none items-start justify-between gap-6">
              <Encabezado class="text-title text-encre">{pregunta.q}</Encabezado>
              <span class="faq-mark shrink-0 text-corail" aria-hidden="true">
                <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none">
                  <path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
            </summary>

            <div class="faq-respuesta">
              {pregunta.pendiente ? (
                /* TODO [PENDIENTE] Falta la decision. No se inventa la respuesta:
                   se publica el hueco marcado, que es preferible a una mentira. */
                <p class="max-w-[62ch] rounded-panel border border-corail/40 bg-papier px-5 py-4 text-body text-encre">
                  <span class="label mb-1 block text-lie">Pendiente</span>
                  {pregunta.a.replace(/^PENDIENTE:\s*/, '')}
                </p>
              ) : (
                <p class="max-w-[62ch] text-body text-encre/70">{pregunta.a}</p>
              )}
            </div>
          </details>
        ))
      }

      <div class="faq-cierre" data-reveal>
        <a class="faq-cierre__enlace" href={whatsapp(WA.pregunta)} target="_blank" rel="noopener">
          <span class="faq-cierre__icono"><Fragment set:html={icono} /></span>
          <span class="faq-cierre__texto">Escríbeme y te resuelvo cualquier duda</span>
          <svg class="faq-cierre__flecha" viewBox="0 0 24 16" fill="none" aria-hidden="true">
            <path d="M0 8h22M15 1l7 7-7 7" stroke="currentColor" stroke-width="1.8" />
          </svg>
          <span class="sr-only"> (por WhatsApp)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-cabecera {
    position: relative;
  }

  .faq-signo {
    position: absolute;
    top: -4.2rem;
    left: -0.6rem;
    font-family: var(--font-display);
    font-size: 11rem;
    font-weight: 800;
    line-height: 1;
    color: color-mix(in srgb, var(--color-grenat) 14%, transparent);
    pointer-events: none;
    animation: faq-respira 6s ease-in-out infinite alternate;
  }

  @keyframes faq-respira {
    from {
      transform: translateY(0) rotate(0deg);
    }
    to {
      transform: translateY(-10px) rotate(8deg);
    }
  }

  .faq-titulo {
    position: relative;
    max-width: 10ch;
  }

  /* Cada pregunta, una pieza: al pasar se tiñe y la abierta se queda con
     fondo calido y una barra roja a la izquierda. */
  .faq-item {
    position: relative;
    border-radius: 16px;
    transition: background-color 320ms var(--ease-smooth);
  }

  .faq-item + .faq-item {
    margin-top: 0.35rem;
  }

  .faq-summary {
    padding: 1.05rem 1.25rem;
  }

  .faq-respuesta {
    padding: 0 1.25rem 1.25rem;
  }

  .faq-item::before {
    content: '';
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 0;
    width: 3px;
    border-radius: 3px;
    background-color: var(--color-grenat);
    transform: scaleY(0);
    transition: transform 420ms var(--ease-fluid);
  }

  .faq-item[open] {
    background-color: color-mix(in srgb, var(--color-papier) 38%, var(--color-blanc));
  }

  .faq-item[open]::before {
    transform: scaleY(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-item:not([open]):hover {
      background-color: color-mix(in srgb, var(--color-papier) 22%, var(--color-blanc));
    }
  }

  /* El signo + dentro de un circulo, que gira a x al abrir. */
  .faq-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: -0.15rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-corail) 45%, transparent);
    transition: background-color 320ms var(--ease-smooth), color 320ms var(--ease-smooth);
  }

  .faq-item[open] .faq-mark {
    background-color: var(--color-grenat);
    color: var(--color-blanc);
    box-shadow: none;
  }

  .faq-mark svg {
    transition: transform var(--duration-normal) var(--ease-smooth);
  }

  .faq-item[open] .faq-mark svg {
    transform: rotate(45deg);
  }

  /* La salida del final: una linea, no un bloque. El circulo de WhatsApp
     late despacio; al pasar por encima, el subrayado rojo se dibuja de
     izquierda a derecha y la flecha avanza. */
  .faq-cierre {
    margin-top: 1rem;
    padding: 1.75rem 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-encre) 10%, transparent);
  }

  .faq-cierre__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-encre);
    text-decoration: none;
  }

  .faq-cierre__icono {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
    color: var(--color-blanc);
    transition: background-color 320ms var(--ease-smooth);
  }

  .faq-cierre__icono :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .faq-cierre__icono::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-grenat) 55%, transparent);
    animation: faq-late 2.6s var(--ease-smooth) infinite;
  }

  @keyframes faq-late {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .faq-cierre__texto {
    position: relative;
    padding-bottom: 0.15em;
  }

  .faq-cierre__texto::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--color-lie);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease-fluid);
  }

  .faq-cierre__flecha {
    width: 1.35rem;
    height: 0.9rem;
    flex-shrink: 0;
    color: var(--color-grenat);
    transition: transform 420ms var(--ease-fluid);
  }

  .faq-cierre__enlace:hover .faq-cierre__texto::after,
  .faq-cierre__enlace:focus-visible .faq-cierre__texto::after {
    transform: scaleX(1);
  }

  .faq-cierre__enlace:hover .faq-cierre__flecha,
  .faq-cierre__enlace:focus-visible .faq-cierre__flecha {
    transform: translateX(6px);
  }

  .faq-cierre__enlace:hover .faq-cierre__icono {
    background-color: var(--color-lie);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-signo {
      animation: none;
    }

    .faq-item::before {
      transition: none;
    }

    .faq-mark svg,
    .faq-cierre__texto::after,
    .faq-cierre__flecha {
      transition: none;
    }

    .faq-cierre__icono::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
