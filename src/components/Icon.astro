---
/**
 * Marcas de línea del sitio.
 *
 * La primera versión derivaba todas del ojo del logo y a 24px se leían como
 * ojos raros, no como iconos. Ahora son marcas convencionales y legibles:
 * un icono tiene que entenderse en medio segundo, no ser ingenioso.
 *
 * Trazo 1.5, remates redondos, rejilla de 24. Siempre decorativas: nunca
 * cargan significado que no esté ya en el texto.
 */
interface Props {
  name:
    | 'privada'
    | 'grupo'
    | 'delf'
    | 'escuchar'
    | 'plan'
    | 'material'
    | 'tarea'
    | 'presencial'
    | 'rapido'
    | 'gratis'
    | 'escudo'
    | 'musica'
    | 'lectura'
    | 'foto'
    | 'viaje'
    | 'cine'
    | 'cocina';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'privada' && (
      <>
        <circle cx="12" cy="8" r="3.6" />
        <path d="M5 20c0-3.7 3.1-5.6 7-5.6s7 1.9 7 5.6" />
      </>
    )
  }

  {
    name === 'grupo' && (
      <>
        <circle cx="9" cy="8.5" r="3.1" />
        <path d="M3 19.5c0-3.2 2.7-4.9 6-4.9s6 1.7 6 4.9" />
        <path d="M16.2 6.2a3 3 0 0 1 0 5.8" />
        <path d="M17.5 15.1c2.1.5 3.5 1.9 3.5 4.4" />
      </>
    )
  }

  {
    name === 'delf' && (
      <>
        <path d="M6 3h8l4 4v14H6z" />
        <path d="M14 3v4h4" />
        <path d="M9 14.2l2.2 2.2 4.3-4.6" />
      </>
    )
  }

  {
    name === 'escuchar' && (
      <>
        <circle cx="5" cy="12" r="1.7" fill="currentColor" stroke="none" />
        <path d="M9.5 15.2a4.5 4.5 0 0 1 0-6.4" />
        <path d="M13 18.4a9 9 0 0 1 0-12.8" />
        <path d="M16.5 21.5a13.5 13.5 0 0 1 0-19" />
      </>
    )
  }

  {
    name === 'plan' && (
      <>
        <path d="M7 21.5V3" />
        <path d="M7 4.2h10l-2.8 3.4L17 11H7" />
      </>
    )
  }

  {
    name === 'material' && (
      <>
        <path d="M12 7.4C10.4 5.9 7.9 5.4 4 5.4v12c3.9 0 6.4.5 8 2 1.6-1.5 4.1-2 8-2v-12c-3.9 0-6.4.5-8 2z" />
        <path d="M12 7.4v12" />
      </>
    )
  }

  {
    name === 'tarea' && (
      <>
        <path d="M4 20.2l.9-3.8L15.8 5.5l2.9 2.9L7.8 19.3z" />
        <path d="M14.3 7l2.9 2.9" />
      </>
    )
  }

  {
    name === 'presencial' && (
      <>
        <path d="M12 21c4.5-5 7-8.3 7-11a7 7 0 1 0-14 0c0 2.7 2.5 6 7 11Z" />
        <circle cx="12" cy="10" r="2.2" />
      </>
    )
  }

  {
    name === 'rapido' && <path d="M13.4 2.5 4.8 13.2h6L10.6 21.5l8.6-10.7h-6z" />
  }

  {
    name === 'gratis' && (
      <>
        <path d="M11.4 3.4H5.2a1.8 1.8 0 0 0-1.8 1.8v6.2c0 .5.2.9.5 1.3l7.3 7.3a1.8 1.8 0 0 0 2.6 0l6.2-6.2a1.8 1.8 0 0 0 0-2.6l-7.3-7.3a1.8 1.8 0 0 0-1.3-.5Z" />
        <circle cx="7.9" cy="7.9" r="1.3" />
      </>
    )
  }

  {
    name === 'escudo' && (
      <>
        <path d="M12 2.8 4.8 5.6v5.8c0 4.4 3 8.2 7.2 9.8 4.2-1.6 7.2-5.4 7.2-9.8V5.6z" />
        <path d="M8.9 11.9 11.3 14.3 15.4 9.6" />
      </>
    )
  }

  {/* --- Temas de clase --- */}

  {
    name === 'musica' && (
      <>
        <path d="M9.5 17.9V5.8l9-1.8v12.1" />
        <circle cx="7" cy="17.9" r="2.5" />
        <circle cx="16" cy="16.1" r="2.5" />
      </>
    )
  }

  {
    name === 'lectura' && (
      <>
        <path d="M12 6.8v12.6" />
        <path d="M12 6.8C10.3 5.4 8.3 4.7 6 4.7H3.5v12.6H6c2.3 0 4.3.7 6 2.1" />
        <path d="M12 6.8c1.7-1.4 3.7-2.1 6-2.1h2.5v12.6H18c-2.3 0-4.3.7-6 2.1" />
      </>
    )
  }

  {
    name === 'foto' && (
      <>
        <path d="M4.2 7.9h3.1l1.4-2.3h6.6l1.4 2.3h3.1a1 1 0 0 1 1 1v9.5a1 1 0 0 1-1 1H4.2a1 1 0 0 1-1-1V8.9a1 1 0 0 1 1-1Z" />
        <circle cx="12" cy="13.4" r="3.3" />
      </>
    )
  }

  {
    name === 'viaje' && (
      <>
        <rect x="3.4" y="8.4" width="17.2" height="10.6" rx="2" />
        <path d="M8.8 8.4V6.2a1.4 1.4 0 0 1 1.4-1.4h3.6a1.4 1.4 0 0 1 1.4 1.4v2.2" />
        <path d="M3.4 13.4h17.2" />
      </>
    )
  }

  {
    name === 'cine' && (
      <>
        <rect x="3.4" y="5.4" width="17.2" height="13.2" rx="2" />
        <path d="M8 5.4v13.2M16 5.4v13.2" />
        <path d="M3.4 9.8h4.6M3.4 14.2h4.6M16 9.8h4.6M16 14.2h4.6" />
      </>
    )
  }

  {
    name === 'cocina' && (
      <>
        <path d="M4.6 9.9h14.8v5.3a3.8 3.8 0 0 1-3.8 3.8H8.4a3.8 3.8 0 0 1-3.8-3.8z" />
        <path d="M4.6 11.6H2.9M19.4 11.6h1.7" />
        <path d="M9.2 6.9c0-1 1-1.4 1-2.4M12.4 6.9c0-1 1-1.4 1-2.4M15.6 6.9c0-1 1-1.4 1-2.4" />
      </>
    )
  }

</svg>
