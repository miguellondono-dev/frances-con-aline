---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Cta from './Cta.astro';
import Faq from './Faq.astro';
import ChatWhatsapp from './ChatWhatsapp.astro';
import Metodo from './home/Method.astro';
import Vocabulario from './home/Thesis.astro';
import EscenaLogro from './graficos/EscenaLogro.astro';
import Opiniones from './Opiniones.astro';
import type { TipoEscena } from './graficos/escenas';
import { icono, type NombreIcono } from '../data/iconos';
import { WA, whatsapp } from '../data/site';
import type { Pregunta } from '../data/faq';

/**
 * PLANTILLA DE LANDING DE SERVICIO.
 *
 * La comparten /clases-privadas, /clases-en-grupo y /preparacion-delf. El copy
 * no: cada pagina trae el suyo.
 *
 * Rediseño de septiembre de 2026. Miguel vio grupo y DELF "horribles": mucho
 * texto, poca animacion, y la ilustracion de la portada metida en la forma de
 * ojo. Las tres paginas comparten ahora esta estructura, con menos texto:
 *
 *  1. Portada partida: el texto a un lado y, al otro, la foto en tarjeta o la
 *     ilustracion propia de la pagina en una tarjeta redondeada.
 *  2. Lo que vas a conseguir: un mosaico de tarjetas, una ancha y una
 *     estrecha que se alternan por filas. Cada tarjeta lleva una escena
 *     pequeña que enseña el logro (graficos/EscenaLogro.astro) y que solo se
 *     mueve mientras se ve. Antes era una lista con un panel azul fijo que
 *     repetia el texto; a Miguel le parecia fea y sin sentido.
 *  3. Como empezamos: la linea de tiempo del inicio.
 *  4. Precio y bonos, en la banda oscura con el parpadeo.
 *  5. Preguntas frecuentes.
 *  6. Cierre.
 *
 * Fondos: blanco, calido, blanco, azul, blanco, calido. Nunca dos iguales
 * seguidos.
 *
 * Tres piezas opcionales, que de momento solo usa /clases-privadas porque
 * Miguel la veia plana al lado de /talleres:
 *  - el slot "collage", que sustituye a la foto sola de la portada;
 *  - `vocabulario`: la banda de tinta con palabras en frances bajo la
 *    portada (entre el blanco de la portada y el calido de los logros);
 *  - `cierre.chat`: el cierre partido, con la tarjeta de WhatsApp.
 *
 * Animacion: con `gsap` la lleva GSAP (scripts/clases-gsap.ts) con los
 * ganchos data-g-*; sin `gsap`, las entradas de todo el sitio (data-reveal).
 * El cambio de logro activo no depende de GSAP: va en el guion de abajo.
 */
interface Bono {
  clases: number;
  precio: number;
  vence: string;
  nota?: string;
}

/**
 * Un logro: lo que se consigue y una frase que lo explica. El icono decide
 * la escena de la tarjeta; `escena` la cambia cuando el icono no basta (en el
 * DELF, "objetivo" es la hoja del examen y no los objetivos de viaje).
 */
interface Beneficio {
  icono: NombreIcono;
  titulo: string;
  texto: string;
  escena?: TipoEscena;
}

interface Props {
  /** Linea pequeña sobre el titular. */
  label?: string;
  titulo: string;
  /** La palabra del titular que va en italica roja, la marca del sitio. */
  acento?: string;
  intro: string;
  /** Tres datos cortos bajo el boton de la portada. Solo hechos. */
  garantias?: string[];
  /**
   * La imagen de la portada: una foto, o una ilustracion pasada en el slot
   * "apertura". Va siempre en tarjeta redondeada.
   */
  apertura: { alt: string; foto?: ImageMetadata };
  beneficios: { titulo: string; intro?: string; lista: Beneficio[] };
  pasos: { titulo: string; texto: string }[];
  precio: { valor: string; unidad: string; nota?: string };
  bonos?: { titulo: string; confirmado: boolean; lista: Bono[] };
  faq: Pregunta[];
  /** Con `chat`, el cierre lleva al lado la tarjeta de WhatsApp. */
  cierre: { titulo: string; texto: string; chat?: { boton: string; asunto: string } };
  /** Banda de palabras en frances bajo la portada. */
  vocabulario?: { palabras: { fr: string; es: string }[]; etiqueta: string };
  /** Ids de las opiniones que van primero en esta pagina (data/opiniones.ts). */
  opiniones?: string[];
  ctaHero?: string;
  ctaCierre?: string;
  /** Mensaje de WhatsApp de cada boton, a juego con lo que dice. */
  waHero?: string;
  waCierre?: string;
  breadcrumb: { name: string; path: string }[];
  /** Animacion con GSAP en vez de las entradas de siempre. */
  gsap?: boolean;
}

const {
  label,
  titulo,
  acento,
  intro,
  garantias,
  apertura,
  beneficios,
  pasos,
  precio,
  bonos,
  faq,
  cierre,
  vocabulario,
  opiniones = [],
  ctaHero = 'Agenda tu clase gratis',
  ctaCierre = 'Agenda tu clase gratis',
  waHero = WA.agendar,
  waCierre = WA.agendar,
  gsap = false,
} = Astro.props;

/**
 * Atributos segun el sistema de animacion. `siempre` da el valor solo sin
 * GSAP; `conGsap`, solo con GSAP. Un atributo undefined no se escribe.
 */
const siempre = (valor = '') => (gsap ? undefined : valor);
const conGsap = (valor = '') => (gsap ? valor : undefined);

const conCollage = Astro.slots.has('collage');
const numero = (i: number) => String(i + 1).padStart(2, '0');

const ESCENA_POR_ICONO: Partial<Record<NombreIcono, TipoEscena>> = {
  conversacion: 'charla',
  nivel: 'niveles',
  objetivo: 'metas',
  real: 'real',
  entender: 'explica',
  dinamico: 'dinamico',
  reloj: 'reloj',
};
const escenaDe = (b: Beneficio): TipoEscena => b.escena ?? ESCENA_POR_ICONO[b.icono] ?? 'charla';

/**
 * El mosaico va por filas de dos: ancha y estrecha, luego estrecha y ancha.
 * Si queda una sola al final, ocupa la fila entera.
 */
const totalLogros = beneficios.lista.length;
const forma = (i: number) =>
  totalLogros % 2 === 1 && i === totalLogros - 1 ? 'entera' : i % 4 === 0 || i % 4 === 3 ? 'ancha' : 'estrecha';
---

<!-- 1. PORTADA -->
<section class="overflow-hidden bg-blanc" data-gsap-pagina={conGsap()}>
  <div
    class:list={[
      'pad-shell-right grid items-center gap-12 pb-section pt-14 lg:gap-16',
      conCollage
        ? 'lg:grid-cols-[minmax(0,6fr)_minmax(0,7fr)]'
        : 'lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)]',
    ]}
    data-g-portada={conGsap()}
    data-g-oculto={conGsap()}
  >
    <div
      class="pad-shell-left order-2 lg:order-1 lg:pl-0"
      data-reveal={siempre('fade')}
      data-g={conCollage ? undefined : conGsap('foto')}
    >
      {
        conCollage ? (
          <slot name="collage" />
        ) : apertura.foto ? (
          <figure class="foto-tarjeta mx-auto w-full max-w-[24rem]">
            <Picture
              src={apertura.foto}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[400, 600, 800]}
              sizes="(min-width: 64rem) 24rem, 86vw"
              alt={apertura.alt}
              loading="eager"
              class="foto-tarjeta__img"
            />
          </figure>
        ) : (
          /* La ilustracion de la pagina, en tarjeta. Antes iba recortada en la
             forma de ojo, y Miguel la vio fea. */
          <div class="visual-tarjeta mx-auto w-full max-w-[24rem]" role="img" aria-label={apertura.alt}>
            <slot name="apertura" />
          </div>
        )
      }
    </div>

    <div class="pad-shell-left order-1 lg:order-2 lg:pl-0">
      {
        label && (
          <p class="label mb-5 text-lie" data-reveal={siempre()} data-g={conGsap('entrada')}>
            {label}
          </p>
        )
      }
      <h1
        class="portada__titulo"
        data-palabras={siempre()}
        data-repite={siempre()}
        data-g-titulo={conGsap('portada')}
      >
        {
          acento && titulo.includes(acento) ? (
            <>
              {titulo.slice(0, titulo.indexOf(acento))}
              <em class="destacado">{acento}</em>
              {titulo.slice(titulo.indexOf(acento) + acento.length)}
            </>
          ) : (
            titulo
          )
        }
      </h1>
      <p class="portada__intro measure mt-6" data-reveal={siempre()} data-g={conGsap('entrada')}>
        {intro}
      </p>
      <div class="mt-8" data-reveal={siempre()} data-g={conGsap('entrada')}>
        <Cta href={whatsapp(waHero)}>{ctaHero}</Cta>
      </div>
      {
        garantias && (
          <ul class="garantias mt-7" data-reveal={siempre()} data-g-garantias={conGsap()}>
            {garantias.map((garantia) => (
              <li>
                <Fragment set:html={icono('check')} />
                <span>{garantia}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

{vocabulario && <Vocabulario palabras={vocabulario.palabras} etiqueta={vocabulario.etiqueta} />}

<!-- 2. LO QUE VAS A CONSEGUIR -->
<section class="fondo-calido" aria-labelledby="beneficios">
  <div class="shell py-section-sm">
    <div class="logros__cabecera">
      <h2
        id="beneficios"
        class="titulo-seccion text-encre"
        data-reveal={siempre()}
        data-g-titulo={conGsap('seccion')}
      >
        {beneficios.titulo}
      </h2>
      {
        beneficios.intro && (
          <p class="logros__intro" data-reveal={siempre()} data-g={conGsap('entrada')}>
            {beneficios.intro}
          </p>
        )
      }
    </div>

    <ol class="mosaico">
      {
        beneficios.lista.map((b, i) => (
          <li
            class:list={['logro', `logro--${forma(i)}`]}
            data-logro
            data-reveal={siempre()}
            data-g-logro={conGsap()}
          >
            <article class="logro__tarjeta">
              <div class:list={['logro__escena', i % 2 === 0 ? 'logro__escena--fria' : 'logro__escena--calida']}>
                <EscenaLogro tipo={escenaDe(b)} />
              </div>
              <div class="logro__cuerpo">
                <span class="logro__num" aria-hidden="true">
                  {numero(i)}
                </span>
                <h3 class="logro__titulo">{b.titulo}</h3>
                <p class="logro__texto">{b.texto}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- 3. COMO EMPEZAMOS -->
<Metodo titulo="Cómo empezamos" pasos={pasos} fondo="bg-blanc" motor={gsap ? 'gsap' : 'motion'} />

<!-- 4. PRECIO Y BONOS -->
<section class="surface-dark relative overflow-hidden" data-blink="closed" aria-labelledby="precio">
  <div class:list={['shell relative z-10 precio py-section-sm', { 'precio--con-bonos': bonos }]}>
    <h2 id="precio" class="sr-only">Precio y bonos</h2>

    <div class="precio__principal" data-reveal={siempre()} data-g={conGsap('entrada')}>
      <p class="label text-ciel">Precio</p>
      <p class="mt-5">
        <span class="numerals block text-display-xl text-blanc" data-g-cifra={conGsap()}>
          {precio.valor}
        </span>
        <span class="mt-2 block text-body text-ciel">{precio.unidad}</span>
      </p>
      {precio.nota && <p class="precio__nota">{precio.nota}</p>}
    </div>

    {
      bonos && (
        <div class="precio__bonos" data-reveal={siempre()} data-g={conGsap('entrada')}>
          <h3 class="text-display-m text-blanc">{bonos.titulo}</h3>
          <ul class="precio__lista">
            {bonos.lista.map((bono) => (
              <li class="precio__fila" data-g-fila={conGsap()}>
                <div>
                  <p class="precio__clases">
                    {bono.clases} clases{bono.nota ? ` ${bono.nota}` : ''}
                  </p>
                  <p class="precio__vence">Vence en {bono.vence}</p>
                </div>
                <p class="numerals precio__importe">{bono.precio} €</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <span class="blink-lid blink-lid--top" aria-hidden="true"></span>
  <span class="blink-lid blink-lid--bottom" aria-hidden="true"></span>
</section>

<!-- OPINIONES: justo antes de las preguntas, como pide Miguel. En calido:
     viene detras de la banda oscura del precio. -->
<Opiniones primero={opiniones} fondo="calido" boton={{ texto: ctaHero, href: whatsapp(waHero) }} />

<!-- 5. PREGUNTAS FRECUENTES -->
<Faq preguntas={faq} id="preguntas" />

<!-- 6. CIERRE -->
<section class="fondo-calido" aria-labelledby="cierre">
  {
    cierre.chat ? (
      /* Partido, como el cierre de talleres: el titular a un lado y la
         tarjeta de WhatsApp al otro, con su boton. */
      <div class="shell grid items-center gap-10 py-section-sm lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
        <div>
          <p class="label text-lie" data-reveal={siempre()} data-g={conGsap('entrada')}>
            Hablemos
          </p>
          <h2
            id="cierre"
            class="titulo-seccion mt-4 max-w-[16ch] text-encre"
            data-reveal={siempre()}
            data-g-titulo={conGsap('seccion')}
          >
            {cierre.titulo}
          </h2>
          <p class="cierre__texto cierre__texto--partido mt-5" data-reveal={siempre()} data-g={conGsap('entrada')}>
            {cierre.texto}
          </p>
        </div>
        <ChatWhatsapp mensaje={waCierre} boton={cierre.chat.boton} asunto={cierre.chat.asunto} />
      </div>
    ) : (
      <div class="shell flex flex-col items-center py-section-sm text-center">
        <h2
          id="cierre"
          class="titulo-seccion max-w-[20ch] text-encre"
          data-reveal={siempre()}
          data-g-titulo={conGsap('seccion')}
        >
          {cierre.titulo}
        </h2>
        <p class="cierre__texto measure mt-5" data-reveal={siempre()} data-g={conGsap('entrada')}>
          {cierre.texto}
        </p>
        <div class="mt-8" data-reveal={siempre()} data-g={conGsap('entrada')}>
          <Cta href={whatsapp(waCierre)}>{ctaCierre}</Cta>
        </div>
      </div>
    )
  }
</section>

<script>
  // GSAP, solo si la pagina lo pidio (import dinamico dentro).
  import '../scripts/clases-gsap';

  /**
   * Las escenas de los logros solo se mueven mientras su tarjeta se ve: el
   * bucle se pone con [data-vivo] al entrar y se quita al salir, y entonces
   * la escena vuelve a su reposo, completa y quieta. Con movimiento reducido
   * no se pone nunca.
   */
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-logro]');
  if (tarjetas.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          const tarjeta = e.target as HTMLElement;
          if (e.isIntersecting) tarjeta.dataset.vivo = 'true';
          else delete tarjeta.dataset.vivo;
        }),
      { threshold: 0.3 },
    );
    tarjetas.forEach((t) => io.observe(t));
  }
</script>

<style>
  /* --- Animacion con GSAP --- */
  :global(.js) [data-g-oculto] {
    visibility: hidden;
  }

  /* Lo que mueve GSAP no lleva ademas una transicion de CSS en transform. */
  [data-g],
  [data-g-fila] {
    transition: none;
  }

  :global(.g-linea-mask) {
    padding-top: 0.12em;
    margin-top: -0.12em;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  :global(main:has([data-gsap-pagina])) {
    overflow-x: clip;
  }

  /* --- 1. Portada --- */

  /* Mismo titular que el inicio: 650 de peso, no 500. Con 500 las paginas
     interiores parecian de otra web. */
  .portada__titulo {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.5rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--color-encre);
    max-width: 16ch;
  }

  .portada__intro {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-nuit);
  }

  .garantias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
  }

  .garantias li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-body-s);
    font-weight: 500;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-encre) 80%, transparent);
  }

  .garantias :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-grenat);
  }

  .foto-tarjeta {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 22px;
    background-color: var(--color-papier);
    box-shadow: var(--shadow-alta);
    transform: rotate(-2deg);
    transition: transform 520ms var(--ease-fluid);
  }

  .foto-tarjeta :global(picture) {
    display: block;
    height: 100%;
  }

  .foto-tarjeta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  /* La ilustracion, en una tarjeta redondeada un poco girada, como la foto. */
  .visual-tarjeta {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 26px;
    box-shadow: var(--shadow-alta);
    transform: rotate(-2deg);
    transition: transform 520ms var(--ease-fluid);
  }

  /* Las ilustraciones venian pensadas para el ojo, con mucho margen lateral.
     En la tarjeta respiran menos. */
  .visual-tarjeta :global(.charla),
  .visual-tarjeta :global(.delf) {
    padding: 2rem 1.75rem;
  }

  /* Y todo un punto mas grande, para que la ilustracion llene la tarjeta. */
  .visual-tarjeta :global(.delf) {
    gap: 1.5rem;
  }

  .visual-tarjeta :global(.delf__lista) {
    gap: 1.2rem;
  }

  .visual-tarjeta :global(.delf__nombre),
  .visual-tarjeta :global(.delf__puntos) {
    font-size: 1.0625rem;
  }

  .visual-tarjeta :global(.delf__barra) {
    height: 0.55rem;
  }

  .visual-tarjeta :global(.delf__pie) {
    font-size: 0.9375rem;
  }

  .visual-tarjeta :global(.charla) {
    gap: 1.2rem;
  }

  .visual-tarjeta :global(.charla__lista) {
    gap: 0.8rem;
  }

  .visual-tarjeta :global(.burbuja__texto) {
    padding: 0.65rem 1rem;
    font-size: 1.0625rem;
  }

  .visual-tarjeta :global(.burbuja__punto) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .visual-tarjeta :global(.charla__etiqueta) {
    font-size: 0.8125rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .foto-tarjeta:hover,
    .visual-tarjeta:hover {
      transform: rotate(0deg) translateY(-6px);
    }
  }

  /* --- 2. Lo que vas a conseguir --- */

  .logros__cabecera {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
  }

  @media (width >= 64rem) {
    .logros__cabecera {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: 4rem;
      align-items: end;
      margin-bottom: 3rem;
    }
  }

  .logros__intro {
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.625rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-nuit);
  }

  @media (width >= 64rem) {
    .logros__intro {
      justify-self: end;
      padding-bottom: 0.35rem;
    }
  }

  /* --- El mosaico ---
     Una columna en movil, dos en tableta y, en escritorio, tres columnas
     donde cada fila junta una tarjeta ancha (dos columnas) y una estrecha,
     alternando el lado. Nunca tres iguales en fila. */
  .mosaico {
    display: grid;
    gap: 1rem;
  }

  @media (width >= 48rem) {
    .mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (width >= 64rem) {
    .mosaico {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .logro--ancha {
      grid-column: span 2;
    }

    .logro--entera {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 48rem) and (width < 64rem) {
    .logro--entera {
      grid-column: 1 / -1;
    }
  }

  /* La tarjeta: blanca, con un filo de piedra y la sombra de reposo. Al pasar
     por encima sube un poco. GSAP mueve el li, no la tarjeta: asi la
     transicion de CSS no choca con la entrada. */
  .logro__tarjeta {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    padding: 0.55rem;
    border-radius: 28px;
    background-color: var(--color-blanc);
    box-shadow:
      var(--shadow-flota),
      inset 0 0 0 1px color-mix(in srgb, var(--color-pierre) 85%, transparent);
    transition:
      transform 520ms var(--ease-fluid),
      box-shadow 520ms var(--ease-fluid);
  }

  @media (hover: hover) and (pointer: fine) {
    .logro__tarjeta:hover {
      transform: translateY(-6px);
      box-shadow:
        var(--shadow-alta),
        inset 0 0 0 1px color-mix(in srgb, var(--color-pierre) 85%, transparent);
    }
  }

  /* El hueco de la escena: un tono de la marca con una trama de puntos muy
     suave, como un papel cuadriculado. Frio y calido se alternan. */
