---
/**
 * Definicion unica de la mascara de apertura.
 * Se incluye una sola vez por documento, desde BaseLayout.
 *
 * La forma es una almendra (dos arcos que se encuentran en punta), la misma
 * geometria del ojo del logo. Va en unidades objectBoundingBox para que se
 * adapte sola a la proporcion del contenedor: en un 4:5 da una lente vertical,
 * en un 16:9 da un ojo ancho. No hay que recalcular nada por tamano.
 */
---

<svg
  class="absolute h-0 w-0 overflow-hidden"
  aria-hidden="true"
  focusable="false"
  width="0"
  height="0"
>
  <defs>
    <clipPath id="aperture-clip" clipPathUnits="objectBoundingBox">
      <path
        d="M0,0.5 C0.16,0.12 0.33,0 0.5,0 C0.67,0 0.84,0.12 1,0.5 C0.84,0.88 0.67,1 0.5,1 C0.33,1 0.16,0.88 0,0.5 Z"
      ></path>
    </clipPath>
  </defs>
</svg>
