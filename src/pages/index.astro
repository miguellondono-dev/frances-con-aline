---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Vocabulario from '../components/home/Thesis.astro';
import Formats from '../components/home/Formats.astro';
import Method from '../components/home/Method.astro';
import LevelTest from '../components/home/LevelTest.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Faq from '../components/Faq.astro';
import Opiniones from '../components/Opiniones.astro';
import { FAQ_HOME, faqSchema } from '../data/faq';
import { SITE_NAME, CTA_AGENDA } from '../data/site';
import { marca } from '../lib/schema';

const site = Astro.site?.href ?? 'https://PENDIENTE-DOMINIO.example/';

/**
 * Datos estructurados del home.
 *
 * No se usa LocalBusiness: no hay local fisico.
 * No se usa Review ni AggregateRating: todavia no hay resenas, e inventarlas
 * es penalizable.
 * TODO SearchAction: se anade a WebSite cuando exista una busqueda real.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: site,
    inLanguage: 'es',
    // Antes apuntaba a /quien-soy#aline, una pagina que no existe. La web la
    // publica la marca, que ya se declara abajo con este mismo @id.
    publisher: { '@id': marca(Astro.site)['@id'] },
  },
  marca(Astro.site),
  faqSchema(FAQ_HOME),
];
---

<BaseLayout
  title="Clases de francés online a tu medida"
  description="Clases de francés online para hispanohablantes, con una profesora nativa. Desde cualquier nivel, a tu ritmo y con mucha práctica. Primera clase gratis."
  path="/"
  schema={schema}
>
  <Hero />
  <Vocabulario />
  <Formats />
  <Method />
  <LevelTest />
  {/* Justo antes de las preguntas, como pide Miguel. En azul, para que
      contraste entre el calido del test y el blanco de las preguntas. */}
  <Opiniones
    primero={['alvaro', 'mario', 'giorgio', 'blanca']}
    fondo="oscuro"
    boton={{ texto: 'Agenda tu clase gratis', href: CTA_AGENDA.href }}
  />
  <Faq preguntas={FAQ_HOME} id="preguntas" />
  <FinalCta />
</BaseLayout>
