---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';
import ConversacionGrupo from '../components/graficos/ConversacionGrupo.astro';
import { FAQ_GRUPO } from '../data/faq-servicios';
import { faqSchema } from '../data/faq';
import { BONOS, CTA, WA } from '../data/site';
import { breadcrumb, service } from '../lib/schema';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Clases en grupo', path: '/clases-en-grupo' },
];

const schema = [
  service({
    name: 'Clases de francés en grupo en línea',
    description:
      'Clases de francés en línea en grupos abiertos de dos a cinco personas. Te apuntas por tu cuenta y Aline forma el grupo por nivel.',
    path: '/clases-en-grupo',
    precio: 20,
    unidad: '20 € la hora por persona',
    site: Astro.site,
  }),
  breadcrumb(migas, Astro.site),
  faqSchema(FAQ_GRUPO),
];
---

<BaseLayout
  title="Clases en grupo"
  description="Clases de francés en grupo de dos a cinco personas, a 20 € la hora. Te apuntas por tu cuenta y yo formo el grupo por nivel. Primera clase gratis."
  path="/clases-en-grupo"
  schema={schema}
>
  <ServiceLanding
    gsap
    titulo="Practica con más voces"
    acento="voces"
    intro="Clases de francés en línea, en grupos de 2 a 5 personas de tu nivel. Hablas más, pierdes la vergüenza y pagas menos por hora."
    garantias={['De 2 a 5 personas', 'Grupos por nivel', 'Primera clase gratis']}
    apertura={{
      alt: 'Conversación en francés entre alumnos de un grupo, con una corrección en el momento',
    }}
    beneficios={{
      titulo: 'Lo que vas a conseguir',
      intro: 'Más práctica, más voces y menos precio por hora.',
      lista: [
        {
          icono: 'conversacion',
          titulo: 'Hablar mucho más',
          texto: 'Buena parte de la clase son diálogos entre ustedes, y te corrijo en el momento.',
        },
        {
          icono: 'nivel',
          titulo: 'Un grupo a tu nivel',
          texto: 'Te escucho en la clase gratis y te coloco con gente que está donde estás tú.',
        },
        {
          icono: 'entender',
          titulo: 'Aprender también de los demás',
          texto: 'Se aprende tanto oyendo cómo corrijo a otra persona como cuando te corrijo a ti.',
        },
        {
          icono: 'dinamico',
          titulo: 'Clases que no se hacen largas',
          texto: 'Preparo el material y reparto los turnos: a nadie le toca escuchar la hora entera.',
        },
      ],
    }}
    pasos={[
      {
        titulo: 'La clase gratis',
        texto:
          'Media hora conmigo, tú solo, para escucharte y saber con qué grupo encajas.',
      },
      {
        titulo: 'Te busco grupo',
        texto:
          'Te coloco con gente de tu nivel y arrancamos en cuanto seamos al menos dos.',
      },
      {
        titulo: 'Las clases',
        texto:
          'Una hora por semana o dos, siempre a la misma hora, a 20 € por persona.',
      },
    ]}
    precio={{
      valor: '20 €',
      unidad: 'la hora, por persona',
      nota: 'Cada persona paga 20 €, no 20 € entre todos. Mínimo dos, máximo cinco.',
    }}
    bonos={{
      titulo: 'Bono en grupo',
      confirmado: BONOS.confirmado,
      lista: BONOS.grupo,
    }}
    faq={FAQ_GRUPO}
    cierre={{
      titulo: 'Apúntate y yo me encargo del grupo',
      texto:
        'Media hora conmigo para escucharte, y de ahí sale con qué gente vas a aprender mejor.',
    }}
    breadcrumb={migas}
    ctaHero={CTA.heroGrupo}
    ctaCierre={CTA.cierreGrupo}
    waHero={WA.grupo}
    waCierre={WA.grupo}
  >
    <ConversacionGrupo slot="apertura" />
  </ServiceLanding>
</BaseLayout>
