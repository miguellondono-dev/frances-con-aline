---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Logo from '../components/Logo.astro';
import { breadcrumb } from '../lib/schema';
import { CORREO_CONTACTO, WA, whatsapp } from '../data/site';
import { PREGUNTAS, BLOQUES, NIVELES, OBJETIVOS } from '../data/test-nivel';
import { icono } from '../data/iconos';

/**
 * TEST DE NIVEL.
 *
 * Rediseño de septiembre de 2026, a peticion de Miguel: que motive a hacerlo
 * y que al final entregue algo de verdad. Cuatro pantallas:
 *
 *  1. Portada: lo que se gana haciendolo y una escalera de niveles animada.
 *  2. El test: una pregunta por pantalla, en un orden distinto cada vez. La
 *     barra tiene un tramo por pregunta y no dice de que nivel es ninguna,
 *     para que nadie sepa por donde va ni pueda hacer trampa.
 *  3. Antes del resultado: nombre y objetivo. Sirven para personalizarlo.
 *  4. El resultado: nivel estimado, lo que ya sabe hacer, fortalezas, donde
 *     mejorar con un consejo para cada cosa, aciertos por nivel y el boton
 *     para pedir la clase gratis. Ese boton manda a Aline por WhatsApp todo
 *     el resultado y los tres textos.
 *
 * Los enunciados no se imprimen aqui: los pinta el guion uno a uno. Sin
 * JavaScript se dice y se da el correo.
 */
const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Test de nivel', path: '/test-de-nivel' },
];

const schema = [breadcrumb(migas, Astro.site)];

const VENTAJAS = [
  { icono: 'reloj' as const, texto: 'Entre 10 y 15 minutos' },
  { icono: 'nivel' as const, texto: `${PREGUNTAS.length} preguntas, de A1 a C1` },
  { icono: 'objetivo' as const, texto: 'Tus fortalezas y en qué mejorar' },
  { icono: 'regalo' as const, texto: 'Gratis y sin registrarte' },
];

/** Altura de cada peldaño de la escalera, en porcentaje. */
const PELDANOS = BLOQUES.map((b, i) => ({ nivel: b, etiqueta: NIVELES[b].etiqueta, alto: 22 + i * 16 }));
---

<BaseLayout
  title="Test de nivel de francés gratis"
  description="Veinticinco preguntas y unos diez minutos para saber tu nivel de francés, de A1 a C1. Al terminar ves tus fortalezas y en qué mejorar. Gratis."
  path="/test-de-nivel"
  schema={schema}
>
  <section class="test-pagina">
    <div class="shell pb-section pt-8">
      <!-- 1. PORTADA -->
      <div class="intro" data-test-intro>
        <div class="intro__texto">
          <h1 class="intro__titulo" data-palabras>
            Descubre tu nivel de francés en <em class="destacado">diez minutos</em>
          </h1>
          <p class="intro__apoyo" data-reveal>
            Gramática, lectura, escucha y escritura. Al terminar ves tu nivel, lo que
            ya dominas y en qué te conviene mejorar.
          </p>

          <ul class="ventajas">
            {
              VENTAJAS.map((v, i) => (
                <li class="ventaja" style={`--i: ${i}`}>
                  <span class="ventaja__icono" set:html={icono(v.icono)} />
                  {v.texto}
                </li>
              ))
            }
          </ul>

          <div class="intro__accion">
            <button class="test-boton test-boton--grande" type="button" data-test-empezar>
              Empezar el test
              <svg viewBox="0 0 24 16" class="h-3.5 w-5" fill="none" aria-hidden="true">
                <path d="M0 8h22M15 1l7 7-7 7" stroke="currentColor" stroke-width="1.8" />
              </svg>
            </button>
          </div>

          <noscript>
            <p class="intro__noscript">
              El test necesita JavaScript para funcionar. Si no puedes activarlo,
              escríbeme a <a href={`mailto:${CORREO_CONTACTO}`}>{CORREO_CONTACTO}</a>
              y lo vemos en una sesión.
            </p>
          </noscript>
        </div>

        {/* La escalera: cinco niveles y alguien que va subiendo. */}
        <div class="escalera" aria-hidden="true">
          {
            PELDANOS.map((p, i) => (
              <div class="peldano" style={`--alto: ${p.alto}%; --i: ${i}`}>
                <span class="peldano__nivel">{p.nivel}</span>
                <span class="peldano__etiqueta">{p.etiqueta}</span>
              </div>
            ))
          }
          <span class="escalera__marcador">
            <span class="escalera__ojo"><Logo viewBox="195 258 860 691" /></span>
            <span class="escalera__tu">Tú</span>
          </span>
        </div>
      </div>

      <!-- 2. EL TEST -->
      <div class="prueba" data-test hidden>
        <div class="prueba__cabecera">
          <div class="prueba__fila">
            <span class="chip" data-test-chip>Pregunta 1 de {PREGUNTAS.length}</span>
            <span class="prueba__cuenta" data-test-cuenta></span>
          </div>
          <div
            class="segmentos"
            style={`--n: ${PREGUNTAS.length}`}
            data-test-barra
            role="progressbar"
            aria-label="Progreso del test"
            aria-valuemin="1"
            aria-valuemax={PREGUNTAS.length}
          >
            {PREGUNTAS.map(() => <span class="segmento" data-test-segmento />)}
          </div>
          <p class="hito" data-test-hito aria-live="polite"></p>
        </div>

        <div class="prueba__zona" data-test-zona tabindex="-1"></div>

        <div class="prueba__pasos">
          <button class="test-boton test-boton--suave" type="button" data-test-atras>
            Atrás
          </button>
          <button class="test-boton" type="button" data-test-seguir>Siguiente</button>
        </div>
      </div>

      <!-- 3. ANTES DEL RESULTADO -->
      <div class="datos" data-test-datos hidden>
        <span class="datos__sello" set:html={icono('check')} />
        <h2 class="datos__titulo" tabindex="-1">Tu resultado está listo</h2>
        <p class="datos__apoyo">Dos datos y te lo enseño, pensado para ti.</p>

        <label class="datos__campo">
          <span class="datos__etiqueta">¿Cómo te llamas?</span>
          <input
            class="datos__caja"
            type="text"
            autocomplete="given-name"
            maxlength="40"
            data-test-nombre
          />
        </label>

        <fieldset class="datos__objetivos">
          <legend class="datos__etiqueta">¿Para qué quieres el francés?</legend>
          <div class="datos__chips">
            {
              OBJETIVOS.map((o) => (
                <button type="button" class="objetivo" aria-pressed="false" data-test-objetivo={o}>
                  {o}
                </button>
              ))
            }
          </div>
        </fieldset>

        <button class="test-boton test-boton--grande datos__ver" type="button" data-test-ver disabled>
          Ver mi resultado
        </button>
      </div>

      <!-- 4. EL RESULTADO -->
      <div class="resultado" data-test-resultado hidden>
        <div class="r-cabeza">
          <p class="r-cabeza__saludo" data-r-saludo>Tu resultado</p>
          <div class="r-cabeza__reparto">
            <div>
              <p class="r-cabeza__pre">Tu nivel estimado</p>
              <h2 class="r-cabeza__nivel" tabindex="-1" data-r-nivel>A1</h2>
              <p class="r-cabeza__etiqueta" data-r-etiqueta></p>
            </div>
            <p class="r-cabeza__puedes" data-r-puedes></p>
          </div>
          <ol class="escala" aria-hidden="true">
            {
              BLOQUES.map((b) => (
                <li class="escala__paso" data-r-escala={b}>
                  <span class="escala__barra">
                    <span class="escala__relleno" />
                  </span>
                  <span class="escala__nombre">{b}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="r-cuerpo">
          <div class="r-tarjeta r-tarjeta--bien">
            <h3 class="r-tarjeta__titulo">
              <span class="r-tarjeta__icono" set:html={icono('check')} />
              Tus fortalezas
            </h3>
            <ul class="r-lista" data-r-fortalezas></ul>
          </div>
          <div class="r-tarjeta r-tarjeta--mejorar">
            <h3 class="r-tarjeta__titulo">
              <span class="r-tarjeta__icono" set:html={icono('objetivo')} />
              Dónde mejorar
            </h3>
            <ul class="r-lista" data-r-mejorar></ul>
          </div>
        </div>

        <div class="r-tarjeta r-niveles">
          <h3 class="r-tarjeta__titulo">Aciertos por nivel</h3>
          <ul class="barras">
            {
              BLOQUES.map((b) => (
                <li class="barras__fila">
                  <span class="barras__nombre">{b}</span>
                  <span class="barras__pista">
                    <span class="barras__relleno" data-r-barra={b} />
                  </span>
                  <span class="barras__pct" data-r-pct={b}>0 %</span>
                </li>
              ))
            }
          </ul>
          <p class="r-niveles__nota">
            Tus tres textos escritos no entran aquí: los leo yo y con ellos te confirmo
            el nivel.
          </p>
        </div>

        <div class="r-cta">
          <h3 class="r-cta__titulo" data-r-cta-titulo>Da el siguiente paso</h3>
          <p class="r-cta__texto">
            En tu clase gratis repasamos juntos tu resultado, leo tus textos y salimos
            con un plan para mejorar justo en lo que te falta.
          </p>
          <div class="r-cta__acciones">
            <Cta href={whatsapp(WA.agendar)} data-r-cta>Quiero mi clase gratis</Cta>
            <button type="button" class="r-cta__repetir" data-r-repetir>Repetir el test</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .test-pagina {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 44%, var(--color-blanc)) 24%,
      color-mix(in srgb, var(--color-papier) 60%, var(--color-blanc)) 58%,
      color-mix(in srgb, var(--color-papier) 32%, var(--color-blanc)) 86%,
      var(--color-blanc) 100%
    );
  }

  .prueba,
  .datos,
  .resultado {
    scroll-margin-top: 6.5rem;
  }

  /* --- 1. Portada --- */

  .intro {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (width >= 64rem) {
    .intro {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
      min-height: min(40rem, calc(100svh - 7rem));
    }
  }

  .intro__titulo {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.4rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--color-encre);
  }

  .intro__apoyo {
    margin-top: 1.4rem;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-nuit);
  }

  .ventajas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 1.9rem;
    max-width: 36rem;
  }

  @media (width < 30rem) {
    .ventajas {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .ventaja {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.85rem;
    border-radius: 14px;
    background-color: color-mix(in srgb, var(--color-blanc) 80%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 7%, transparent);
    font-size: var(--text-body-s);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-encre);
  }

  .ventaja__icono {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background-color: color-mix(in srgb, var(--color-ciel) 40%, var(--color-blanc));
    color: var(--color-bleu);
  }

  .ventaja__icono :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .intro__accion {
    margin-top: 2rem;
  }

  .intro__noscript {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: var(--text-body-s);
    color: var(--color-lie);
  }

  /* La escalera de niveles. */
  .escalera {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: end;
    gap: 0.5rem;
    width: 100%;
    max-width: 30rem;
    height: clamp(17rem, 12rem + 12vw, 24rem);
    margin-inline: auto;
    /* El marcador se mueve en fracciones de la escalera (cqw, cqh). */
    container-type: size;
  }

  .peldano {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: var(--alto);
    padding: 0.7rem 0.4rem;
    border-radius: 14px 14px 6px 6px;
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-encre) 94%, var(--color-nuit)),
      var(--color-nuit)
    );
    color: var(--color-blanc);
    text-align: center;
    box-shadow: var(--shadow-flota);
    transform-origin: bottom center;
  }

  .peldano:nth-child(5) {
    background-image: linear-gradient(to top, var(--color-lie), var(--color-grenat));
  }

  .peldano__nivel {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .peldano__etiqueta {
    margin-top: 0.3rem;
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--color-ciel);
  }

  .peldano:nth-child(5) .peldano__etiqueta {
    color: var(--color-papier);
  }

  /* El marcador sube de peldaño en peldaño. Se mueve con translate en
     unidades de la escalera, y salta con transform: son dos propiedades
     distintas y no se pisan. */
  .escalera__marcador {
    position: absolute;
    left: calc(10% - 1.4rem);
    bottom: calc(22% + 0.6rem);
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    width: 2.8rem;
    pointer-events: none;
  }

  .escalera__ojo {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background-color: var(--color-blanc);
    color: var(--color-encre);
    box-shadow: var(--shadow-alta);
  }

  .escalera__ojo :global(svg) {
    width: 1.8rem;
    height: auto;
  }

  .escalera__tu {
    order: -1;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-grenat);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .peldano {
      animation: peldano-sube 700ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
      animation-delay: calc(200ms + var(--i) * 110ms);
    }

    :global(.js) .ventaja {
      animation: aparece 600ms var(--ease-smooth) backwards;
      animation-delay: calc(500ms + var(--i) * 90ms);
    }

    .escalera__marcador {
      animation:
        subir 7s cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite,
        salto 1.4s ease-in-out 1.2s infinite;
    }
  }

  @keyframes peldano-sube {
    from {
      opacity: 0;
      transform: scaleY(0.2);
    }
  }

  @keyframes aparece {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Cinco paradas, una por peldaño. Cada peldaño es un 20% del ancho y sube
     un 16% de alto respecto al anterior. */
  @keyframes subir {
    0%,
    12% {
      translate: 0 0;
    }
    20%,
    32% {
      translate: 20.4cqw -16cqh;
    }
    40%,
    52% {
      translate: 40.8cqw -32cqh;
    }
    60%,
    72% {
      translate: 61.2cqw -48cqh;
    }
    80%,
    92% {
      translate: 81.6cqw -64cqh;
    }
    100% {
      translate: 0 0;
    }
  }

  @keyframes salto {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* --- 2. El test --- */

  .prueba {
    max-width: 48rem;
    margin-inline: auto;
    border-radius: 26px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-alta);
    padding: clamp(1.4rem, 1rem + 2vw, 2.5rem);
  }

  .prueba__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .chip {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-encre);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .prueba__cuenta {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-body-s);
    font-weight: 600;
    color: color-mix(in srgb, var(--color-encre) 60%, transparent);
  }

  /* La barra: un tramo por pregunta, sin nombres de nivel. */
  .segmentos {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 3px;
    margin-top: 1rem;
  }

  .segmento {
    position: relative;
    height: 7px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-encre) 10%, transparent);
  }

  .segmento::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--color-grenat);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 480ms var(--ease-fluid);
  }

  .segmento[data-estado='hecho']::after {
    transform: scaleX(1);
  }

  /* La de ahora late, a medio color. */
  .segmento[data-estado='actual']::after {
    transform: scaleX(1);
    background-color: color-mix(in srgb, var(--color-grenat) 45%, transparent);
    animation: segmento-latido 1.4s ease-in-out infinite;
  }

  @keyframes segmento-latido {
    50% {
      opacity: 0.35;
    }
  }

  /* Los avisos de ritmo: al empezar, al cuarto, a la mitad y al final. */
  .hito {
    min-height: 0;
    margin-top: 0.75rem;
    font-size: var(--text-body-s);
    font-weight: 600;
    color: var(--color-lie);
  }

  .hito:empty {
    display: none;
  }

  .prueba__zona {
    margin-top: 1.75rem;
    min-height: 17rem;
    outline: none;
  }

  .prueba__pasos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-encre) 10%, transparent);
  }

  /* En movil los botones quedan pegados abajo: no hay que buscarlos tras una
     pregunta larga. */
  @media (width < 40rem) {
    .prueba__pasos {
      position: sticky;
      bottom: 0;
      margin-inline: -1.4rem;
      margin-bottom: -1.4rem;
      padding: 1rem 1.4rem;
      border-radius: 0 0 26px 26px;
      background-color: color-mix(in srgb, var(--color-blanc) 94%, transparent);
      backdrop-filter: blur(8px);
    }
  }

  /* --- Las preguntas (las pinta el guion) --- */

  :global(.test-pista) {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-lie);
  }

  :global(.test-enunciado) {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.55rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--color-encre);
    white-space: pre-line;
    text-wrap: pretty;
  }

  :global(.test-opciones) {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  :global(.test-opciones--fichas) {
    display: flex;
    flex-wrap: wrap;
  }

  :global(.test-opcion) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    border-radius: 16px;
    border: 1.5px solid color-mix(in srgb, var(--color-encre) 12%, transparent);
    background-color: var(--color-blanc);
    padding: 0.8rem 1rem;
    text-align: left;
    font-size: var(--text-body);
    line-height: 1.35;
    color: var(--color-encre);
    transition:
      border-color 200ms var(--ease-smooth),
      background-color 200ms var(--ease-smooth),
      box-shadow 200ms var(--ease-smooth);
  }

  :global(.test-opcion:hover) {
    border-color: color-mix(in srgb, var(--color-encre) 32%, transparent);
    box-shadow: var(--shadow-flota);
  }

  :global(.test-letra) {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background-color: color-mix(in srgb, var(--color-papier) 55%, var(--color-blanc));
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-encre);
    transition:
      background-color 200ms var(--ease-smooth),
      color 200ms var(--ease-smooth);
  }

  /* Elegida: relleno, borde y la letra en rojo. Nunca solo color. */
