---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';
import { FAQ_PRIVADAS } from '../data/faq-servicios';
import { faqSchema } from '../data/faq';
import { BONOS, CTA } from '../data/site';
import { breadcrumb, service } from '../lib/schema';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Clases privadas', path: '/clases-privadas' },
];

const schema = [
  service({
    name: 'Clases particulares de francés en línea',
    description:
      'Clases de francés individuales en línea, con plan hecho a partir del objetivo y la fecha de cada estudiante hispanohablante.',
    path: '/clases-privadas',
    precio: 35,
    unidad: '35 € la hora',
    site: Astro.site,
  }),
  breadcrumb(migas, Astro.site),
  faqSchema(FAQ_PRIVADAS),
];
---

<BaseLayout
  title="Clases particulares de francés en línea"
  description="Clases de francés una a una, en línea, con una profesora francesa que habla español. El plan sale de tu objetivo y tu fecha. Primera clase gratis."
  path="/clases-privadas"
  schema={schema}
>
  <ServiceLanding
    label="Clase individual · 35 € la hora"
    titulo="Una hora entera hablando tú"
    intro="En una clase privada no hay turno que esperar. La hora es tuya, el plan sale de para qué necesitas el francés y de cuándo lo necesitas, y los errores se corrigen en el momento en que aparecen."
    apertura={{
      alt: 'Aline dando clase frente a la pantalla',
      todo: 'Aline dando clase',
    }}
    paraQuienSi={[
      'Tienes una fecha encima: una mudanza, un traslado de trabajo, un trámite.',
      'Ya intentaste con una aplicación o con un grupo grande y te quedaste a medias.',
      'Necesitas vocabulario muy concreto de tu vida: tu oficio, tus trámites, tu barrio.',
      'Quieres que alguien te oiga hablar y te corrija la pronunciación desde el primer día.',
      'Tu horario se mueve y necesitas poder cambiar la clase sin perder el hilo.',
    ]}
    paraQuienNo={[
      'Buscas el precio más bajo por hora. Una aplicación o una plataforma de tutores te va a costar menos.',
      'Quieres un certificado oficial al terminar. Yo preparo y enseño, no expido títulos.',
      'Prefieres estudiar solo y a tu aire, sin que nadie te ponga tarea ni te la revise.',
      'Buscas clases para un niño. Trabajo con adultos.',
    ]}
    incluye={[
      {
        titulo: 'Un diagnóstico real antes de empezar',
        texto:
          'La primera media hora sirve para saber dónde estás de verdad. Te escucho hablar, veo qué reconoces y qué se te escapa, y te digo qué encontré antes de proponerte nada.',
      },
      {
        titulo: 'Un plan escrito con tu objetivo y tu fecha',
        texto:
          'Qué vamos a cubrir, en qué orden y por qué. Se ajusta cuando tu situación cambia, y tu situación cambia más de lo que crees.',
      },
      {
        titulo: 'Material cultural real, no un libro',
        texto:
          'Prensa, canciones, menús, formularios y escenas de película. Cosas que existen fuera del aula y que te vas a encontrar en la calle. Yo lo preparo y te lo mando antes de cada clase.',
      },
      {
        titulo: 'Tarea corta y revisada contigo',
        texto:
          'Poca y concreta. La clase siguiente empieza mirándola juntos: no te la devuelvo corregida, la corregimos, que es distinto y es donde de verdad se aprende.',
      },
      {
        titulo: 'Explicaciones en español cuando hacen falta',
        texto:
          'Aprendí español de adulta, viviendo en Latinoamérica. Cuando algo no entra, cambio de idioma, lo explico y volvemos al francés. No te dejo colgado en una explicación que no entiendes.',
      },
      {
        titulo: 'La misma profesora siempre',
        texto:
          'No rotamos. Sé en qué te trabaste el mes pasado y no tienes que volver a contar tu historia cada vez.',
      },
    ]}
    pasos={[
      {
        titulo: 'La clase gratis',
        texto:
          'Media hora en línea para escucharte y salir con una idea clara de tu nivel y de lo que necesitas.',
      },
      {
        titulo: 'El plan',
        texto:
          'Un plan con tu objetivo y tu fecha, y la frecuencia por semana que le corresponde.',
      },
      {
        titulo: 'Las clases',
        texto:
          'Una hora cada vez, siempre conmigo. Tarea corta entre clase y clase, y revisión conjunta al empezar la siguiente.',
      },
    ]}
    precio={{
      valor: '35 €',
      unidad: 'la hora, clase individual',
      nota: 'Todos los precios están en euros. El sitio no cobra nada: aquí solo se agenda.',
    }}
    bonos={{
      titulo: 'Bonos de varias clases',
      confirmado: BONOS.confirmado,
      lista: BONOS.privada,
    }}
    faq={FAQ_PRIVADAS}
    cierre={{
      titulo: 'Empecemos por media hora',
      texto:
        'Media hora en línea para escucharte y decidir juntos con qué frecuencia trabajar.',
    }}
    breadcrumb={migas}
    ctaHero={CTA.heroPrivadas}
    ctaCierre={CTA.cierrePrivadas}
  />
</BaseLayout>
