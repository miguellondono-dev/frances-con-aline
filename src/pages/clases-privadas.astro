---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';
import { FAQ_PRIVADAS } from '../data/faq-servicios';
import { faqSchema } from '../data/faq';
import { BONOS, CTA } from '../data/site';
import { breadcrumb, service } from '../lib/schema';
import alineClases from '../assets/aline-clases.jpeg';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Clases privadas', path: '/clases-privadas' },
];

const schema = [
  service({
    name: 'Clases particulares de francés en línea',
    description:
      'Clases de francés individuales en línea, a la medida del nivel, el objetivo y el ritmo de cada estudiante hispanohablante.',
    path: '/clases-privadas',
    precio: 35,
    unidad: '35 € la hora',
    site: Astro.site,
  }),
  breadcrumb(migas, Astro.site),
  faqSchema(FAQ_PRIVADAS),
];

/**
 * Copy reescrito en septiembre de 2026 a peticion de Miguel: centrado en lo
 * que la persona consigue (se adapta, cualquier nivel, clases dinamicas) y
 * sin "profesora francesa". Solo hechos que ya estaban en el sitio: hablar
 * desde la primera clase, correccion en el momento, plan con objetivo,
 * material real, explicaciones en español, mover la clase si cambia la
 * agenda, primera clase gratis.
 */
---

<BaseLayout
  title="Clases privadas"
  description="Clases de francés individuales en línea, a tu medida y para cualquier nivel. Clases dinámicas para que hables desde el primer día. Primera clase gratis."
  path="/clases-privadas"
  schema={schema}
>
  <ServiceLanding
    gsap
    titulo="Habla francés con confianza desde la primera clase"
    acento="confianza"
    intro="Clases individuales en línea que se adaptan a tu nivel, a tu objetivo y a tu ritmo. Da igual si empiezas desde cero o si ya te defiendes: cada clase es dinámica y está pensada para que hables más y con más soltura."
    garantias={['Para cualquier nivel', 'Clases dinámicas', 'Primera clase gratis']}
    apertura={{
      alt: 'Aline en Montmartre, frente al Sacré-Cœur',
      todo: 'Aline dando clase',
      // Provisional, hasta tener la foto de Aline dando clase.
      foto: alineClases,
    }}
    beneficios={{
      titulo: 'Lo que vas a conseguir',
      intro: 'Clases que se adaptan a ti, no al revés.',
      lista: [
        {
          icono: 'conversacion',
          titulo: 'Hablar desde el primer día',
          texto:
            'La hora es tuya: conversas, pruebas y corriges en el momento, sin esperar turno.',
        },
        {
          icono: 'nivel',
          titulo: 'Avanzar desde tu nivel',
          texto:
            'Desde cero o con base previa: vemos dónde estás y construimos a partir de ahí.',
        },
        {
          icono: 'objetivo',
          titulo: 'Llegar a tu objetivo',
          texto:
            'Viajar, trabajar, estudiar o un trámite: el plan apunta a lo que necesitas y se ajusta cuando cambia.',
        },
        {
          icono: 'real',
          titulo: 'Entender el francés real',
          texto:
            'Canciones, prensa, series y situaciones del día a día, junto con el libro.',
        },
        {
          icono: 'entender',
          titulo: 'Saber por qué se dice así',
          texto: 'Si algo no queda claro, te lo explico en español y seguimos en francés.',
        },
        {
          icono: 'dinamico',
          titulo: 'Aprender sin aburrirte',
          texto:
            'Clases dinámicas que cambian de actividad y de ritmo. Y si tu agenda se mueve, movemos la clase.',
        },
      ],
    }}
    pasos={[
      {
        titulo: 'Clase gratis',
        texto: 'Media hora en línea para conocerte y ver tu nivel. Sin compromiso.',
      },
      {
        titulo: 'Tu plan',
        texto: 'Te propongo un plan a tu medida: objetivo, ritmo y frecuencia.',
      },
      {
        titulo: 'A hablar',
        texto: 'Clases de una hora, dinámicas y siempre conmigo.',
      },
    ]}
    precio={{
      valor: '35 €',
      unidad: 'la hora',
      nota: 'Precios en euros. Desde aquí solo reservas: el pago lo acordamos directamente.',
    }}
    bonos={{
      titulo: 'Bonos de clases',
      confirmado: BONOS.confirmado,
      lista: BONOS.privada,
    }}
    faq={FAQ_PRIVADAS}
    cierre={{
      titulo: 'Empieza a hablar francés',
      texto:
        'Tu primera clase es gratis: media hora para conocerte, ver tu nivel y decidir juntos cómo seguir.',
    }}
    breadcrumb={migas}
    ctaHero={CTA.heroPrivadas}
    ctaCierre={CTA.cierrePrivadas}
  />
</BaseLayout>
