---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';
import PuntosDelf from '../components/graficos/PuntosDelf.astro';
import { FAQ_DELF } from '../data/faq-servicios';
import { faqSchema } from '../data/faq';
import { BONOS, CTA, WA } from '../data/site';
import { breadcrumb, service, course } from '../lib/schema';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Preparación DELF', path: '/preparacion-delf' },
];

const schema = [
  course({
    name: 'Preparación del DELF en línea',
    description:
      'Preparación del examen DELF con simulacros en el formato oficial. Preparo el examen y hago simulacros; no soy examinadora acreditada.',
    path: '/preparacion-delf',
    site: Astro.site,
  }),
  service({
    name: 'Preparación DELF en línea',
    description:
      'Preparación del DELF una a una o en grupo, con simulacros completos en el formato y los tiempos oficiales.',
    path: '/preparacion-delf',
    precio: 35,
    unidad: '35 € la hora',
    site: Astro.site,
  }),
  breadcrumb(migas, Astro.site),
  faqSchema(FAQ_DELF),
];
---

<BaseLayout
  title="Preparación del DELF"
  description="Preparo el DELF con simulacros en el formato oficial. Trabajamos las cuatro partes del examen y los tiempos reales. Primera clase gratis de 30 minutos."
  path="/preparacion-delf"
  schema={schema}
>
  <ServiceLanding
    gsap
    label="Preparación DELF · 35 € la hora"
    titulo="Prepara el DELF sin sorpresas"
    acento="sin sorpresas"
    intro="Simulacros con el formato y los tiempos oficiales, y un plan centrado en la parte que más te cuesta."
    garantias={['Simulacros reales', 'Las 4 partes del examen', 'Primera clase gratis']}
    apertura={{
      alt: 'Cómo se puntúa el DELF: cuatro partes de 25 puntos; se aprueba con 50 y al menos 5 en cada parte',
    }}
    beneficios={{
      titulo: 'Lo que vas a conseguir',
      intro: 'Llegar al examen sabiendo exactamente qué te van a pedir.',
      lista: [
        {
          icono: 'objetivo',
          titulo: 'Conocer el examen por dentro',
          texto: 'Simulacros completos, de una sentada, con el formato y los tiempos oficiales.',
        },
        {
          icono: 'nivel',
          titulo: 'Un plan para tu punto débil',
          texto: 'Medimos las cuatro partes por separado y el plan se centra en la que más te cuesta.',
        },
        {
          icono: 'reloj',
          titulo: 'Dominar el reloj',
          texto: 'La mayoría de los puntos se pierden por llegar tarde al final de la prueba. Eso se entrena.',
        },
        {
          icono: 'conversacion',
          titulo: 'Soltura en la prueba oral',
          texto: 'La ensayamos en voz alta con el formato real y la preparación cronometrada incluida.',
        },
      ],
    }}
    pasos={[
      {
        titulo: 'La clase gratis',
        texto: 'Media hora para medir por dónde andas y ver a qué nivel te conviene presentarte.',
      },
      {
        titulo: 'El calendario',
        texto: 'Un plan semana a semana hacia tu fecha de examen, con los simulacros ya colocados.',
      },
      {
        titulo: 'Preparación y simulacros',
        texto: 'Clases de una hora y simulacros completos en los momentos clave, revisados parte por parte.',
      },
    ]}
    precio={{
      valor: '35 €',
      unidad: 'la hora',
      nota: 'No cobro un extra por preparar el examen, y los bonos de varias clases también sirven para esto.',
    }}
    bonos={{
      titulo: 'Bonos, también para la preparación',
      confirmado: BONOS.confirmado,
      lista: BONOS.privada,
    }}
    faq={FAQ_DELF}
    cierre={{
      titulo: 'Primero medimos, después decidimos el nivel',
      texto:
        'Media hora en línea para medir las cuatro partes y ver a qué nivel te conviene presentarte.',
    }}
    breadcrumb={migas}
    ctaHero={CTA.heroDelf}
    ctaCierre={CTA.cierreDelf}
    waHero={WA.delf}
    waCierre={WA.delf}
  >
    <PuntosDelf slot="apertura" />
  </ServiceLanding>
</BaseLayout>
