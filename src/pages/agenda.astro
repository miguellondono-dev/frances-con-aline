---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import ChatWhatsapp from '../components/ChatWhatsapp.astro';
import { breadcrumb } from '../lib/schema';
import { PENDIENTE, SITE_NAME, WA } from '../data/site';
import { icono, type NombreIcono } from '../data/iconos';

/**
 * AGENDAR.
 *
 * A la izquierda, la ficha de la primera sesion: lo que alguien quiere saber
 * antes de bloquear media hora (cuanto dura, donde, que cuesta, en que
 * idioma) y que pasa en ella. A la derecha, como reservar.
 *
 * Mientras no exista la cuenta de Cal.com, se reserva por WhatsApp, con el
 * mismo mensaje que llevan todos los botones de agendar del sitio. Con el
 * calendario, su hueco lo ocupa el calendario.
 *
 * Rediseño de septiembre de 2026, a peticion de Miguel: la ficha era "muy
 * suave", sin animacion, y habia demasiado hueco entre el menu y las
 * tarjetas. Ahora la ficha lleva cabecera oscura, cuatro casillas con icono y
 * los pasos en una linea de tiempo que se dibuja, y todo entra animado. La
 * columna de la derecha empieza arriba: antes su contenido iba centrado en
 * vertical y la tarjeta se veia vacia al llegar.
 */
const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Agenda', path: '/agenda' },
];

const schema = [breadcrumb(migas, Astro.site)];

/** Lo que alguien quiere saber antes de bloquear media hora de su semana. */
const DATOS: { clave: string; valor: string; icono: NombreIcono }[] = [
  { clave: 'Duración', valor: '30 minutos', icono: 'reloj' },
  { clave: 'Dónde', valor: 'En línea, por videollamada', icono: 'video' },
  { clave: 'Precio', valor: 'Sin costo', icono: 'regalo' },
  { clave: 'Idioma', valor: 'Español y francés', icono: 'idiomas' },
];

/** Que pasa en esos treinta minutos. Tres lineas, no un parrafo. */
const QUE_PASA = [
  'Te escucho hablar un rato, sin corregirte.',
  'Te digo qué nivel veo y por qué.',
  'Salimos con un plan de por dónde empezar.',
];

const cal = PENDIENTE.calcom;
---

<BaseLayout
  title="Primera clase de francés gratis"
  description="Tu primera clase de francés online es gratis: media hora conmigo para escucharte y salir con un plan claro de por dónde empezar."
  path="/agenda"
  schema={schema}
>
  <section class="agenda">
    <div class="shell pb-section pt-8">
      <div class="agenda__reparto">
        {/* Contexto. En escritorio se queda fijo mientras se baja. */}
        <aside class="ficha">
          <div class="ficha__cabeza">
            <div class="ficha__marca">
              <span class="ficha__logo"><Logo viewBox="195 258 860 691" /></span>
              <span>{SITE_NAME}</span>
            </div>
            <h1 class="ficha__titulo" data-palabras data-repite>
              Tu <em class="destacado">primera</em> sesión
            </h1>
          </div>

          <ul class="ficha__datos">
            {
              DATOS.map((dato, i) => (
                <li class="dato" style={`--i: ${i}`}>
                  <span class="dato__icono" set:html={icono(dato.icono)} />
                  <span class="dato__clave">{dato.clave}</span>
                  <span class="dato__valor">{dato.valor}</span>
                </li>
              ))
            }
          </ul>

          <div class="ficha__pasos">
            <p class="ficha__etiqueta">En esos 30 minutos</p>
            <ol class="pasos">
              {
                QUE_PASA.map((linea, i) => (
                  <li class="paso" style={`--i: ${i}`}>
                    <span class="paso__num" aria-hidden="true">{i + 1}</span>
                    <span>{linea}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </aside>

        {/* Como reservar. Con Cal.com, el calendario; sin el, WhatsApp. */}
        <div class="reservar">
          {
            cal ? (
              <div class="calendario__caja" id="cal-embed" data-cal-embed data-cal-link={cal} />
            ) : (
              <>
                <p class="label text-lie" data-reveal>
                  Reserva en un mensaje
                </p>
                <h2 class="reservar__titulo" data-reveal>
                  Dime qué horario te viene bien
                </h2>
                <p class="reservar__texto" data-reveal>
                  Escríbeme por WhatsApp con dos o tres franjas que te sirvan y te
                  confirmo una.
                </p>
                <ChatWhatsapp
                  class="reservar__chat"
                  mensaje={WA.agendar}
                  boton="Reservar por WhatsApp"
                  asunto="Quiero agendar mi primera sesión"
                />
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

{
  cal && (
    <script is:inline define:vars={{ cal }}>
      /* Incrustado de Cal.com. El guion se pide una sola vez y se configura
         con la marca del sitio, para que el calendario no llegue con los
         colores de otra empresa. */
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              typeof namespace === 'string'
                ? (cal.ns[namespace] = api) && p(api, ar)
                : p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      Cal('init', { origin: 'https://cal.com' });

      Cal('inline', {
        elementOrSelector: '#cal-embed',
        calLink: cal,
        layout: 'month_view',
      });

      Cal('ui', {
        hideEventTypeDetails: true,
        layout: 'month_view',
        styles: { branding: { brandColor: '#CB1B16' } },
      });
    </script>
  )
}

<style>
  /* El mismo degradado calido que el resto de secciones nuevas. */
  .agenda {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 44%, var(--color-blanc)) 26%,
      color-mix(in srgb, var(--color-papier) 58%, var(--color-blanc)) 60%,
      color-mix(in srgb, var(--color-papier) 30%, var(--color-blanc)) 88%,
      var(--color-blanc) 100%
    );
  }

  .agenda__reparto {
    display: grid;
    gap: 2.5rem;
  }

  @media (width >= 64rem) {
    .agenda__reparto {
      grid-template-columns: minmax(0, 25rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  /* --- La ficha --- */

  .ficha {
    overflow: hidden;
    border-radius: 26px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-alta);
  }

  @media (width >= 64rem) {
    .ficha {
      position: sticky;
      top: 6.5rem;
    }
  }

  /* Cabecera oscura: le da a la ficha el peso que le faltaba. */
  .ficha__cabeza {
    padding: 1.75rem 1.75rem 1.9rem;
    background-image: linear-gradient(135deg, var(--color-nuit), var(--color-encre));
    color: var(--color-blanc);
  }

  .ficha__marca {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: var(--text-body-s);
    font-weight: 500;
    color: var(--color-ciel);
  }

  /* El svg de Logo llega sin el atributo de ambito: el tamaño va en el
     envoltorio y el svg lo hereda. */
  .ficha__logo {
    display: block;
    width: 1.6rem;
    color: var(--color-blanc);
  }

  .ficha__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ficha__titulo {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-blanc);
  }

  /* El rojo oscuro del sitio no se lee sobre tinta: aqui va en salmon. */
  .ficha__titulo :global(.destacado) {
    color: var(--color-chair);
  }

  /* Cuatro casillas con icono, en dos columnas. */
  .ficha__datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 1.25rem;
  }

  .dato {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem 0.95rem 1rem;
    border-radius: 16px;
    background-color: color-mix(in srgb, var(--color-papier) 38%, var(--color-blanc));
    transition:
      transform 320ms var(--ease-smooth),
      background-color 320ms var(--ease-smooth);
  }

  .dato__icono {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.45rem;
    border-radius: 12px;
    background-color: color-mix(in srgb, var(--color-ciel) 40%, var(--color-blanc));
    color: var(--color-bleu);
    transition: transform 320ms var(--ease-smooth);
  }

  .dato__icono :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .dato__clave {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-encre) 60%, transparent);
  }

  .dato__valor {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-encre);
  }

  @media (hover: hover) and (pointer: fine) {
    .dato:hover {
      transform: translateY(-3px);
      background-color: color-mix(in srgb, var(--color-papier) 60%, var(--color-blanc));
    }

    .dato:hover .dato__icono {
      transform: rotate(-8deg) scale(1.08);
    }
  }

  /* Los pasos: una linea de tiempo con numeros. */
  .ficha__pasos {
    padding: 0.4rem 1.75rem 1.9rem;
  }

  .ficha__etiqueta {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-lie);
  }

  .pasos {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  /* El carril que une los numeros. */
  .pasos::before {
    content: '';
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-grenat) 35%, transparent);
    transform-origin: top center;
  }

  .paso {
    position: relative;
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    font-size: var(--text-body-s);
    line-height: 1.4;
    color: var(--color-encre);
  }

  .paso__num {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: 0 0 0 4px var(--color-blanc);
    transition: transform 280ms var(--ease-smooth);
  }

  @media (hover: hover) and (pointer: fine) {
    .paso:hover .paso__num {
      transform: scale(1.15);
    }
  }

  /* --- Animaciones de entrada ---
     Solo con JS y sin movimiento reducido. Van con fill "backwards": al
     terminar, cada elemento vuelve a su estilo y los gestos al pasar por
     encima siguen funcionando. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ficha {
      animation: ficha-entra 800ms var(--ease-smooth) backwards;
    }

    :global(.js) .dato {
      animation: dato-entra 620ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
      animation-delay: calc(380ms + var(--i) * 110ms);
    }

    :global(.js) .dato__icono :global(svg) {
      animation: icono-flota 3.2s ease-in-out infinite;
      animation-delay: calc(var(--i) * -0.8s);
    }

    :global(.js) .pasos::before {
      animation: carril-crece 900ms var(--ease-smooth) 850ms backwards;
    }

    :global(.js) .paso {
      animation: paso-entra 560ms var(--ease-smooth) backwards;
      animation-delay: calc(950ms + var(--i) * 200ms);
    }

    :global(.js) .paso__num {
      animation: num-salta 520ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
      animation-delay: calc(1000ms + var(--i) * 200ms);
    }
  }

  @keyframes ficha-entra {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
  }

  @keyframes dato-entra {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.9);
    }
  }

  @keyframes icono-flota {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @keyframes carril-crece {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes paso-entra {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
  }

  @keyframes num-salta {
    from {
      transform: scale(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dato,
    .dato__icono,
    .paso__num {
      transition: none;
    }
  }

  /* --- Como reservar --- */

  .reservar__titulo {
    margin-top: 1rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--text-display-l);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-encre);
    text-wrap: balance;
  }

  .reservar__texto {
    margin-top: 1.1rem;
    max-width: 42ch;
    font-size: var(--text-body);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-encre) 72%, transparent);
  }

  /* La clase la pinta ChatWhatsapp: selector global. */
  :global(.reservar__chat) {
    margin-top: 2rem;
    max-width: 32rem;
  }

  .calendario__caja {
    min-height: 40rem;
    border-radius: 26px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-flota);
    overflow: hidden;
  }
</style>
