---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TallerLanding from '../../components/TallerLanding.astro';
import { breadcrumb, taller } from '../../lib/schema';
import { porSlug } from '../../data/talleres';

import lamina from '../../assets/talleres/acuarela-lamina.jpg';
import laminaLimon from '../../assets/talleres/acuarela-limon.jpg';
import laminaCerezas from '../../assets/talleres/acuarela-cerezas.jpg';
import laminaDonut from '../../assets/talleres/acuarela-donut.jpg';
import fotoAline from '../../assets/talleres/equipo-aline.webp';
import fotoSarah from '../../assets/talleres/equipo-sarah.webp';
import firmaMissS from '../../assets/talleres/miss-s-firma.png';
import logoMuisca from '../../assets/talleres/the-muisca-logo.png';

const t = porSlug('acuarela');

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
  { name: t.nombre, path: '/talleres/acuarela' },
];


const schema = [
  breadcrumb(migas, Astro.site),
  taller({
    name: 'Taller de acuarela en francés',
    description:
      'Primera edición del taller de francés y acuarela con la artista Miss S, en The Muisca Gallery (París): una hora de clase de francés sobre arte y una sesión de acuarela, con la pastelería francesa como tema. Desde nivel A2, con materiales, té y café incluidos.',
    path: '/talleres/acuarela',
    site: Astro.site,
    inicia: t.tanda?.iso.inicia,
    termina: t.tanda?.iso.termina,
    horario: t.tanda ? `Domingo de ${t.tanda.hora}` : 'Domingo',
    dia: t.diaSemana,
    sesiones: t.sesiones,
    minutosPorSesion: t.minutosPorSesion,
    precio: t.tanda?.precio,
    moneda: 'EUR',
    ciudad: t.ciudad,
    lugar: t.tanda?.lugar,
    pais: 'FR',
    cierreInscripcion: t.tanda?.iso.cierre,
  }),
];

const descripcion = t.tanda
  ? `Una hora de francés para hablar de arte y una sesión de acuarela con la artista Miss S, en The Muisca Gallery (París). ${t.tanda.cuando}, de ${t.tanda.hora}. ${t.tanda.precio} €, materiales incluidos.`
  : 'Un domingo pintando en acuarela y hablando en francés, en París, con tu lámina terminada. Las próximas fechas, muy pronto.';
---

<BaseLayout
  title="Taller de acuarela en francés en París"
  description={descripcion}
  path="/talleres/acuarela"
  schema={schema}
>
  <TallerLanding
    taller={t}
    portada={lamina}
    laminas={[
      { src: laminaCerezas, alt: 'Lámina de acuarela de un pastel rosa con cerezas, sostenida en la mano' },
      { src: laminaLimon, alt: 'Lámina de acuarela de una porción de tarta de limón con merengue' },
      { src: laminaDonut, alt: 'Lámina de acuarela de un dónut con glaseado rosa, sostenida en la mano' },
    ]}
    portadaAlt="Una mano sostiene una lámina de acuarela recién terminada sobre la mesa de trabajo"
    equipo={[
      {
        rol: 'Organizo y doy la clase',
        nombre: 'Aline Bart',
        texto:
          'Soy tutora de francés y mediadora cultural. En mis talleres uno el francés y la acuarela para que practicar el idioma sea una forma de expresarte, en un ambiente de confianza.',
        foto: fotoAline,
        alt: 'Retrato de Aline Bart',
        enlaces: [
          { href: '/sobre-mi', texto: 'Más sobre mí' },
          { href: 'https://www.instagram.com/francesconaline/', texto: '@francesconaline en Instagram' },
        ],
      },
      {
        rol: 'Artista invitada',
        nombre: 'Sarah, Miss S',
        texto:
          'Artista apasionada por la pintura y por crear espacios donde todos puedan aprender. Te guía en la acuarela a tu ritmo, sin presión por la perfección.',
        foto: fotoSarah,
        firma: firmaMissS,
        alt: 'Retrato de Sarah, Miss S',
        enlaces: [{ href: 'https://www.tiktok.com/@ittle.s', texto: '@ittle.s en TikTok' }],
      },
      {
        rol: 'Galería aliada',
        nombre: 'The Muisca Gallery',
        texto:
          'Galería de arte contemporáneo que conecta artistas de Europa, América Latina y otras regiones. Un espacio para aprender sobre arte e inspirarnos mientras pintamos.',
        logo: logoMuisca,
        alt: 'Logo de The Muisca Gallery',
        enlaces: [
          { href: 'https://www.themuisca.com/', texto: 'themuisca.com' },
          { href: 'https://www.instagram.com/themuisca/', texto: '@themuisca en Instagram' },
        ],
      },
    ]}
  />
</BaseLayout>
