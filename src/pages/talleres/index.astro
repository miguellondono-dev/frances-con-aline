---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumb } from '../../lib/schema';
import { TALLERES, hechos } from '../../data/talleres';

import teatroPortada from '../../assets/talleres/teatro-escena-ancha.jpg';
import acuarelaPortada from '../../assets/talleres/acuarela-lamina.jpg';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
];

const portadas: Record<string, ImageMetadata> = {
  teatro: teatroPortada,
  acuarela: acuarelaPortada,
};

const alt: Record<string, string> = {
  teatro:
    'Dos alumnas representan una escena sobre el escenario, con vestuario y luces de colores',
  acuarela:
    'Una mano sostiene una lámina de acuarela recién terminada sobre la mesa de trabajo',
};

/**
 * Aqui no va schema de cada taller: cada uno lo lleva en su pagina, que es su
 * URL canonica. Repetirlo en el indice le daria dos Course con la misma ficha
 * a un buscador y ninguno de los dos ganaria.
 *
 * La miga de pan sigue en el schema aunque ya no se pinte: es de ahi de donde
 * un buscador saca la ruta que enseña debajo del resultado. En pantalla
 * sobraba, porque la ultima miga decia "Talleres" justo encima de un titular
 * que dice "Talleres".
 */
const schema = [breadcrumb(migas, Astro.site)];
---

<BaseLayout
  title="Talleres de francés en París: teatro y acuarela"
  description="Dos talleres presenciales en París para usar el francés fuera del cuaderno. Teatro, cuatro sábados de octubre, 65 €. Acuarela, un domingo, 30 €."
  path="/talleres"
  schema={schema}
>
  <section class="cabecera">
    <div class="shell pt-12 pb-10">
      <p class="label mt-8 text-nuit" data-reveal>Presencial, en París</p>
      <h1 class="mt-5 max-w-[16ch] text-display-xl text-encre" data-reveal>
        Talleres
      </h1>
      <p class="measure mt-6 text-body text-nuit" data-reveal>
        Usar el francés con el cuerpo y con las manos, no con un cuaderno. Los
        dos son en octubre y los dos tienen plaza.
      </p>
    </div>
  </section>

  {/*
    La rejilla es el arreglo de fondo. Antes los talleres iban apilados uno
    detras de otro y habia que bajar por el primero entero para enterarse de
    que existia el segundo: no se podian ver juntos ni comparar. Ahora los dos
    caben en la misma pantalla y ensenan los mismos tres datos en el mismo
    orden, que es lo unico que hace comparable a dos productos.
  */}
  <section class="rejilla-zona" aria-labelledby="cartel">
    <div class="shell pb-section">
      <h2 id="cartel" class="sr-only">Los talleres de octubre</h2>

      <ul class="rejilla">
        {
          TALLERES.map((t) => (
            <li>
              <a class="ficha" href={`/talleres/${t.slug}`}>
                <span class="ficha__foto">
                  <Picture
                    src={portadas[t.slug]}
                    alt={alt[t.slug]}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[320, 480, 720]}
                    sizes="(min-width: 48rem) 21rem, 92vw"
                    class="ficha__img"
                    loading="eager"
                  />
                </span>

                <span class="ficha__cuerpo">
                  <span class="ficha__nombre">{t.nombre}</span>

                  {/* Cuando y hora, en el mismo orden que en la pagina del
                      taller. Quien llega desde aqui los busca donde ya los vio. */}
                  <span class="ficha__meta">
                    {t.cuando} · {t.hora}
                  </span>

                  <span class="ficha__precio">
                    <span class="ficha__cifra numerals">{t.precio} €</span>
                    <span class="ficha__unidad">
                      {t.sesiones > 1 ? `las ${t.sesiones} sesiones` : 'la sesión'}
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .cabecera {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 42%, var(--color-blanc)) 55%,
      color-mix(in srgb, var(--color-papier) 30%, var(--color-blanc)) 100%
    );
  }

  .rejilla-zona {
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-papier) 30%, var(--color-blanc)) 0%,
      color-mix(in srgb, var(--color-papier) 12%, var(--color-blanc)) 40%,
      var(--color-blanc) 100%
    );
  }

  /**
   * Fichas pequenas y sueltas, no dos bloques enormes. Con auto-fill la
   * rejilla crece sola segun cuantos talleres haya, sin tocar nada: hoy son
   * dos, manana seran cuatro.
   */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 21rem));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ficha {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-pierre);
    border-radius: 18px;
    background-color: var(--color-blanc);
    transition:
      transform 420ms var(--ease-fluid),
      border-color 420ms var(--ease-fluid),
      box-shadow 420ms var(--ease-fluid);
  }

  .ficha:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-encre) 22%, transparent);
    box-shadow: var(--shadow-flota);
  }

  .ficha__foto {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .ficha__img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .ficha__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .ficha__nombre {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-encre);
  }

  .ficha__meta {
    font-size: 0.875rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-encre) 62%, transparent);
  }

  /* El precio abajo del todo y alineado en todas las fichas: es el dato que
     se compara, y comparar exige que este siempre en el mismo sitio. */
  .ficha__precio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .ficha__cifra {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-encre);
  }

  .ficha__unidad {
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-encre) 58%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ficha {
      transition: none;
    }

    .ficha:hover {
      transform: none;
    }
  }
</style>
