  .fila__foto :global(picture) {
    display: block;
    height: 100%;
  }

  .fila__foto :global(.fila__img) {
    display: block;
    width: 100%;
    height: 115%;
    object-fit: cover;
  }

  /* Un taller sin fechas: la foto apagada y un sello encima. */
  .fila--proximo .fila__foto :global(.fila__img) {
    filter: grayscale(0.65) contrast(0.95);
  }

  /* Encima de la foto, que al moverse con GSAP pasa a pintarse por delante;
     debajo de la cortina, que tiene que taparlo todo hasta abrirse. */
  .fila__pronto {
    position: absolute;
    z-index: 2;
    top: 1.1rem;
    left: 1.1rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-encre);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-alta);
    transform: rotate(-4deg);
  }

  /* La cortina que descubre la foto: la mueve GSAP. Sin JS no existe. */
  .fila__cortina {
    display: none;
  }

  :global(.js) .fila__cortina {
    display: block;
    position: absolute;
    z-index: 3;
    inset: 0;
    background-color: var(--color-encre);
    transform-origin: right center;
  }

  .fila:nth-child(even) .fila__cortina {
    transform-origin: left center;
  }

  .fila__titulo {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.1rem);
