      font-size: 2.6rem;
    }

    .entrada__cuerpo {
      padding: 1rem 1rem 1.05rem;
    }
  }

  /* --- El collage --- */

  .collage {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 1 / 1.02;
    margin-inline: auto;
  }

  .collage__capa {
    position: absolute;
  }

  .collage__capa--a {
    left: 0;
    top: 6%;
    width: 46%;
  }

  .collage__capa--c {
    right: 0;
    top: 0;
    width: 42%;
  }

  .collage__capa--b {
    left: 27%;
    top: 26%;
    width: 48%;
  }

  .collage__foto {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    border: 6px solid var(--color-blanc);
    border-radius: 22px;
    background-color: var(--color-papier);
    box-shadow: var(--shadow-alta);
    overflow: hidden;
  }

  .collage__foto--a {
    transform: rotate(-8deg);
  }

  .collage__foto--c {
    transform: rotate(7deg);
  }

  .collage__foto--b {
    transform: rotate(-2deg);
  }

  .collage__foto :global(picture),
  .collage__foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collage__etiqueta {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-encre);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .collage__etiqueta--roja {
    background-color: var(--color-grenat);
  }

  /* El de teatro esta en pausa: su foto va apagada, y la etiqueta arriba,
     donde no la tapa la foto de delante. */
  .collage__foto--pronto :global(img) {
    filter: grayscale(0.6);
  }

  .collage__foto--pronto .collage__etiqueta {
    top: 0.7rem;
    right: 0.7rem;
    bottom: auto;
    left: auto;
  }

  /* El sello: el ojo de la marca con un texto que gira alrededor. */
  .sello {
    position: absolute;
    left: 4%;
    bottom: 0;
    display: grid;
    place-items: center;
    width: clamp(5.5rem, 4rem + 5vw, 7.5rem);
