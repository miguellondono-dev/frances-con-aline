---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import Logo from '../../components/Logo.astro';
import Vocabulario from '../../components/home/Thesis.astro';
import ChatWhatsapp from '../../components/ChatWhatsapp.astro';
import { breadcrumb } from '../../lib/schema';
import {
  enOrden,
  estadoDe,
  formato,
  mensajeAviso,
  mensajeInscripcion,
  tallerAbierto,
  type Taller,
} from '../../data/talleres';
import { WA, whatsapp } from '../../data/site';
import { icono } from '../../data/iconos';

import parisSena from '../../assets/paris-sena.jpg';
import teatroGrupo from '../../assets/talleres/teatro-grupo.jpg';
import teatroEscena from '../../assets/talleres/teatro-escena-ancha.jpg';
import acuarelaLamina from '../../assets/talleres/acuarela-lamina.jpg';
import acuarelaMesa from '../../assets/talleres/acuarela-mesa.jpg';
import acuarelaCerezas from '../../assets/talleres/acuarela-cerezas.jpg';

/**
 * TALLERES.
 *
 * Rediseño de septiembre de 2026. Miguel la vio fea: un bloque centrado sobre
 * rosa plano con dos tarjetas pequeñas. Ahora:
 *
 *  1. Portada partida: texto a la izquierda y, a la derecha, un collage con
 *     fotos reales de los talleres que se abren en abanico, flotan y siguen
 *     al raton, con un sello giratorio con el ojo de la marca. Detras, el
 *     dibujo de Paris del inicio.
 *  2. La franja oscura de vocabulario del inicio, con palabras del escenario
 *     y de la pintura.
 *  3. Cada taller en grande y en zigzag: la foto se descubre con una cortina
 *     y se mueve al bajar; al lado, los datos con icono, lo que se practica y
 *     los dos botones.
 *  4. Cierre con WhatsApp.
 *
 * Octubre de 2026: el de teatro no salio y queda "Próximamente"; el de
 * acuarela pasa al 1 de noviembre y Miguel lo quiere muy visible. Por eso la
 * portada lleva una entrada con el proximo taller (fecha, hora, precio y
 * boton), los abiertos van primero y el collage es sobre todo de acuarela.
 * Todo sale de data/talleres.ts: con otra fecha, se cambia alli y ya.
 *
 * Las animaciones las lleva GSAP (scripts/talleres-gsap.ts), que solo se
 * descarga en esta pagina. Sin JS o con movimiento reducido, todo se ve
 * quieto y completo.
 */
const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
];

/**
 * Aqui no va schema de cada taller: cada uno lo lleva en su pagina, que es su
 * URL canonica. La miga de pan sigue en el schema aunque no se pinte.
 */
const schema = [breadcrumb(migas, Astro.site)];

/** Foto de cada taller en su fila, y su texto alternativo. */
const FOTOS: Record<string, { src: ImageMetadata; alt: string }> = {
  teatro: {
    src: teatroEscena,
    alt: 'Dos alumnas representan una escena sobre el escenario, con vestuario y luces de colores',
  },
  acuarela: {
    src: acuarelaMesa,
    alt: 'Mesa de trabajo del taller de acuarela, con la paleta de colores y una lámina a medio pintar',
  },
};

/** Palabras de la pintura y del escenario, para la franja. La pintura va
    primero: es el taller con fecha. */
const VOCABULARIO_TALLERES = [
  { fr: "l'aquarelle", es: 'la acuarela' },
  { fr: 'le pinceau', es: 'el pincel' },
  { fr: 'mélanger', es: 'mezclar' },
  { fr: 'la teinte', es: 'el tono' },
  { fr: 'la lumière', es: 'la luz' },
  { fr: 'la scène', es: 'el escenario' },
  { fr: 'le trac', es: 'los nervios antes de salir' },
  { fr: 'improviser', es: 'improvisar' },
  { fr: 'le rideau', es: 'el telón' },
  { fr: 'le costume', es: 'el vestuario' },
];

const TALLERES_EN_ORDEN = enOrden();
const abierto = tallerAbierto();

/** El dia del proximo taller, partido para el talon de la entrada. */
const fechaTalon = (iso: string) => {
  const fecha = new Date(iso);
  const parte = (opciones: Intl.DateTimeFormatOptions) =>
    fecha.toLocaleDateString('es-ES', { timeZone: 'Europe/Paris', ...opciones }).replace('.', '');
  return {
    semana: parte({ weekday: 'short' }),
    dia: parte({ day: 'numeric' }),
    mes: parte({ month: 'short' }),
    largo: parte({ day: 'numeric', month: 'long' }),
  };
};
const talon = abierto?.tanda ? fechaTalon(abierto.tanda.iso.inicia) : null;

/** El texto que gira en el sello: el proximo taller, o lo general. */
const textoSello = abierto && talon
  ? `${abierto.slug.toUpperCase()} · ${talon.largo.toUpperCase()} · PARÍS ·`
  : 'PRESENCIAL · EN PARÍS · TALLERES ·';

/** Si al compilar ya habia pasado el cierre, sale cerrado de entrada. */
const cerradoYa = (t: Taller) => (estadoDe(t) === 'cerrado' ? '' : undefined);

/**
 * Las tres partes del billete, siempre en este orden. Sin tanda, en vez de
 * fecha, hora y precio: que viene pronto, el formato y el sitio.
 */
const billete = (t: Taller) =>
  t.tanda
    ? [
        {
          icono: 'calendario' as const,
          clave: 'Cuándo',
          valor: t.tanda.cuando,
          extra: `Plazas hasta el ${t.tanda.cierre}`,
          cifra: false,
        },
        { icono: 'reloj' as const, clave: 'Hora', valor: t.tanda.hora, extra: t.ciudad, cifra: false },
        {
          icono: 'entrada' as const,
          clave: 'Precio',
          valor: `${t.tanda.precio} €`,
          extra: t.sesiones > 1 ? `las ${t.sesiones} sesiones` : 'la sesión',
          cifra: true,
        },
      ]
    : [
        {
          icono: 'calendario' as const,
          clave: 'Cuándo',
          valor: 'Próximamente',
          extra: 'Fechas por anunciar',
          cifra: false,
        },
        { icono: 'reloj' as const, clave: 'Formato', valor: formato(t), extra: 'Presencial', cifra: false },
        { icono: 'objetivo' as const, clave: 'Dónde', valor: t.ciudad, extra: 'Dirección al inscribirte', cifra: false },
      ];

const descripcion = abierto?.tanda
  ? `Talleres presenciales en París para hablar francés haciendo algo. Próximo: ${abierto.slug}, ${abierto.tanda.cuando.toLowerCase()}, ${abierto.tanda.precio} €.`
  : 'Talleres presenciales en París para hablar francés haciendo algo: pintar una lámina o subir a un escenario. Próximas fechas, muy pronto.';

/** El titular con su palabra en italica. */
const partes = (titular: string, acento: string) => {
  const i = titular.indexOf(acento);
  return i < 0
    ? { antes: titular, acento: '', despues: '' }
    : { antes: titular.slice(0, i), acento, despues: titular.slice(i + acento.length) };
};
---

<BaseLayout
  title="Talleres de francés en París"
  description={descripcion}
  path="/talleres"
  schema={schema}
>
  <!-- 1. PORTADA -->
  <section class="portada-t" aria-labelledby="talleres-titulo" data-talleres-pagina>
    <div class="portada-t__dibujo" aria-hidden="true">
      <Picture
        src={parisSena}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[800, 1400]}
        sizes="100vw"
        class="portada-t__dibujo-img"
        loading="eager"
      />
    </div>

    <div class="shell portada-t__reparto" data-t-portada data-t-oculto>
      <div class="portada-t__texto">
        <h1 id="talleres-titulo" class="portada-t__titulo" data-t-titulo data-g-titulo>
          Usar el <em class="destacado">francés</em> con las manos y con el cuerpo
        </h1>
        <p class="portada-t__entrada" data-t="entrada">
          Talleres presenciales en París para hablar francés haciendo algo:
          pintar una lámina o subir a un escenario.
        </p>

        {
          abierto?.tanda && talon ? (
            /* El proximo taller, como una entrada: talon con la fecha y, al
               lado, lo que hace falta para decidir y el boton. */
            <div
              class="entrada"
              data-t="entrada"
              data-t-entrada
              data-taller-cierre={abierto.tanda.iso.cierre}
              data-taller-cerrado={cerradoYa(abierto)}
            >
              <div class="entrada__talon" aria-hidden="true" data-t-talon>
                <span class="entrada__semana">{talon.semana}</span>
                <span class="entrada__dia numerals">{talon.dia}</span>
                <span class="entrada__mes">{talon.mes}</span>
              </div>
              <span class="entrada__corte" aria-hidden="true" />
              <div class="entrada__cuerpo">
                <p class="entrada__rotulo">
                  <span class="si-abierto">
                    <span class="estado__punto" aria-hidden="true" />
                    Próximo taller
                  </span>
                  <span class="si-cerrado">Plazas cerradas</span>
                </p>
                <p class="entrada__nombre">{abierto.nombre}</p>
                <p class="entrada__datos">
                  {abierto.tanda.cuando} · {abierto.tanda.hora}
                  <span class="entrada__precio numerals">{abierto.tanda.precio} €</span>
                </p>
                <div class="entrada__acciones">
                  <div class="si-abierto">
                    <Cta href={whatsapp(mensajeInscripcion(abierto))}>Reservar</Cta>
                  </div>
                  <div class="si-cerrado">
                    <Cta href={whatsapp(mensajeAviso(abierto))}>Avísame del próximo</Cta>
                  </div>
                  <a class="enlace-flecha" href={`/talleres/${abierto.slug}`}>
                    Ver el taller
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path
                        d="M2 8h12M9 3l5 5-5 5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
                <div class="si-abierto">
                  <p class="entrada__cierre">Plazas hasta el {abierto.tanda.cierre}</p>
                </div>
              </div>
            </div>
          ) : (
            <div class="portada-t__acciones" data-t="entrada">
              <Cta href={whatsapp(WA.talleres)}>Avísame del próximo</Cta>
              <a class="enlace-flecha" href={`#${TALLERES_EN_ORDEN[0].slug}`}>
                Ver los talleres
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M8 2v12M3 9l5 5 5-5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          )
        }
      </div>

      {/* El collage repite fotos que salen abajo con su texto: aqui es
          decorativo. */}
      <div class="collage" data-t-collage aria-hidden="true">
        <div class="collage__capa collage__capa--a" data-profundidad="0.5">
          {/* La lamina del pastel de cerezas y no la mesa con la paleta: esa era
              casi igual a la del pajaro de delante. */}
          <figure class="collage__foto collage__foto--a">
            <Picture
              src={acuarelaCerezas}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[300, 480]}
              sizes="(min-width: 64rem) 15rem, 40vw"
              loading="eager"
            />
          </figure>
        </div>
        <div class="collage__capa collage__capa--c" data-profundidad="0.8">
          <figure class="collage__foto collage__foto--c collage__foto--pronto">
            <Picture
              src={teatroGrupo}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[300, 480]}
              sizes="(min-width: 64rem) 13rem, 36vw"
              loading="eager"
            />
            <span class="collage__etiqueta">Teatro · pronto</span>
          </figure>
        </div>
        <div class="collage__capa collage__capa--b" data-profundidad="1.1">
          <figure class="collage__foto collage__foto--b">
            <Picture
              src={acuarelaLamina}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[300, 480]}
              sizes="(min-width: 64rem) 16rem, 44vw"
              loading="eager"
            />
            <span class="collage__etiqueta collage__etiqueta--roja">Acuarela</span>
          </figure>
        </div>

        {/* Sello con el ojo de la marca y un texto que gira alrededor. */}
        <div class="sello" data-t-sello>
          <svg class="sello__texto" viewBox="0 0 120 120">
            <defs>
              <path id="sello-circulo" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0" />
            </defs>
            <text>
              <textPath href="#sello-circulo" textLength="292">
                {textoSello}
              </textPath>
            </text>
          </svg>
          <span class="sello__ojo"><Logo viewBox="195 258 860 691" /></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. FRANJA DE VOCABULARIO -->
  <Vocabulario palabras={VOCABULARIO_TALLERES} etiqueta="Vocabulario de los talleres con su traducción" />

  <!-- 3. LOS TALLERES -->
  <section class="lista-t" aria-label="Los talleres">
    <div class="shell">
      {
        TALLERES_EN_ORDEN.map((t, i) => {
          /* El nombre del taller es el titular, con "francés" en rojo. Antes iba
             en una etiqueta pequeña encima del gancho, y Miguel no quiere
             textos encima de los titulares. El gancho ya es el H1 de la
             pagina de cada taller. */
          const tit = partes(t.nombre, 'francés');
          return (
            <article
              class:list={['fila', { 'fila--proximo': !t.tanda }]}
              id={t.slug}
              data-t-fila
              aria-labelledby={`${t.slug}-titulo`}
              data-taller-cierre={t.tanda?.iso.cierre}
              data-taller-cerrado={cerradoYa(t)}
            >
              <div class="fila__media">
                <span class="fila__numero" aria-hidden="true" data-t-numero>
                  {String(i + 1).padStart(2, '0')}
                </span>
                {/* La foto tambien lleva al taller. Fuera del tabulador: el boton
                    de la derecha ya es el enlace. */}
                <a class="fila__foto" href={`/talleres/${t.slug}`} tabindex="-1" aria-hidden="true">
                  {t.tanda ? (
                    <>
                      <span class="si-abierto">
                        <span class="fila__estado">
                          <span class="estado__punto" />
                          Plazas abiertas
                        </span>
                      </span>
                      <span class="si-cerrado">
                        <span class="fila__estado fila__estado--cerrado">Plazas cerradas</span>
                      </span>
                    </>
                  ) : (
                    <span class="fila__pronto">Próximamente</span>
                  )}
                  <Picture
                    src={FOTOS[t.slug].src}
                    alt={FOTOS[t.slug].alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[420, 640, 900]}
                    sizes="(min-width: 48rem) 17rem, 92vw"
                    class="fila__img"
                    data-t-img
                  />
                  <span class="fila__cortina" aria-hidden="true" data-t-cortina />
                </a>
              </div>

              <div class="fila__texto">
                <h2 id={`${t.slug}-titulo`} class="fila__titulo" data-t-titulo data-g-titulo>
                  {tit.antes}
                  {tit.acento && <em class="destacado">{tit.acento}</em>}
                  {tit.despues}
                </h2>
                <p class="fila__resumen" data-t-pieza>{t.resumen}</p>

                {/* Los tres datos, como un billete de entrada: una sola pieza con
                    tres partes separadas por cortes troquelados. */}
                <div class="billete" role="list" aria-label="Datos del taller" data-t-billete>
                  {billete(t).map((celda, j) => (
                    <Fragment>
                      {j > 0 && <span class="billete__corte" aria-hidden="true" data-t-corte />}
                      <div class="billete__celda" role="listitem" data-t-dato>
                        <span class="billete__icono" set:html={icono(celda.icono)} />
                        <span class="billete__clave">{celda.clave}</span>
                        <span
                          class:list={['billete__valor', { numerals: celda.cifra }]}
                          data-t-cifra={celda.cifra ? '' : undefined}
                        >
                          {celda.valor}
                        </span>
                        <span class="billete__extra">{celda.extra}</span>
                      </div>
                    </Fragment>
                  ))}
                </div>

                {/* Un solo boton: entrar al taller. Lo que se practica, el
                    horario completo y la inscripcion estan dentro. */}
                <div class="fila__acciones" data-t-pieza>
                  <Cta href={`/talleres/${t.slug}`}>Ver el taller</Cta>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- 4. CIERRE -->
  <section class="fondo-calido" aria-labelledby="talleres-dudas">
    <div class="shell grid items-center gap-10 pt-section-sm pb-section lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <div>
        <h2 id="talleres-dudas" class="cierre-t__titulo" data-reveal>¿Dudas antes de apuntarte?</h2>
        <p class="cierre-t__texto" data-reveal>
          Escríbeme y te cuento cómo es cada taller, dónde es exactamente y cómo
          se paga.
        </p>
      </div>
      <ChatWhatsapp mensaje={WA.dudasTalleres} boton="Escribirme por WhatsApp" asunto="Una pregunta sobre los talleres" />
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/talleres-estado';
  import '../../scripts/talleres-gsap';
</script>

<style>
  /* --- 1. Portada --- */

  .portada-t {
    position: relative;
    overflow: hidden;
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 55%, var(--color-blanc)) 55%,
      color-mix(in srgb, var(--color-papier) 80%, var(--color-blanc)) 100%
    );
  }

  /* El dibujo de Paris del inicio, abajo y muy suave. */
  .portada-t__dibujo {
    position: absolute;
    inset: auto 0 0 0;
    height: 75%;
    pointer-events: none;
    opacity: 0.9;
    mix-blend-mode: multiply;
    /* Dos mascaras que se multiplican: aparece de abajo hacia arriba, y en
       la zona del texto se queda en una textura suave para no cruzar las
       letras. En movil el texto va encima de todo: se atenua entero. */
    mask-image:
      linear-gradient(to bottom, transparent 0%, black 40%),
      linear-gradient(to right, rgb(0 0 0 / 0.2) 0%, rgb(0 0 0 / 0.2) 40%, black 62%);
    mask-composite: intersect;
  }

  @media (width < 64rem) {
    .portada-t__dibujo {
      opacity: 0.35;
      mask-image: linear-gradient(to bottom, transparent 0%, black 50%);
    }
  }

  .portada-t__dibujo :global(picture),
  .portada-t__dibujo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  .portada-t__reparto {
    position: relative;
    display: grid;
    gap: 3rem;
    padding-block: 2.5rem 5rem;
  }

  @media (width >= 64rem) {
    .portada-t__reparto {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: 3rem;
      min-height: min(44rem, calc(100svh - 5rem));
      padding-block: 2rem 4rem;
    }
  }

  :global(.js) [data-t-oculto] {
    visibility: hidden;
  }

  /* Colchon de las mascaras de GSAP para que no corten tildes ni colas. */
  :global(.g-linea-mask),
  :global(.g-palabra-mask) {
    padding-top: 0.12em;
    margin-top: -0.12em;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .portada-t__titulo {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.5rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--color-encre);
  }

  .portada-t__entrada {
    margin-top: 1.5rem;
    max-width: 40ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-nuit);
  }

  .portada-t__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .enlace-flecha {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-encre);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-encre) 30%, transparent);
    text-underline-offset: 5px;
    transition: text-decoration-color var(--duration-fast) var(--ease-smooth);
  }

  .enlace-flecha svg {
    width: 1rem;
    height: 1rem;
    transition: transform 320ms var(--ease-smooth);
  }

  .enlace-flecha:hover {
    text-decoration-color: var(--color-grenat);
  }

  .enlace-flecha:hover svg {
    transform: translate(3px, 0);
  }

  .portada-t__acciones .enlace-flecha:hover svg {
    transform: translate(0, 3px);
  }

  /* Un punto que late: dice "abierto" sin tener que leerlo. */
  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.45rem 0.9rem 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-blanc) 75%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 10%, transparent);
    font-size: var(--text-body-s);
    font-weight: 500;
    color: var(--color-encre);
  }

  .estado__punto {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
  }

  .estado__punto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: var(--color-grenat);
