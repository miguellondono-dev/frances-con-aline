    pointer-events: none;
  }

  .fila:nth-child(even) .fila__numero {
    left: auto;
    right: -0.08em;
  }

  .fila__foto {
    display: block;
    position: relative;
    z-index: 1;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin: 2.5rem 0 0;
    border-radius: 22px;
    background-color: var(--color-papier);
    box-shadow: var(--shadow-alta);
  }

  /* En el movil, apaisada y baja, para que el texto suba. Desde tableta,
     vertical y estrecha al lado del texto. */
  @media (width >= 48rem) {
    .fila__foto {
      aspect-ratio: 5 / 6;
      max-width: 17rem;
      margin: 2.75rem 0 0 1.75rem;
      border-radius: 24px;
    }

    .fila:nth-child(even) .fila__foto {
      margin: 2.75rem 1.75rem 0 auto;
    }
