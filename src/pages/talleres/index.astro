    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-encre);
  }

  .fila__resumen {
    margin-top: 1.25rem;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
