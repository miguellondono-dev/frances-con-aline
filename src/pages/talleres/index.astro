  /* Cada taller en su panel: un tono suave de la marca con la trama de puntos
     de las escenas, calido el primero y frio el segundo. Antes los dos iban
     sobre blanco liso. --fondo-fila es tambien el color de las muescas del
     billete, que imitan agujeros. */
  .fila {
    --fondo-fila: color-mix(in srgb, var(--color-papier) 40%, var(--color-blanc));
    display: grid;
    gap: 2.5rem;
    padding: 1.75rem 1.25rem 2rem;
    border-radius: 32px;
    background-color: var(--fondo-fila);
    background-image: radial-gradient(color-mix(in srgb, var(--color-encre) 7%, transparent) 1px, transparent 1.5px);
    background-size: 16px 16px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-pierre) 70%, transparent);
    scroll-margin-top: 6rem;
  }

  .fila:nth-child(even) {
    --fondo-fila: color-mix(in srgb, var(--color-ciel) 26%, var(--color-blanc));
  }

  .fila + .fila {
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  @media (width >= 64rem) {
    .fila {
      padding: 2.75rem 3.25rem 3rem;
    }
  }

  /* La foto acompaña, no manda: desde tableta va al lado del texto, en una
     columna estrecha. Encima del texto lo empujaba casi 400px hacia abajo. */
  @media (width >= 48rem) {
    .fila {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: 2.5rem;
    }

    /* Zigzag: la segunda fila pone la foto a la derecha. */
    .fila:nth-child(even) .fila__media {
      order: 2;
    }

    .fila:nth-child(even) {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  @media (width >= 64rem) {
    .fila {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 4rem;
    }

    .fila:nth-child(even) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
  }

  .fila__media {
    position: relative;
  }

  /* El numero grande detras de la foto, en contorno. */
  .fila__numero {
    position: absolute;
    top: -0.35em;
    left: -0.08em;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 3.5rem + 6vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
