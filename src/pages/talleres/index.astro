  .entrada__corte {
    width: 0;
    margin-block: 0.9rem;
    border-left: 2px dashed color-mix(in srgb, var(--color-encre) 14%, transparent);
  }

  .entrada__cuerpo {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.35rem 1.15rem;
  }

  .entrada__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
