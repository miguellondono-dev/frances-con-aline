    color: var(--color-nuit);
  }

  /* --- El billete ---
     Una sola pieza en tres partes. Los cortes llevan una muesca arriba y otra
     abajo, del color de la pagina, como un billete troquelado. Lo que mueve
     GSAP (el billete, sus celdas, los cortes) no lleva transicion de CSS en
     transform: las dos a la vez hacian que las casillas llegaran tarde y se
     quedaran montadas sobre las pastillas. */
  .billete {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    margin-top: 1.75rem;
    border-radius: 18px;
    background-color: var(--color-blanc);
    box-shadow:
      var(--shadow-flota),
      inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 7%, transparent);
  }

  .billete__celda {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 1.1rem 1.15rem 1.15rem;
  }

  .billete__icono {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-bottom: 0.55rem;
    border-radius: 11px;
    background-color: var(--color-blanc);
    color: var(--color-grenat);
    box-shadow: 0 4px 10px -6px color-mix(in srgb, var(--color-encre) 40%, transparent);
    transition: transform 320ms var(--ease-smooth);
  }

  .billete__icono :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .billete__clave {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-encre) 55%, transparent);
  }

  .billete__valor {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-encre);
  }

  .billete__extra {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-encre) 66%, transparent);
  }

  /* El corte: linea de puntos con una muesca arriba y otra abajo. */
  .billete__corte {
    position: relative;
    width: 0;
    margin-block: 0.9rem;
    border-left: 2px dashed color-mix(in srgb, var(--color-encre) 16%, transparent);
    transform-origin: center top;
  }

  .billete__corte::before,
  .billete__corte::after {
    content: '';
    position: absolute;
    left: -1px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background-color: var(--fondo-fila, var(--color-blanc));
    translate: -50% 0;
  }

  .billete__corte::before {
    top: calc(-0.9rem - 0.5rem);
  }

  .billete__corte::after {
    bottom: calc(-0.9rem - 0.5rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .billete__celda:hover .billete__icono {
      transform: rotate(-10deg) scale(1.12);
    }
  }

  /* En pantallas estrechas, las tres partes una debajo de otra y los cortes
     en horizontal. */
  @media (width < 36rem) {
    .billete {
      grid-template-columns: minmax(0, 1fr);
    }

    .billete__celda {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 0.9rem;
      align-items: center;
    }

    .billete__icono {
      grid-row: 1 / span 3;
      margin-bottom: 0;
    }

    .billete__corte {
      width: auto;
      height: 0;
      margin-block: 0;
      margin-inline: 0.9rem;
      border-left: none;
      border-top: 2px dashed color-mix(in srgb, var(--color-encre) 16%, transparent);
      transform-origin: left center;
    }

    .billete__corte::before,
    .billete__corte::after {
      top: -1px;
      translate: 0 -50%;
    }

    .billete__corte::before {
      left: calc(-0.9rem - 0.5rem);
    }

    .billete__corte::after {
      left: auto;
      right: calc(-0.9rem - 0.5rem);
    }
  }

  /* El estado, encima de la foto: blanco con el punto que late. */
  .fila__estado {
    position: absolute;
    z-index: 2;
    top: 1.1rem;
    left: 1.1rem;
    display: inline-flex;
    align-items: center;
