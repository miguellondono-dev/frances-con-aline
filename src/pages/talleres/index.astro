  .estado--proximo .estado__punto,
  .estado--proximo .estado__punto::after {
    background-color: var(--color-azur);
  }

  /* --- La entrada del proximo taller ---
     Un billete: el talon granate con el dia y, al otro lado de un corte de
     puntos, el nombre, la hora, el precio y el boton. Es lo primero que se ve
     de la pagina despues del titular. GSAP mueve la entrada entera: no lleva
     transicion de CSS en transform. */
  .entrada {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    max-width: 34rem;
    margin-top: 2rem;
    border-radius: 22px;
    background-color: var(--color-blanc);
    box-shadow:
      var(--shadow-alta),
      inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 6%, transparent);
  }

  .entrada__talon {
    display: grid;
    align-content: center;
    justify-items: center;
    min-width: 6.25rem;
    padding: 1.25rem 0.9rem;
    border-radius: 22px 0 0 22px;
    background-image: linear-gradient(160deg, var(--color-grenat), var(--color-lie));
    color: var(--color-blanc);
    font-family: var(--font-display);
