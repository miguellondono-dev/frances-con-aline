---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumb } from '../../lib/schema';
import { TALLERES, hechos } from '../../data/talleres';

import teatroPortada from '../../assets/talleres/teatro-escena-ancha.jpg';
import acuarelaPortada from '../../assets/talleres/acuarela-lamina.jpg';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
];

const portadas: Record<string, ImageMetadata> = {
  teatro: teatroPortada,
  acuarela: acuarelaPortada,
};

const alt: Record<string, string> = {
  teatro:
    'Dos alumnas representan una escena sobre el escenario, con vestuario y luces de colores',
  acuarela:
    'Una mano sostiene una lámina de acuarela recién terminada sobre la mesa de trabajo',
};

/**
 * Aqui no va schema de cada taller: cada uno lo lleva en su pagina, que es su
 * URL canonica. Repetirlo en el indice le daria dos Course con la misma ficha
 * a un buscador y ninguno de los dos ganaria.
 *
 * La miga de pan sigue en el schema aunque ya no se pinte: es de ahi de donde
 * un buscador saca la ruta que enseña debajo del resultado. En pantalla
 * sobraba, porque la ultima miga decia "Talleres" justo encima de un titular
 * que dice "Talleres".
 */
const schema = [breadcrumb(migas, Astro.site)];
---

<BaseLayout
  title="Talleres"
  description="Dos talleres presenciales en París para usar el francés fuera del cuaderno. Teatro, cuatro sábados de octubre, 65 €. Acuarela, un domingo, 30 €."
  path="/talleres"
  schema={schema}
>
  {/*
    Mismo patron que la seccion de formatos del inicio: titular centrado con
    la palabra en italica, rejilla estrecha y centrada, y tarjetas que se
    llenan de tinta al pasar por encima. El inicio ya habia resuelto el hueco
    de la derecha con un max-width: a todo el ancho quedaban desparramadas.
  */}
  <section class="talleres-seccion" aria-labelledby="talleres-titulo">
    <div class="shell py-section">
      <div class="flex flex-col items-center text-center">
        <p class="label text-lie" data-reveal data-repite>Presencial, en París</p>
        <h1 id="talleres-titulo" class="talleres-titulo" data-palabras data-repite>
          Usar el <em class="destacado">francés</em> con las manos y con el cuerpo
        </h1>
        <p class="talleres-entrada" data-reveal data-repite>
          Dos talleres en octubre, los dos con plaza.
        </p>
      </div>

      <ul class="rejilla">
        {
          TALLERES.map((t) => (
            <li data-reveal data-repite>
              <a class="ficha" href={`/talleres/${t.slug}`}>
                <span class="ficha__foto">
                  <Picture
                    src={portadas[t.slug]}
                    alt={alt[t.slug]}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[320, 480, 720]}
                    sizes="(min-width: 48rem) 21rem, 92vw"
                    class="ficha__img"
                    loading="eager"
                  />
                </span>

                <span class="ficha__cuerpo">
                  <span class="ficha__nombre">{t.nombre}</span>

                  {/* Cuando y hora, en el mismo orden que en la pagina del
                      taller. Quien llega desde aqui los busca donde ya los vio. */}
                  <span class="ficha__meta">
                    {t.cuando} · {t.hora}
                  </span>

                  <span class="ficha__pie">
                    <span class="ficha__precio">
                      <span class="ficha__cifra numerals">{t.precio} €</span>
                      <span class="ficha__unidad">
                        {t.sesiones > 1 ? `las ${t.sesiones} sesiones` : 'la sesión'}
                      </span>
                    </span>

                    <span class="ficha__flecha" aria-hidden="true">
                      <svg viewBox="0 0 24 16" class="h-3.5 w-5" fill="none">
                        <path
                          d="M1 8h20M15 2l6 6-6 6"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* El mismo degradado que la seccion de formatos del inicio: aguanta el tono
     calido por debajo de las tarjetas y solo entonces se abre al blanco. */
  .talleres-seccion {
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-papier) 72%, var(--color-blanc)) 0%,
      color-mix(in srgb, var(--color-papier) 72%, var(--color-blanc)) 58%,
      color-mix(in srgb, var(--color-papier) 46%, var(--color-blanc)) 78%,
      color-mix(in srgb, var(--color-papier) 14%, var(--color-blanc)) 91%,
      var(--color-blanc) 100%
    );
  }

  .talleres-titulo {
    margin-top: 1.25rem;
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: var(--text-display-l);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--color-encre);
  }

  .destacado {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-lie);
  }

  .talleres-entrada {
    margin-top: 1.5rem;
    max-width: 42ch;
    font-size: var(--text-body);
    color: var(--color-nuit);
  }

  /**
   * Estrecha y centrada, como la del inicio. A todo el ancho del contenedor,
   * dos fichas dejaban medio metro de blanco a la derecha.
   */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 46rem;
    margin: 3.5rem auto 0;
    padding: 0;
    list-style: none;
  }

  /* Entrada larga y con salida exponencial, la misma que las tarjetas del
     inicio: recorrido corto y freno brusco se sienten toscos. */
  .rejilla > li {
    transition:
      opacity 820ms var(--ease-fluid),
      transform 820ms var(--ease-fluid) !important;
  }

  :global(.js) .rejilla > li[data-reveal] {
    transform: translateY(34px) scale(0.985);
  }

  .rejilla > li[data-reveal].is-revealed {
    transform: none;
  }

  /* --- La ficha --- */

  .ficha {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border-radius: 22px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-flota);
    transition:
      transform 520ms var(--ease-fluid),
      box-shadow 520ms var(--ease-fluid);
  }

  /* El degradado del estado activo se funde por opacidad, que es lo unico que
     se puede animar de forma continua en un degradado. */
  .ficha::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-image: linear-gradient(
      to bottom,
      var(--color-encre) 0%,
      var(--color-encre) 30%,
      var(--color-nuit) 100%
    );
    opacity: 0;
    transition: opacity 520ms var(--ease-fluid);
  }

  .ficha__foto {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .ficha__img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: scale 720ms var(--ease-fluid);
  }

  .ficha__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem 1.4rem 1.4rem;
  }

  .ficha__nombre {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-encre);
    transition: color 420ms var(--ease-fluid);
  }

  .ficha__meta {
    font-size: 0.875rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-encre) 62%, transparent);
    transition: color 420ms var(--ease-fluid);
  }

  /* El precio abajo del todo y a la misma altura en todas: es el dato que se
     compara, y comparar exige que este siempre en el mismo sitio. */
  .ficha__pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .ficha__precio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
  }

  .ficha__cifra {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.1;
    color: color-mix(in srgb, var(--color-encre) 84%, transparent);
    transition: color 420ms var(--ease-fluid);
  }

  .ficha__unidad {
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-encre) 58%, transparent);
    transition: color 420ms var(--ease-fluid);
  }

  .ficha__flecha {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    width: 2.25rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--color-encre) 18%, transparent);
    border-radius: 50%;
    color: var(--color-encre);
    transition:
      background-color 420ms var(--ease-fluid),
      border-color 420ms var(--ease-fluid),
      color 420ms var(--ease-fluid),
      transform 420ms var(--ease-fluid);
  }

  /* --- Estado activo --- */

  .ficha:hover,
  .ficha:focus-visible {
    transform: translateY(-6px);
    box-shadow: var(--shadow-alta);
  }

  .ficha:hover::before,
  .ficha:focus-visible::before {
    opacity: 1;
  }

  .ficha:hover .ficha__img,
  .ficha:focus-visible .ficha__img {
    scale: 1.04;
  }

  .ficha:hover .ficha__nombre,
  .ficha:focus-visible .ficha__nombre {
    color: var(--color-blanc);
  }

  .ficha:hover .ficha__meta,
  .ficha:hover .ficha__unidad,
  .ficha:focus-visible .ficha__meta,
  .ficha:focus-visible .ficha__unidad {
    color: var(--color-ciel);
  }

  .ficha:hover .ficha__cifra,
  .ficha:focus-visible .ficha__cifra {
    color: color-mix(in srgb, var(--color-blanc) 88%, transparent);
  }

  .ficha:hover .ficha__flecha,
  .ficha:focus-visible .ficha__flecha {
    border-color: var(--color-blanc);
    background-color: var(--color-blanc);
    color: var(--color-encre);
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .rejilla > li,
    .ficha,
    .ficha::before,
    .ficha__img,
    .ficha__nombre,
    .ficha__meta,
    .ficha__cifra,
    .ficha__unidad,
    .ficha__flecha {
      transition: none;
    }

    .ficha:hover,
    .ficha:focus-visible {
      transform: none;
    }

    .ficha:hover .ficha__img,
    .ficha:focus-visible .ficha__img {
      scale: 1;
    }

    .ficha:hover .ficha__flecha,
    .ficha:focus-visible .ficha__flecha {
      transform: none;
    }
  }
</style>
