---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TallerLanding from '../../components/TallerLanding.astro';
import { breadcrumb, taller } from '../../lib/schema';
import { porSlug, type Medio } from '../../data/talleres';

import escenaAncha from '../../assets/talleres/teatro-escena-ancha.jpg';
import escenaMesa from '../../assets/talleres/teatro-escena-mesa.jpg';
import escenaPie from '../../assets/talleres/teatro-escena-pie.jpg';
import escenaDos from '../../assets/talleres/teatro-escena-dos.jpg';
import grupo from '../../assets/talleres/teatro-grupo.jpg';
import posterEscena from '../../assets/talleres/teatro-video-escena.jpg';
import posterEnsayo from '../../assets/talleres/teatro-video-ensayo.jpg';

const t = porSlug('teatro');

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Talleres', path: '/talleres' },
  { name: t.nombre, path: '/talleres/teatro' },
];

const medios: Medio[] = [
  {
    tipo: 'video',
    src: '/video/teatro-escena.mp4',
    poster: posterEscena,
    alt: 'Dos alumnos representan una escena completa sobre el escenario, sentados frente al público',
    ancho: 2,
  },
  {
    tipo: 'foto',
    src: escenaMesa,
    alt: 'Dos alumnas actúan alrededor de una mesa con mantel verde, con pelucas y vestuario',
  },
  {
    tipo: 'foto',
    src: escenaPie,
    alt: 'Una alumna con un chal de colores da la réplica a otra, de pie sobre el escenario',
  },
  {
    tipo: 'video',
    src: '/video/teatro-ensayo.mp4',
    poster: posterEnsayo,
    alt: 'Dos alumnas repasan su texto de pie antes de subir a escena',
  },
  {
    tipo: 'foto',
    src: escenaDos,
    alt: 'Escena en la que dos personajes conversan junto a una mesa, con la luz azul del fondo',
  },
  {
    tipo: 'foto',
    src: grupo,
    alt: 'El grupo del taller posa entero al terminar, delante de las cortinas rojas del escenario',
    ancho: 2,
  },
];

const schema = [
  breadcrumb(migas, Astro.site),
  taller({
    name: 'Taller de teatro en francés',
    description:
      'Cuatro sábados para perder la vergüenza de hablar francés: ejercicios de voz, trabalenguas, escenas en grupo, interpretación e improvisación, con una representación final sobre el escenario. Presencial en París.',
    path: '/talleres/teatro',
    site: Astro.site,
    inicia: t.tanda?.iso.inicia,
    termina: t.tanda?.iso.termina,
    horario: t.tanda ? `Sábados de ${t.tanda.hora}` : 'Sábados',
    dia: t.diaSemana,
    sesiones: t.sesiones,
    minutosPorSesion: t.minutosPorSesion,
    precio: t.tanda?.precio,
    moneda: 'EUR',
    ciudad: t.ciudad,
    pais: 'FR',
    cierreInscripcion: t.tanda?.iso.cierre,
  }),
];

/** Con fechas, las fechas; sin ellas, que vuelve pronto. */
const descripcion = t.tanda
  ? `Cuatro sábados para perder la vergüenza de hablar francés: ${t.tanda.cuando.toLowerCase()}, de ${t.tanda.hora}, en París. ${t.tanda.precio} € las cuatro sesiones.`
  : 'Cuatro sábados para perder la vergüenza de hablar francés, sobre un escenario de verdad en París. Las próximas fechas, muy pronto.';
---

<BaseLayout
  title="Taller de teatro en francés en París"
  description={descripcion}
  path="/talleres/teatro"
  schema={schema}
>
  <TallerLanding
    taller={t}
    portada={escenaAncha}
    portadaAlt="Dos alumnas representan una escena sobre el escenario, con vestuario y luces de colores"
    medios={medios}
  />
</BaseLayout>
