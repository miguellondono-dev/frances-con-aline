---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import retrato from '../assets/aline-retrato.png';
import Cta from '../components/Cta.astro';
import Bandera from '../components/Bandera.astro';
import Icon from '../components/Icon.astro';
import { breadcrumb, alineId } from '../lib/schema';
import { CTA, PRECIOS } from '../data/site';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Sobre mí', path: '/sobre-mi' },
];

/**
 * Person de Aline. Es el nodo que las demas paginas referencian como provider.
 *
 * TODO [PENDIENTE] alumniOf: falta el nombre de la institucion donde estudio
 * Gestion de la Cultura. Hasta tenerlo, el titulo se declara con
 * hasCredential, que no exige nombrar organizacion, en vez de inventar una.
 */
const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': alineId(Astro.site),
  name: 'Aline',
  jobTitle: 'Profesora de francés',
  description:
    'Profesora francesa de francés para hispanohablantes. Formada en pedagogía y métodos de aprendizaje, habla cinco idiomas y lleva más de cinco años enseñando.',
  nationality: { '@type': 'Country', name: 'Francia' },
  knowsLanguage: [
    { '@type': 'Language', name: 'Francés' },
    { '@type': 'Language', name: 'Español' },
    { '@type': 'Language', name: 'Inglés' },
    { '@type': 'Language', name: 'Italiano' },
    { '@type': 'Language', name: 'Portugués' },
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Estudios universitarios',
    name: 'Gestión de la Cultura',
  },
  knowsAbout: [
    'Enseñanza del francés como lengua extranjera',
    'Preparación del examen DELF',
    'Expediente Campus France',
    'Redacción y corrección de CV en francés',
    'Gestión cultural',
  ],
};

const schema = [persona, breadcrumb(migas, Astro.site)];

/**
 * Lo que se puede pedir en Hablemos. El interes no es decoracion: es lo que
 * permite saber que oferta trae a cada persona, y por tanto donde merece la
 * pena invertir. Sin ese dato, cada mensaje es anonimo en cuanto a origen.
 */
const INTERESES = [
  'Clases privadas',
  'Clases en grupo',
  'Preparación del DELF',
  'Talleres en París',
  'Tours por París',
  'Otra cosa',
];


/** Portugues lleva Brasil, que es de donde viene casi todo el que lo habla. */
const IDIOMAS = [
  { nombre: 'Francés', pais: 'fr' as const },
  { nombre: 'Español', pais: 'es' as const },
  { nombre: 'Inglés', pais: 'gb' as const },
  { nombre: 'Italiano', pais: 'it' as const },
  { nombre: 'Portugués', pais: 'br' as const },
];


/**
 * Tres cosas concretas sobre como da clase. Una linea cada una, con su marca:
 * antes esto eran dos parrafos seguidos y no habia por donde entrar.
 */
const COMO = [
  {
    icono: 'plan' as const,
    titulo: 'Salimos de lo que te interesa',
    texto: 'El material lo elijo por lo que te gusta y por lo que necesitas.',
  },
  {
    icono: 'escuchar' as const,
    titulo: 'Hablas desde el primer día',
    texto: 'Si algo se atasca cambio a tu idioma, lo aclaramos y seguimos.',
  },
  {
    icono: 'escudo' as const,
    titulo: 'Una escuela europea me seleccionó',
    texto: 'Para enseñar a estudiantes en Canadá, Reino Unido y Francia.',
  },
];

/**
 * Los dos formatos, tratados igual: mismo icono, mismo numero de puntos,
 * mismo sitio para el precio. Antes eran dos cajas de texto sin nada donde
 * apoyar la vista.
 */
const FORMATOS = [
  {
    icono: 'privada' as const,
    nombre: 'Clases privadas',
    puntos: [
      'Adapto el contenido a tus preferencias y a tus objetivos',
      'La poesía, la fotografía, el teatro, el cine o lo que te mueva',
    ],
    precio: PRECIOS.privada,
  },
  {
    icono: 'grupo' as const,
    nombre: 'Clases en grupo',
    puntos: [
      'Avanzamos por niveles, con acompañamiento y con el progreso a la vista',
      'De dos a cinco personas, para que a todos les toque hablar',
    ],
    precio: PRECIOS.grupo,
  },
];


---

<BaseLayout
  title="Sobre mí: profesora francesa de francés, y cinco idiomas"
  description="El francés es mi lengua y hablo cinco idiomas. Me formé en pedagogía y monto cada clase alrededor de lo que te gusta. También te acompaño con Campus France y con tu CV en francés."
  path="/sobre-mi"
  schema={schema}
>
  <!-- Apertura -->
  <section class="cabecera overflow-hidden">
    <div
      class="pad-shell-left grid items-center gap-12 pb-section pt-14 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-14"
    >
      <div class="pad-shell-right lg:pr-0">
        <h1 class="cabecera__titulo" data-reveal>
          Enseño francés para que lo hables con fluidez
        </h1>
        <p class="cabecera__entrada" data-reveal>
          Es mi lengua materna y aprender idiomas es mi pasión. Me formé en
          pedagogía y en métodos de aprendizaje, hablo cinco idiomas y llevo más
          de cinco años enseñando a estudiantes de medio mundo.
        </p>

        <ul class="idiomas" data-reveal>
          {
            IDIOMAS.map((idioma, i) => (
              <li class="idiomas__uno" style={`--i:${i}`}>
                <Bandera pais={idioma.pais} />
                <span class="idiomas__nombre">{idioma.nombre}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* El retrato viene recortado, sin fondo. Por eso no va dentro de un
          marco: se apoya sobre una forma de color y la tapa por delante, que
          es lo que le da profundidad a una foto sin fondo. */}
      {/* El envoltorio devuelve el relleno de la derecha, que la rejilla solo
          pone a la izquierda: sin el, en movil la foto quedaba doce puntos
          descentrada. En pantalla ancha se quita para que la forma pueda
          salirse por el canto. */}
      <div class="pad-shell-right lg:pr-0" data-reveal="fade">
        <div class="retrato">

          <div class="retrato__disco">
            <Picture
            src={retrato}
            formats={['avif', 'webp']}
            {/* El respaldo tambien en webp: por defecto Astro lo deja en el
                formato de origen, y ahi eran 1,4 MB de PNG que nadie llega a
                descargar pero que quedan en el paquete. */}
            fallbackFormat="webp"
            {/*
              La imagen se dibuja al 149 por ciento de su caja para lograr el
              encuadre, asi que el sizes tiene que declarar ese ancho y no el
              de la caja. Declarando 26rem el navegador bajaba un archivo de
              416px para un hueco de 620 y lo estiraba 1,49 veces.
            */}
            widths={[520, 780, 1063]}
            sizes="(min-width: 30rem) 620px, 130vw"
            alt="Aline, profesora de francés"
            loading="eager"
            class="retrato__img"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Como ensena. Marcas y datos, no dos bloques de prosa. -->
  <section class="clases" aria-labelledby="clases">
    <div class="shell py-section">
      <h2 id="clases" class="clases__titulo" data-reveal>Así es una clase conmigo</h2>

      <ul class="como">
        {
          COMO.map((c, i) => (
            <li class="como__uno" style={`--i:${i}`} data-reveal>
              <span class="como__marca" aria-hidden="true">
                <Icon name={c.icono} class="h-5 w-5" />
              </span>
              <span class="como__titulo">{c.titulo}</span>
              <span class="como__texto">{c.texto}</span>
            </li>
          ))
        }
      </ul>

      <ul class="formatos">
        {
          FORMATOS.map((f, i) => (
            <li class="formato" style={`--i:${i}`} data-reveal>
              <span class="formato__marca" aria-hidden="true">
                <Icon name={f.icono} class="h-5 w-5" />
              </span>
              <span class="formato__nombre">{f.nombre}</span>

              <ul class="formato__puntos">
                {f.puntos.map((punto) => (
                  <li>
                    <span class="formato__punta" aria-hidden="true" />
                    {punto}
                  </li>
                ))}
              </ul>

              <span class="formato__precio">
                <span class="formato__cifra numerals">{f.precio.valor} €</span>
                <span class="formato__unidad">{f.precio.unidad}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Los tramites. Es lo que mas alivia a quien se muda a Francia. -->
  <section class="tramites" aria-labelledby="tramites">
    <div class="shell py-section-sm">
      <div class="tramites__caja">
        <div>
          <h2 id="tramites" class="text-display-m text-encre" data-reveal>
            También te ayudo a preparar tus documentos profesionales
          </h2>
          <p class="measure mt-5 text-body text-nuit" data-reveal>
            Preparamos juntos el expediente de Campus France, y redacto y corrijo
            tu CV en francés. Es la parte que suele dar más miedo y la que más se
            agradece tener resuelta.
          </p>
        </div>
        <div class="tramites__accion" data-reveal>
          <Cta href="/agenda" variant="lie">{CTA.cierreQuienSoy}</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- Hablemos: el contacto vive aqui, no en una pagina aparte -->
  <section class="hablemos" id="hablemos" aria-labelledby="hablemos-titulo">
    <div class="shell py-section">
      <div class="hablemos__reparto">
        <div class="hablemos__texto">
          <p class="label text-lie" data-reveal>Hablemos</p>
          <h2 id="hablemos-titulo" class="hablemos__titulo" data-reveal>
            Si tienes una duda antes de empezar, escríbeme
          </h2>
          <p class="hablemos__apoyo" data-reveal>
            Te contesto yo, en persona. Y si lo que quieres es empezar ya,
            sáltate esto y coge hora directamente.
          </p>

          <div class="mt-8" data-reveal>
            <Cta href="/agenda" variant="lie">{CTA.cierreQuienSoy}</Cta>
          </div>
        </div>

        <form
          class="hablemos__forma"
          method="post"
          action="/api/contacto"
          data-contacto
          data-reveal
          novalidate
        >
          {/* Campo trampa. Invisible para personas, visible para robots. */}
          <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label for="hablemos-empresa">No rellenes este campo</label>
            <input id="hablemos-empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="campo campo--mitad">
            <label class="campo__etiqueta" for="hablemos-nombre">Nombre</label>
            <input class="campo__caja" id="hablemos-nombre" name="nombre" type="text"
              autocomplete="given-name" required />
            <p class="campo__error" data-error-nombre role="alert"></p>
          </div>

          <div class="campo campo--mitad">
            <label class="campo__etiqueta" for="hablemos-apellido">Apellido</label>
            <input class="campo__caja" id="hablemos-apellido" name="apellido" type="text"
              autocomplete="family-name" />
          </div>

          <div class="campo">
            <label class="campo__etiqueta" for="hablemos-correo">Correo</label>
            <input class="campo__caja" id="hablemos-correo" name="correo" type="email"
              autocomplete="email" required />
            <p class="campo__error" data-error-correo role="alert"></p>
          </div>

          <div class="campo">
            <label class="campo__etiqueta" for="hablemos-interes">Qué te interesa</label>
            <select class="campo__caja" id="hablemos-interes" name="interes" required>
              <option value="">Elige una</option>
              {INTERESES.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>

          <div class="campo">
            <label class="campo__etiqueta" for="hablemos-mensaje">Tu mensaje</label>
            <textarea class="campo__caja campo__caja--alto" id="hablemos-mensaje"
              name="mensaje" rows="4" required></textarea>
            <p class="campo__error" data-error-mensaje role="alert"></p>
          </div>

          <div class="campo">
            <button class="hablemos__boton" type="submit">Enviar</button>
            <p class="campo__aviso" data-contacto-message role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /**
   * El mismo lenguaje del inicio: degradados que entran y salen en blanco,
   * esquinas de 26px, las sombras nuevas y los titulares en la tipografia de
   * display con su escala.
   */
  /**
   * Tamaño, interlineado y tracking salen de la escala del sitio, no de un
   * clamp escrito a mano aqui. El unico valor propio es el grosor: los dos
   * titulares de portada del sitio van a 650, mas cuerpo que el 500 de la
   * escala pero sin llegar a gritar, y este es un titular de portada.
   */
  .cabecera__titulo {
    max-width: 13ch;
    font-family: var(--font-display);
    font-size: var(--text-display-xl);
    font-weight: 650;
    line-height: var(--text-display-xl--line-height);
    letter-spacing: var(--text-display-xl--letter-spacing);
    text-wrap: balance;
    color: var(--color-encre);
  }

  .cabecera__entrada {
    margin: 2rem 0 0;
    max-width: 52ch;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-nuit);
  }


  /**
   * Entra y sale en blanco, como las secciones del inicio. Antes era un baño
   * rosa de arriba abajo, y una pagina entera del mismo tono es lo que hacia
   * que esto pareciera muerto.
   */
  .cabecera {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 34%, var(--color-blanc)) 34%,
      color-mix(in srgb, var(--color-papier) 44%, var(--color-blanc)) 62%,
      color-mix(in srgb, var(--color-papier) 12%, var(--color-blanc)) 88%,
      var(--color-blanc) 100%
    );
  }


  .clases {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 52%, var(--color-blanc)) 30%,
      color-mix(in srgb, var(--color-papier) 40%, var(--color-blanc)) 70%,
      var(--color-blanc) 100%
    );
  }

  .tramites {
    background-color: var(--color-blanc);
  }

  /* --- Los idiomas --- */

  .idiomas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .idiomas__uno {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 14px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-flota);
    padding: 0.6rem 1rem 0.6rem 0.7rem;
  }

  .idiomas__nombre {
    font-family: var(--font-display);
    font-size: var(--text-body-s);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-encre);
  }

  /* Entran escalonados, de izquierda a derecha. El retardo va por variable
     para no repetir cinco reglas iguales cambiando un numero. */
  :global(.js) .idiomas[data-reveal] .idiomas__uno {
    opacity: 0;
    transform: translateY(12px);
  }

  .idiomas[data-reveal].is-revealed .idiomas__uno {
    opacity: 1;
    transform: none;
    transition:
      opacity 560ms var(--ease-fluid) calc(var(--i, 0) * 80ms),
      transform 560ms var(--ease-fluid) calc(var(--i, 0) * 80ms);
  }

  /* --- Como es una clase --- */

  .clases__titulo {
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: var(--text-display-l);
    font-weight: var(--text-display-l--font-weight);
    line-height: var(--text-display-l--line-height);
    letter-spacing: var(--text-display-l--letter-spacing);
    text-wrap: balance;
    color: var(--color-encre);
  }

  /* --- Las tres marcas --- */

  .como {
    display: grid;
    gap: 1.75rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .como {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .como__uno {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
  }

  .como__marca {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    width: 2.75rem;
    margin-bottom: 0.35rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-ciel) 34%, var(--color-blanc));
    color: var(--color-nuit);
  }

  .como__titulo {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-encre);
  }

  .como__texto {
    max-width: 34ch;
    font-size: var(--text-body-s);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-encre) 70%, transparent);
  }

  /* --- Los dos formatos --- */

  .formatos {
    display: grid;
    gap: 1.25rem;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .formatos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .formato {
    position: relative;
    isolation: isolate;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: start;
    border-radius: 22px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-flota);
    padding: 1.75rem 1.6rem;
    transition:
      transform 520ms var(--ease-fluid),
      box-shadow 520ms var(--ease-fluid);
  }

  /* El degradado del estado activo se funde por opacidad, que es lo unico que
     se puede animar de forma continua en un degradado. Igual que en el inicio. */
  .formato::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-image: linear-gradient(
      to bottom,
      var(--color-encre) 0%,
      var(--color-encre) 30%,
      var(--color-nuit) 100%
    );
    opacity: 0;
    transition: opacity 520ms var(--ease-fluid);
  }

  .formato__marca {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    width: 2.75rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-papier) 70%, var(--color-blanc));
    color: var(--color-lie);
    transition:
      background-color 420ms var(--ease-fluid),
      color 420ms var(--ease-fluid);
  }

  .formato__nombre {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-encre);
    transition: color 420ms var(--ease-fluid);
  }

  .formato__puntos {
    display: grid;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .formato__puntos li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    font-size: var(--text-body-s);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-encre) 74%, transparent);
    transition: color 420ms var(--ease-fluid);
  }

  .formato__punta {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
    transition: background-color 420ms var(--ease-fluid);
  }

  /* El precio abajo del todo, y a la misma altura en las dos tarjetas aunque
     una lleve un punto mas largo. */
  .formato__precio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: var(--text-body-s);
    color: color-mix(in srgb, var(--color-encre) 58%, transparent);
    transition: color 420ms var(--ease-fluid);
  }

  .formato__cifra {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.1;
    color: color-mix(in srgb, var(--color-encre) 82%, transparent);
    transition: color 420ms var(--ease-fluid);
  }

  /* --- Estado activo --- */

  .formato:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-alta);
  }

  .formato:hover::before {
    opacity: 1;
  }

  .formato:hover .formato__marca {
    background-color: color-mix(in srgb, var(--color-blanc) 16%, transparent);
    color: var(--color-blanc);
  }

  .formato:hover .formato__nombre {
    color: var(--color-blanc);
  }

  .formato:hover .formato__puntos li,
  .formato:hover .formato__precio {
    color: var(--color-ciel);
  }

  .formato:hover .formato__cifra {
    color: color-mix(in srgb, var(--color-blanc) 88%, transparent);
  }

  .formato:hover .formato__punta {
    background-color: var(--color-corail);
  }

  /* --- Entradas escalonadas --- */

  :global(.js) .como__uno[data-reveal],
  :global(.js) .formato[data-reveal] {
    transform: translateY(28px) scale(0.985);
  }

  .como__uno[data-reveal],
  .formato[data-reveal] {
    transition:
      opacity 760ms var(--ease-fluid) calc(var(--i, 0) * 90ms),
      transform 760ms var(--ease-fluid) calc(var(--i, 0) * 90ms) !important;
  }

  .como__uno[data-reveal].is-revealed,
  .formato[data-reveal].is-revealed {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .formato,
    .formato::before,
    .formato__marca,
    .formato__nombre,
    .formato__puntos li,
