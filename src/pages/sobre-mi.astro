---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import retrato from '../assets/aline-retrato.png';
import Cta from '../components/Cta.astro';
import { breadcrumb, alineId } from '../lib/schema';
import { CTA } from '../data/site';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Sobre mí', path: '/sobre-mi' },
];

/**
 * Person de Aline. Es el nodo que las demas paginas referencian como provider.
 *
 * TODO [PENDIENTE] alumniOf: falta el nombre de la institucion donde estudio
 * Gestion de la Cultura. Hasta tenerlo, el titulo se declara con
 * hasCredential, que no exige nombrar organizacion, en vez de inventar una.
 */
const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': alineId(Astro.site),
  name: 'Aline',
  jobTitle: 'Profesora de francés',
  description:
    'Profesora francesa de francés para hispanohablantes. Formada en pedagogía y métodos de aprendizaje, habla cinco idiomas y lleva más de cinco años enseñando.',
  nationality: { '@type': 'Country', name: 'Francia' },
  knowsLanguage: [
    { '@type': 'Language', name: 'Francés' },
    { '@type': 'Language', name: 'Español' },
    { '@type': 'Language', name: 'Inglés' },
    { '@type': 'Language', name: 'Italiano' },
    { '@type': 'Language', name: 'Portugués' },
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Estudios universitarios',
    name: 'Gestión de la Cultura',
  },
  knowsAbout: [
    'Enseñanza del francés como lengua extranjera',
    'Preparación del examen DELF',
    'Expediente Campus France',
    'Redacción y corrección de CV en francés',
    'Gestión cultural',
  ],
};

const schema = [persona, breadcrumb(migas, Astro.site)];

/**
 * Lo que se puede pedir en Hablemos. El interes no es decoracion: es lo que
 * permite saber que oferta trae a cada persona, y por tanto donde merece la
 * pena invertir. Sin ese dato, cada mensaje es anonimo en cuanto a origen.
 */
const INTERESES = [
  'Clases privadas',
  'Clases en grupo',
  'Preparación del DELF',
  'Talleres en París',
  'Tours por París',
  'Otra cosa',
];


/**
 * Cada idioma escrito en su propio idioma.
 *
 * Antes eran cinco fichas con etiqueta debajo (materna, bilingue, aprendido)
 * y un pie explicandolo: treinta palabras para decir que habla cinco idiomas.
 * Escritos asi no hace falta ninguna etiqueta, porque la lista se demuestra
 * sola en cuanto se lee.
 */
const IDIOMAS = ['Français', 'Español', 'English', 'Italiano', 'Português'];


/**
 * Los dos formatos, tratados igual: mismo tamano, mismo sitio, misma
 * estructura de frase. Antes la pagina soltaba "poesia", "fotografia" y
 * luego "teatro, pintura, cine" agrupados, y esa asimetria hacia parecer que
 * unos temas contaban mas que otros.
 */
const FORMATOS = [
  {
    nombre: 'Clases privadas',
    texto:
      'Adapto el contenido a tus preferencias y a tus objetivos. La poesía, la fotografía, el teatro, la pintura, el cine o el tema que te mueva: te doy las bases para hablar de ello en francés.',
  },
  {
    nombre: 'Clases en grupo',
    texto:
      'Avanzamos por niveles, con acompañamiento y con el progreso a la vista. Cada persona sabe en qué punto está y qué viene después.',
  },
];


---

<BaseLayout
  title="Sobre mí: profesora francesa de francés, y cinco idiomas"
  description="El francés es mi lengua y hablo cinco idiomas. Me formé en pedagogía y monto cada clase alrededor de lo que te gusta. También te acompaño con Campus France y con tu CV en francés."
  path="/sobre-mi"
  schema={schema}
>
  <!-- Apertura -->
  <section class="cabecera overflow-hidden">
    <div
      class="pad-shell-left grid items-center gap-12 pb-section pt-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16"
    >
      <div class="pad-shell-right lg:pr-0">
        <h1 class="cabecera__titulo" data-reveal>
          Enseño francés para que lo hables con soltura
        </h1>
        <p class="measure mt-7 text-body text-nuit" data-reveal>
          Es mi lengua materna. Los otros cuatro los aprendí de adulta, así que
          sé por dónde vas a pasar. Me formé en pedagogía y llevo más de cinco
          años enseñando.
        </p>

        <ul class="idiomas" data-reveal>
          {
            IDIOMAS.map((idioma, i) => (
              <li class="idiomas__uno" style={`--i:${i}`}>
                {i === 0 ? <em class="destacado">{idioma}</em> : idioma}
              </li>
            ))
          }
        </ul>
      </div>

      {/* El retrato viene recortado, sin fondo. Por eso no va dentro de un
          marco: se apoya sobre una forma de color y la tapa por delante, que
          es lo que le da profundidad a una foto sin fondo. */}
      {/* El envoltorio devuelve el relleno de la derecha, que la rejilla solo
          pone a la izquierda: sin el, en movil la foto quedaba doce puntos
          descentrada. En pantalla ancha se quita para que la forma pueda
          salirse por el canto. */}
      <div class="pad-shell-right lg:pr-0" data-reveal="fade">
        <div class="retrato">
          <Picture
            src={retrato}
            formats={['avif', 'webp']}
            {/* El respaldo tambien en webp: por defecto Astro lo deja en el
                formato de origen, y ahi eran 1,4 MB de PNG que nadie llega a
                descargar pero que quedan en el paquete. */}
            fallbackFormat="webp"
            widths={[420, 620, 840]}
            sizes="(min-width: 64rem) 26rem, (min-width: 48rem) 22rem, 78vw"
            alt="Aline, profesora de francés"
            loading="eager"
            class="retrato__img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Como ensena. Los dos formatos, con el mismo peso. -->
  <section class="clases" aria-labelledby="clases">
    <div class="shell py-section">
      <div class="clases__reparto">
        <div>
          <h2 id="clases" class="text-display-l text-encre" data-reveal>
            Así es una clase conmigo
          </h2>
          <p class="measure mt-6 text-body text-encre" data-reveal>
            Me formé en pedagogía y en métodos de aprendizaje, y llevo más de
            cinco años dando clase. Trabajo sobre todo con gente que habla
            español o inglés, con talleres de conversación y clases hechas a la
            medida de cada quien.
          </p>
          <p class="measure mt-5 text-body text-encre" data-reveal>
            Cuando algo se atasca cambio a tu idioma, lo aclaramos y seguimos.
            Una escuela europea de idiomas me seleccionó para enseñar a
            estudiantes en Canadá, Reino Unido y Francia, y ahí aprendí que el
            mismo contenido llega distinto según de dónde viene quien escucha.
          </p>
        </div>

        <dl class="formatos" data-reveal>
          {
            FORMATOS.map((f) => (
              <div class="formatos__uno">
                <dt class="formatos__nombre">{f.nombre}</dt>
                <dd class="formatos__texto">{f.texto}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Los tramites. Es lo que mas alivia a quien se muda a Francia. -->
  <section class="tramites" aria-labelledby="tramites">
    <div class="shell py-section-sm">
      <div class="tramites__caja">
        <div>
          <h2 id="tramites" class="text-display-m text-encre" data-reveal>
            También te ayudo a preparar tus documentos profesionales
          </h2>
          <p class="measure mt-5 text-body text-nuit" data-reveal>
            Preparamos juntos el expediente de Campus France, y redacto y corrijo
            tu CV en francés. Es la parte que suele dar más miedo y la que más se
            agradece tener resuelta.
          </p>
        </div>
        <div class="tramites__accion" data-reveal>
          <Cta href="/agenda" variant="lie">{CTA.cierreQuienSoy}</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- Hablemos: el contacto vive aqui, no en una pagina aparte -->
  <section class="hablemos" id="hablemos" aria-labelledby="hablemos-titulo">
    <div class="shell py-section">
      <div class="hablemos__reparto">
        <div class="hablemos__texto">
          <p class="label text-lie" data-reveal>Hablemos</p>
          <h2 id="hablemos-titulo" class="hablemos__titulo" data-reveal>
            Si tienes una duda antes de empezar, escríbeme
          </h2>
          <p class="hablemos__apoyo" data-reveal>
            Te contesto yo, en persona. Y si lo que quieres es empezar ya,
            sáltate esto y coge hora directamente.
          </p>

          <div class="mt-8" data-reveal>
            <Cta href="/agenda" variant="lie">{CTA.cierreQuienSoy}</Cta>
          </div>
        </div>

        <form
          class="hablemos__forma"
          method="post"
          action="/api/contacto"
          data-contacto
          data-reveal
          novalidate
        >
          {/* Campo trampa. Invisible para personas, visible para robots. */}
          <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label for="hablemos-empresa">No rellenes este campo</label>
            <input id="hablemos-empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="campo campo--mitad">
            <label class="campo__etiqueta" for="hablemos-nombre">Nombre</label>
            <input class="campo__caja" id="hablemos-nombre" name="nombre" type="text"
              autocomplete="given-name" required />
            <p class="campo__error" data-error-nombre role="alert"></p>
          </div>

          <div class="campo campo--mitad">
            <label class="campo__etiqueta" for="hablemos-apellido">Apellido</label>
            <input class="campo__caja" id="hablemos-apellido" name="apellido" type="text"
              autocomplete="family-name" />
          </div>

          <div class="campo">
            <label class="campo__etiqueta" for="hablemos-correo">Correo</label>
            <input class="campo__caja" id="hablemos-correo" name="correo" type="email"
              autocomplete="email" required />
            <p class="campo__error" data-error-correo role="alert"></p>
          </div>

          <div class="campo">
            <label class="campo__etiqueta" for="hablemos-interes">Qué te interesa</label>
            <select class="campo__caja" id="hablemos-interes" name="interes" required>
              <option value="">Elige una</option>
              {INTERESES.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>

          <div class="campo">
            <label class="campo__etiqueta" for="hablemos-mensaje">Tu mensaje</label>
            <textarea class="campo__caja campo__caja--alto" id="hablemos-mensaje"
              name="mensaje" rows="4" required></textarea>
            <p class="campo__error" data-error-mensaje role="alert"></p>
          </div>

          <div class="campo">
            <button class="hablemos__boton" type="submit">Enviar</button>
            <p class="campo__aviso" data-contacto-message role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /**
   * El mismo lenguaje del inicio: degradados que entran y salen en blanco,
   * esquinas de 26px, las sombras nuevas y los titulares en la tipografia de
   * display con su escala.
   */
  .cabecera__titulo {
    margin-top: 1.5rem;
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: var(--text-display-xl);
    font-weight: var(--text-display-xl--font-weight);
    line-height: var(--text-display-xl--line-height);
    letter-spacing: var(--text-display-xl--letter-spacing);
    text-wrap: balance;
    color: var(--color-encre);
  }

  .cabecera {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 40%, var(--color-blanc)) 30%,
      color-mix(in srgb, var(--color-papier) 20%, var(--color-blanc)) 72%,
      var(--color-blanc) 100%
    );
  }

  .clases {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 52%, var(--color-blanc)) 30%,
      color-mix(in srgb, var(--color-papier) 40%, var(--color-blanc)) 70%,
      var(--color-blanc) 100%
    );
  }

  .tramites {
    background-color: var(--color-blanc);
  }

  /* --- Los idiomas --- */

  /**
   * Una linea de tipografia, no una tabla de datos. El francés va con la
   * italica del inicio, que es el mismo recurso que usa la portada para
   * marcar esa palabra.
   */
  .idiomas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-encre);
  }

  .idiomas__uno {
    display: inline-flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  /* El punto separador va en el elemento, no entre etiquetas: asi no se cuela
     en el texto que lee un lector de pantalla. */
  .idiomas__uno:not(:last-child)::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-encre) 32%, transparent);
    translate: 0 -0.32em;
  }

  /* Entran escalonados, de izquierda a derecha. El retardo va por variable
     para no repetir cinco reglas iguales cambiando un numero. */
  :global(.js) .idiomas[data-reveal] .idiomas__uno {
    opacity: 0;
    transform: translateY(12px);
  }

  .idiomas[data-reveal].is-revealed .idiomas__uno {
    opacity: 1;
    transform: none;
    transition:
      opacity 620ms var(--ease-fluid) calc(var(--i, 0) * 90ms),
      transform 620ms var(--ease-fluid) calc(var(--i, 0) * 90ms);
  }

  /* --- Como es una clase --- */

  .clases__reparto {
    display: grid;
    gap: 2.5rem;
  }

  @media (width >= 64rem) {
    .clases__reparto {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
    }
  }

  .formatos {
    display: grid;
    /* Misma altura las dos aunque un texto sea mas largo: si una caja crece,
       parece la importante. */
    grid-auto-rows: 1fr;
    gap: 1rem;
    margin: 0;
    align-content: start;
  }

  /* Las dos cajas iguales: mismo fondo, mismo relleno, mismo borde. Si una se
     ve mas importante que la otra, el lector deduce que lo es. */
  .formatos__uno {
    border-radius: 22px;
    background-color: color-mix(in srgb, var(--color-blanc) 78%, transparent);
    box-shadow: var(--shadow-flota);
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .formatos__nombre {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    color: var(--color-encre);
  }

  .formatos__texto {
    margin: 0.5rem 0 0;
    font-size: var(--text-body-s);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-encre) 74%, transparent);
  }

  /* --- Los tramites --- */

  .tramites__caja {
    display: grid;
    gap: 2rem;
    border-radius: 26px;
    background-color: color-mix(in srgb, var(--color-papier) 40%, var(--color-blanc));
    padding: 2.25rem 1.75rem;
  }

  @media (width >= 64rem) {
    .tramites__caja {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: center;
      gap: 3rem;
      padding: 2.75rem 3rem;
    }
  }

  .tramites__accion {
    justify-self: start;
  }

  @media (width >= 64rem) {
    .tramites__accion {
      justify-self: end;
    }
  }

  /* --- El retrato --- */

  /**
   * Redondo. Ni una punta.
   *
   * El sitio se sostiene sobre formas redondas desde el principio: el ojo del
   * logotipo y las aperturas. Un cuadrado con las esquinas a 28px se salia de
   * ahi, y ademas volvia a plantear el problema del canto recto. Con un
   * circulo no hay canto que justificar: el borde es la forma.
   *
   * Cuadrada de proporcion a proposito: con 1/1 la foto entra recortada al
   * 71 por ciento y el colgante, que esta al 84, queda fuera.
   */
  .retrato {
    position: relative;
    width: min(23rem, 100%);
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 50%;
    background-image: radial-gradient(
      circle at 50% 26%,
      color-mix(in srgb, var(--color-chair) 32%, var(--color-papier)) 0%,
      color-mix(in srgb, var(--color-papier) 86%, var(--color-blanc)) 48%,
      color-mix(in srgb, var(--color-papier) 44%, var(--color-blanc)) 100%
    );
    box-shadow: var(--shadow-flota);
  }

  .retrato__img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  /* --- Hablemos --- */

  .hablemos {
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 48%, var(--color-blanc)) 26%,
      color-mix(in srgb, var(--color-papier) 62%, var(--color-blanc)) 62%,
      color-mix(in srgb, var(--color-papier) 30%, var(--color-blanc)) 88%,
      var(--color-blanc) 100%
    );
  }

  .hablemos__reparto {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (width >= 64rem) {
    .hablemos__reparto {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
    }

    /* El texto se queda a la vista mientras se rellena el formulario. */
    .hablemos__texto {
      position: sticky;
      top: 7rem;
    }
  }

  .hablemos__titulo {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: var(--text-display-l);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--color-encre);
    max-width: 18ch;
    text-wrap: balance;
  }

  .hablemos__apoyo {
    margin-top: 1.25rem;
    max-width: 42ch;
    font-size: var(--text-body);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-encre) 72%, transparent);
  }

  /* --- El formulario --- */

  .hablemos__forma {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    border-radius: 26px;
    background-color: var(--color-blanc);
    box-shadow: var(--shadow-flota);
    padding: 2rem 1.75rem;
  }

  .campo {
    grid-column: 1 / -1;
  }

  /* Nombre y apellido comparten fila en cuanto hay sitio. */
  @media (width >= 30rem) {
    .campo--mitad {
      grid-column: span 1;
    }
  }

  .campo__etiqueta {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-size: var(--text-body-s);
    font-weight: 600;
    color: var(--color-encre);
  }

  .campo__caja {
    width: 100%;
    min-height: 3rem;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--color-encre) 16%, transparent);
    background-color: color-mix(in srgb, var(--color-papier) 26%, var(--color-blanc));
    padding: 0.7rem 0.9rem;
    font-family: var(--font-body);
    font-size: var(--text-body-s);
    color: var(--color-encre);
    transition:
      border-color var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth);
  }

  .campo__caja--alto {
    min-height: 7rem;
    resize: vertical;
  }

  .campo__caja:focus {
    outline: 2px solid var(--color-grenat);
    outline-offset: 2px;
    border-color: transparent;
    background-color: var(--color-blanc);
  }

  /* El error se dice con texto, nunca solo con color. */
  .campo__error:not(:empty) {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-grenat);
  }

  .campo__aviso:not(:empty) {
    margin-top: 0.9rem;
    font-size: var(--text-body-s);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-encre) 78%, transparent);
  }

  .hablemos__boton {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background-color: var(--color-grenat);
    padding-inline: 2rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-blanc);
    transition:
      transform var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .hablemos__boton:hover {
    transform: translateY(-2px);
    background-color: var(--color-lie);
    box-shadow: var(--shadow-lift);
  }

  .hablemos__boton:active {
    transform: none;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .idiomas[data-reveal].is-revealed .idiomas__uno,
    .campo__caja,
    .hablemos__boton {
      transition: none;
    }

    .hablemos__boton:hover {
      transform: none;
    }
  }
</style>
