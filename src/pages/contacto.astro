---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import { breadcrumb } from '../lib/schema';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto' },
];

const schema = [breadcrumb(migas, Astro.site)];
---

<BaseLayout
  title="Contacto: escríbeme y te contesto yo"
  description="Escríbeme si tienes una duda que no está en las preguntas frecuentes, o si prefieres cerrar la clase gratis por correo en vez de por el calendario."
  path="/contacto"
  schema={schema}
>
  <section class="bg-blanc">
    <div class="shell pb-section-sm pt-6">
      <Breadcrumbs items={migas} />
      <p class="label mt-8 text-nuit">Contacto</p>
      <h1 class="mt-5 max-w-[20ch] text-display-xl text-encre">Escríbeme</h1>
      <p class="measure mt-7 text-body text-nuit">
        Contesto yo, no un equipo. Si tu duda es sobre horarios, niveles o si
        esto te sirve, escríbeme y te digo lo que pienso, aunque la respuesta sea
        que no soy la persona indicada.
      </p>
    </div>
  </section>

  <section class="bg-papier">
    <div class="shell grid gap-12 py-section lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <h2 class="text-display-m text-encre">Antes de escribir</h2>
          <p class="measure mt-4 text-body text-nuit">
            Si tu pregunta es de las habituales, probablemente ya esté contestada
            y te ahorras la espera.
          </p>
          <ul class="mt-6 flex flex-col gap-3 text-body">
            <li>
              <a
                href="/#preguntas"
                class="inline-flex min-h-11 items-center text-bleu underline underline-offset-4 hover:no-underline"
                >Preguntas frecuentes</a
              >
            </li>
            <li>
              <a
                href="/precios"
                class="inline-flex min-h-11 items-center text-bleu underline underline-offset-4 hover:no-underline"
                >Precios y bonos</a
              >
            </li>
            <li>
              <a
                href="/como-es-una-clase"
                class="inline-flex min-h-11 items-center text-bleu underline underline-offset-4 hover:no-underline"
                >Cómo es una clase</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div class="lg:col-span-7 lg:col-start-6">
        <form
          class="w-full"
          method="post"
          action="/api/contacto"
          data-contacto
          novalidate
        >
          <div
            class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden"
            aria-hidden="true"
          >
            <label for="contacto-empresa">No rellenes este campo</label>
            <input
              id="contacto-empresa"
              name="empresa"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-2">
              <label for="contacto-nombre" class="label text-nuit">
                Tu nombre <span aria-hidden="true">*</span>
              </label>
              <input
                id="contacto-nombre"
                name="nombre"
                type="text"
                required
                aria-required="true"
                autocomplete="name"
                class="min-h-[52px] rounded-panel border border-encre/25 bg-blanc px-4 py-3 text-body-s text-encre"
              />
              <p data-error-nombre role="alert" class="text-body-s text-lie"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="contacto-correo" class="label text-nuit">
                Tu correo <span aria-hidden="true">*</span>
              </label>
              <input
                id="contacto-correo"
                name="correo"
                type="email"
                required
                aria-required="true"
                autocomplete="email"
                class="min-h-[52px] rounded-panel border border-encre/25 bg-blanc px-4 py-3 text-body-s text-encre"
              />
              <p data-error-correo role="alert" class="text-body-s text-lie"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="contacto-mensaje" class="label text-nuit">
                Tu mensaje <span aria-hidden="true">*</span>
              </label>
              <textarea
                id="contacto-mensaje"
                name="mensaje"
                required
                aria-required="true"
                rows="7"
                class="rounded-panel border border-encre/25 bg-blanc px-4 py-3 text-body-s text-encre"
              ></textarea>
              <p data-error-mensaje role="alert" class="text-body-s text-lie"></p>
              <p class="text-body-s text-nuit">
                Cuéntame para qué necesitas el francés y en qué punto estás. Con
                eso te contesto algo útil y no un mensaje genérico.
              </p>
            </div>
          </div>

          <div class="mt-8">
            <Cta type="submit">Enviar el mensaje</Cta>
          </div>

          <p
            data-contacto-message
            role="status"
            aria-live="polite"
            class="mt-4 text-body-s text-encre"
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
