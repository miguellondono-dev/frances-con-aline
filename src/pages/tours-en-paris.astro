---
import BaseLayout from '../layouts/BaseLayout.astro';
import Aperture from '../components/Aperture.astro';
import ChatWhatsapp from '../components/ChatWhatsapp.astro';
import { breadcrumb } from '../lib/schema';
import { PENDIENTE, WA } from '../data/site';
import { getImage } from 'astro:assets';
import parisSena from '../assets/paris-sena.jpg';

/**
 * La portada lleva el dibujo de Paris con el Sena, el barco y la torre, el
 * mismo trazo que el fondo del inicio, dentro del ojo de la marca. Sustituye
 * al hueco "Pendiente" hasta que haya una foto real de un recorrido.
 */
const dibujo = await getImage({ src: parisSena, width: 900, format: 'webp' });

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Tours en París', path: '/tours-en-paris' },
];

const schema = [breadcrumb(migas, Astro.site)];
---

<BaseLayout
  title="Tours"
  description="Recorridos por París en español con una gestora cultural francesa, para familias y grupos de amigos. Déjame tu correo y te aviso de las primeras fechas."
  path="/tours-en-paris"
  schema={schema}
>
  <section class="overflow-hidden bg-blanc">
    <div
      class="pad-shell-left grid items-center gap-12 pb-section pt-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16"
    >
      <div class="pad-shell-right lg:pr-0">
        <p class="label mt-8 text-nuit" data-reveal>Presencial, en París</p>
        <h1 class="mt-5 max-w-[20ch] text-display-xl text-encre" data-palabras data-repite>
          <em class="destacado">París</em> contado por quien estudió cómo se cuenta
        </h1>
        <p class="measure mt-7 text-body text-nuit" data-reveal>
          Estudié Gestión de la Cultura, así que un recorrido conmigo no es una
          lista de fechas delante de un edificio. Es por qué ese barrio quedó
          así, quién decidió que quedara así y qué se discutía entonces.
        </p>
        <p class="measure mt-5 text-body text-nuit" data-reveal>
          En español, para que no te pierdas la mitad. Están en construcción:
          todavía no hay recorridos cerrados ni precio.
        </p>
      </div>

      <div class="pad-shell-right lg:pr-0" data-reveal="fade">
        {/* TODO [PENDIENTE: foto real] Una foto de un recorrido. Mientras, el dibujo. */}
        <Aperture
          alt="Dibujo de París: el Sena con un barco, un puente y la torre Eiffel al fondo"
          todo="Calle de Montmartre"
          src={dibujo.src}
          ratio="aspect-[4/5]"
          lids
          lidColor="blanc"
          eager
          class="tours__dibujo mx-auto w-full max-w-[24rem]"
        />
      </div>
    </div>
  </section>

  <section class="fondo-calido" aria-labelledby="para-quien">
    <div class="shell py-section">
      <h2 id="para-quien" class="titulo-seccion max-w-[22ch] text-encre" data-reveal>
        Pensados para ir en grupo pequeño
      </h2>

      <div class="mt-12 grid gap-10 lg:grid-cols-3 lg:gap-8">
        <div data-reveal>
          <h3 class="text-display-m text-encre">Familias</h3>
          <p class="mt-4 text-body text-nuit">
            El ritmo se ajusta a quien va más lento y las paradas se eligen
            pensando en que haya dónde sentarse. Los niños no tienen que fingir
            interés por una fachada.
          </p>
        </div>
        <div data-reveal>
          <h3 class="text-display-m text-encre">Grupos de amigos</h3>
          <p class="mt-4 text-body text-nuit">
            Un recorrido privado, sin unirse a un grupo de treinta desconocidos
            siguiendo un paraguas de colores. Se puede parar a tomar algo y
            seguir.
          </p>
        </div>
        <div data-reveal>
          <h3 class="text-display-m text-encre">Quien ya estudia conmigo</h3>
          <p class="mt-4 text-body text-nuit">
            Si vienes a París y ya damos clase, el tour se puede hacer mitad en
            francés. Es la prueba de fuego de todo lo que trabajamos en línea.
          </p>
        </div>
      </div>

      <dl class="mt-16 grid gap-8 border-t border-encre/20 pt-10 sm:grid-cols-3" data-reveal>
        <div>
          <dt class="label text-nuit">Dónde</dt>
          <dd class="mt-2 text-body text-encre">París. Montmartre y otros barrios.</dd>
        </div>
        <div>
          <dt class="label text-nuit">Precio</dt>
          {/* TODO [PENDIENTE] Precio y formato definitivo de los tours. */}
          <dd class="mt-2 text-body text-encre">
            {PENDIENTE.precioTours ?? 'Lo anuncio con las primeras fechas'}
          </dd>
        </div>
        <div>
          <dt class="label text-nuit">Recorridos</dt>
          {/* TODO [PENDIENTE] Lista de recorridos y duracion. */}
          <dd class="mt-2 text-body text-encre">Privados, en grupo pequeño y en español</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="fondo-oscuro" aria-labelledby="lista">
    <div class="shell grid items-center gap-10 py-section lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <div>
        <h2 id="lista" class="titulo-seccion max-w-[20ch] text-blanc" data-reveal>
          Avísame cuando abra fechas
        </h2>
        <p class="measure mt-7 text-body text-ciel" data-reveal>
          Escríbeme y te aviso en cuanto haya fechas. Si ya sabes cuándo vienes
          a París, dímelo y lo tengo en cuenta al organizar los primeros
          recorridos.
        </p>
      </div>
      <ChatWhatsapp mensaje={WA.tours} boton="Avísame por WhatsApp" asunto="Avísame cuando abras fechas para los tours" />
    </div>
  </section>
</BaseLayout>

<style>
  /* El dibujo es trazo fino sobre blanco: sobre la pagina blanca, el ojo no
     tenia forma. Se multiplica sobre un fondo calido, que es lo que dibuja la
     almendra, y el encuadre se corre hacia la torre y el barco. */
  /* La clase la pinta Aperture, no esta pagina: el selector entero es global. */
  :global(.tours__dibujo .aperture) {
    background-color: color-mix(in srgb, var(--color-papier) 75%, var(--color-blanc));
  }

  :global(.tours__dibujo .aperture img) {
    mix-blend-mode: multiply;
    object-position: 62% 60%;
  }
</style>
