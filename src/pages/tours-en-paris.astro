---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Logo from '../components/Logo.astro';
import ChatWhatsapp from '../components/ChatWhatsapp.astro';
import Vocabulario from '../components/home/Thesis.astro';
import Metodo from '../components/home/Method.astro';
import { alineId, breadcrumb } from '../lib/schema';
import { WA, whatsapp } from '../data/site';

import parisSena from '../assets/paris-sena.jpg';
import parisTorre from '../assets/tours/paris-torre.jpg';
import parisOpera from '../assets/tours/paris-opera.jpg';

/**
 * TOURS EN PARIS.
 *
 * Rediseño de octubre de 2026. Miguel la veia plana y le molestaban dos
 * cosas: que hablara de los estudios de Aline en primera persona y que dijera
 * que los tours estaban "en construcción". Ahora cuenta Paris, no a Aline, y
 * lo que todavia no esta cerrado (fechas, precio, recorridos exactos) no se
 * anuncia como un hueco: todo lleva a escribir por WhatsApp para saber mas.
 *
 *  1. Portada partida: titular y botón a un lado; al otro, un collage con
 *     dos fotos de Paris (fotogramas del video de Miguel desde las Galerias
 *     de la Opera) y el dibujo del Sena, con una ruta de puntos por encima y
 *     una chincheta que la recorre. Todo entra en abanico y luego flota.
 *  2. La franja de vocabulario, con palabras de pasear Paris.
 *  3. Historias de Paris: cuatro tarjetas que se giran al tocarlas. Datos
 *     ciertos y comprobables de la ciudad, no de los recorridos.
 *  4. Así es un recorrido: la linea de pasos del inicio, que se rellena al
 *     bajar.
 *  5. Cierre calido con WhatsApp, como el resto de paginas.
 *
 * Sin JavaScript o con movimiento reducido todo se ve quieto y completo; las
 * tarjetas se pueden girar igual con el teclado.
 */
const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Tours en París', path: '/tours-en-paris' },
];

const schema = [
  breadcrumb(migas, Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: 'Tours a pie por París en español',
    description:
      'Recorridos a pie por los barrios de París, en español y en grupo pequeño, para familias y grupos de amigos.',
    inLanguage: 'es',
    touristType: ['Familias', 'Grupos de amigos', 'Estudiantes de francés'],
    provider: { '@id': alineId(Astro.site) },
    url: new URL('/tours-en-paris', Astro.site).href,
  },
];

/** Palabras de pasear Paris, para la franja. */
const VOCABULARIO_TOURS = [
  { fr: 'flâner', es: 'pasear sin rumbo' },
  { fr: 'le quartier', es: 'el barrio' },
  { fr: 'la balade', es: 'el paseo' },
  { fr: 'les quais', es: 'las orillas del Sena' },
  { fr: 'la butte', es: 'la colina' },
  { fr: 'le pont', es: 'el puente' },
  { fr: 'la terrasse', es: 'la terraza' },
  { fr: 'le bouquiniste', es: 'el librero del Sena' },
  { fr: 'la place', es: 'la plaza' },
  { fr: 'le marché', es: 'el mercado' },
];

/**
 * Cuatro historias de Paris. Solo hechos comprobables de la ciudad; no se
 * dice que esten en ningun recorrido concreto.
 */
const HISTORIAS = [
  {
    pregunta: '¿La torre Eiffel iba a durar solo veinte años?',
    respuesta:
      'Se levantó para la Exposición Universal de 1889 con permiso para veinte años. Se salvó, entre otras cosas, porque resultó muy útil como antena de radio.',
  },
  {
    pregunta: '¿Montmartre era un pueblo?',
    respuesta:
      'Hasta 1860 quedaba fuera de París y tenía viñas y molinos de viento. Todavía queda una viña en la colina, y cada otoño se celebra su vendimia.',
  },
  {
    pregunta: '¿Dónde empiezan las carreteras de Francia?',
    respuesta:
      'Delante de Notre-Dame, en el suelo, hay una estrella de bronce: el kilómetro cero. Desde ahí se miden las distancias de París al resto del país.',
  },
  {
    pregunta: '¿Por qué tantas calles de París se parecen?',
    respuesta:
      'En el siglo XIX, el barón Haussmann rehízo media ciudad con reglas de altura y de fachada. Por eso tantos edificios tienen los balcones a la misma altura.',
  },
];

/** Así es un recorrido, en cuatro paradas. Lo que ya se sabia del formato. */
const PARADAS = [
  {
    titulo: 'En español, sin perderte nada',
    texto:
      'Todo se cuenta en español. Si ya estudias francés conmigo, una parte puede ser en francés.',
  },
  {
    titulo: 'Solo tu grupo',
    texto: 'Recorridos privados para tu familia o tus amigos, sin seguir un paraguas entre treinta desconocidos.',
  },
  {
    titulo: 'A vuestro ritmo',
    texto: 'Paradas para sentarse, para una foto o para tomar algo. El paseo se adapta a quien va más despacio.',
  },
  {
    titulo: 'Para entender lo que ves',
    texto: 'No es una lista de fechas delante de un edificio: es por qué cada barrio es como es.',
  },
];
---

<BaseLayout
  title="Tours"
  description="Tours a pie por París en español, en grupo pequeño, para familias y amigos. Las historias de cada barrio, contadas por el camino. Escríbeme y te cuento."
  path="/tours-en-paris"
  schema={schema}
>
  <!-- 1. PORTADA -->
  <section class="portada-tours" aria-labelledby="tours-titulo">
    <div class="shell portada-tours__reparto">
      <div class="portada-tours__texto">
        <h1 id="tours-titulo" class="titulo-portada max-w-[14ch] text-encre" data-palabras data-repite>
          París se entiende <em class="destacado">caminando</em>
        </h1>
        <p class="portada-tours__entrada" data-reveal>
          Tours a pie por París, en español, por los barrios donde se hizo la
          ciudad. En grupo pequeño, a tu ritmo y con tiempo para preguntar todo
          lo que una guía de bolsillo no cuenta.
        </p>

        <div class="portada-tours__acciones" data-reveal>
          <Cta href={whatsapp(WA.tours)}>Quiero saber más</Cta>
          <a class="enlace-flecha" href="#historias">
            Ver cómo son
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M8 2v12M3 9l5 5 5-5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>

        <ul class="pastillas" data-reveal>
          <li>En español</li>
          <li>Grupos pequeños</li>
          <li>Familias y amigos</li>
        </ul>
      </div>

      {/* El collage es decorado: las fotos repiten lo que dice el texto. */}
      <div class="collage-tours" aria-hidden="true">
        <div class="collage-tours__pieza collage-tours__pieza--dibujo" style="--giro: -7deg; --i: 0">
          <figure class="collage-tours__marco collage-tours__marco--dibujo">
            <Picture
              src={parisSena}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[360, 600]}
              sizes="(min-width: 64rem) 17rem, 50vw"
              loading="eager"
            />
          </figure>
        </div>
        <div class="collage-tours__pieza collage-tours__pieza--opera" style="--giro: 6deg; --i: 1">
          <figure class="collage-tours__marco">
            <Picture
              src={parisOpera}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[300, 480]}
              sizes="(min-width: 64rem) 13rem, 38vw"
              loading="eager"
            />
            <span class="collage-tours__etiqueta">La Ópera</span>
          </figure>
        </div>
        <div class="collage-tours__pieza collage-tours__pieza--torre" style="--giro: -2deg; --i: 2">
          <figure class="collage-tours__marco">
            <Picture
              src={parisTorre}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[360, 560, 760]}
              sizes="(min-width: 64rem) 19rem, 56vw"
              loading="eager"
            />
            <span class="collage-tours__etiqueta collage-tours__etiqueta--roja">Los tejados</span>
          </figure>
        </div>

        {/* La ruta: puntos que avanzan y una chincheta que la recorre. */}
        <svg class="ruta" viewBox="0 0 480 520" preserveAspectRatio="xMidYMid meet">
          <path
            id="ruta-tours"
            class="ruta__camino"
            d="M38 478 C 110 430, 70 340, 170 318 S 330 300, 312 196 S 392 78, 448 56"></path>
          <circle class="ruta__inicio" cx="38" cy="478" r="6"></circle>
          <g class="ruta__chincheta">
            <circle r="13" class="ruta__halo"></circle>
            <circle r="7" class="ruta__punto"></circle>
            <animateMotion dur="9s" repeatCount="indefinite" rotate="0" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
              <mpath href="#ruta-tours"></mpath>
            </animateMotion>
          </g>
        </svg>

        <div class="sello-tours">
          <svg class="sello-tours__texto" viewBox="0 0 120 120">
            <defs>
              <path id="sello-tours-circulo" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0"></path>
            </defs>
            <text>
              <textPath href="#sello-tours-circulo" textLength="292">TOURS · EN ESPAÑOL · PARÍS ·</textPath>
            </text>
          </svg>
          <span class="sello-tours__ojo"><Logo viewBox="195 258 860 691" /></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. FRANJA DE VOCABULARIO -->
  <Vocabulario palabras={VOCABULARIO_TOURS} etiqueta="Palabras para pasear París, con su traducción" />

  <!-- 3. HISTORIAS DE PARIS -->
  <section class="historias fondo-calido" id="historias" aria-labelledby="historias-titulo">
    <div class="shell py-section">
      <div class="historias__cabecera">
        <div>
          <p class="label text-lie" data-reveal>Historias de París</p>
          <h2 id="historias-titulo" class="titulo-seccion mt-4 max-w-[16ch] text-encre" data-palabras data-repite>
            Lo que París no cuenta a primera vista
          </h2>
        </div>
        <p class="historias__intro" data-reveal>
          Cada calle guarda una historia. Toca una tarjeta y descubre cuatro de
          ellas.
        </p>
      </div>

      <ul class="historias__lista" data-historias>
        {
          HISTORIAS.map((h, i) => (
            <li class="historias__item" data-reveal style={`--i: ${i}`}>
              <button class="historia" type="button" aria-pressed="false" data-historia>
                <span class="historia__interior">
                  <span class="historia__cara historia__cara--frente">
                    <span class="historia__fondo" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="historia__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="historia__pregunta">{h.pregunta}</span>
                    <span class="historia__pista" aria-hidden="true">
                      Descúbrelo
                      <svg viewBox="0 0 20 20" fill="none">
                        <path
                          d="M4 10a6 6 0 1 0 2-4.5M4 3v3h3"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </span>
                  <span class="historia__cara historia__cara--dorso">
                    <span class="historia__etiqueta">La historia</span>
                    <span class="historia__respuesta">{h.respuesta}</span>
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. ASI ES UN RECORRIDO -->
  <Metodo titulo="Así es un recorrido" pasos={PARADAS} fondo="bg-blanc" />

  <!-- 5. CIERRE -->
  {/* Calido y no oscuro: el pie ya es oscuro, y dos bloques oscuros seguidos
      se leian como uno solo. Asi cierran tambien las demas paginas. */}
  <section class="fondo-calido" aria-labelledby="tours-cierre">
    <div class="shell grid items-center gap-10 py-section lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <div>
        <p class="label text-lie" data-reveal>Hablemos</p>
        <h2 id="tours-cierre" class="titulo-seccion mt-4 max-w-[18ch] text-encre" data-palabras data-repite>
          ¿Te apetece descubrir París así?
        </h2>
        <p class="measure mt-6 text-body text-nuit" data-reveal>
          Escríbeme y te cuento cómo son los recorridos, por qué barrios van y
          qué días encajan con tu viaje.
        </p>
      </div>
      <ChatWhatsapp mensaje={WA.tours} boton="Quiero saber más" asunto="Quiero saber más de los tours por París" />
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Las tarjetas de historias se giran al tocarlas (o con Enter y espacio,
   * que ya hace el boton). La primera vez que la seccion se ve, la primera
   * tarjeta se gira sola un momento y vuelve: asi se entiende que se giran.
   */
  const lista = document.querySelector<HTMLElement>('[data-historias]');
  if (lista) {
    const tarjetas = Array.from(lista.querySelectorAll<HTMLButtonElement>('[data-historia]'));
    let tocada = false;
    const girar = (t: HTMLButtonElement, si: boolean) => t.setAttribute('aria-pressed', String(si));

    tarjetas.forEach((t) =>
      t.addEventListener('click', () => {
        tocada = true;
        girar(t, t.getAttribute('aria-pressed') !== 'true');
      }),
    );

    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducido && tarjetas[0]) {
      const io = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          io.disconnect();
          window.setTimeout(() => {
            if (tocada) return;
            girar(tarjetas[0], true);
            window.setTimeout(() => {
              if (!tocada) girar(tarjetas[0], false);
            }, 2200);
          }, 900);
        },
        { threshold: 0.5 },
      );
      io.observe(lista);
    }
  }
</script>

<style>
  /* --- 1. Portada --- */

  .portada-tours {
    position: relative;
    overflow: hidden;
    background-image: linear-gradient(
      to bottom,
      var(--color-blanc) 0%,
      color-mix(in srgb, var(--color-papier) 40%, var(--color-blanc)) 60%,
      var(--color-blanc) 100%
    );
  }

  .portada-tours__reparto {
    display: grid;
    gap: 3rem;
    padding-block: 2.5rem 5rem;
  }

  @media (width >= 64rem) {
    .portada-tours__reparto {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: 3rem;
      min-height: min(44rem, calc(100svh - 5rem));
      padding-block: 2rem 4rem;
    }
  }

  .portada-tours__entrada {
    margin-top: 1.5rem;
    max-width: 42ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-nuit);
  }

  .portada-tours__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .enlace-flecha {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-encre);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-encre) 30%, transparent);
    text-underline-offset: 5px;
    transition: text-decoration-color var(--duration-fast) var(--ease-smooth);
  }

  .enlace-flecha svg {
    width: 1rem;
    height: 1rem;
    transition: transform 320ms var(--ease-smooth);
  }

  .enlace-flecha:hover {
    text-decoration-color: var(--color-grenat);
  }

  .enlace-flecha:hover svg {
    transform: translateY(3px);
  }

  .pastillas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .pastillas li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-blanc) 75%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 12%, transparent);
    font-size: var(--text-body-s);
    font-weight: 500;
    color: var(--color-encre);
  }

  .pastillas li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--color-grenat);
  }

  /* --- El collage --- */

  .collage-tours {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 1 / 1.08;
    margin-inline: auto;
  }

  .collage-tours__pieza {
    position: absolute;
    animation:
      tours-entra 1.1s var(--ease-fluid) both,
      tours-flota 5.5s ease-in-out infinite alternate;
    animation-delay:
      calc(var(--i) * 0.14s + 0.15s),
      calc(var(--i) * 0.6s + 1.4s);
  }

  .collage-tours__pieza--dibujo {
    left: 0;
    top: 4%;
    width: 58%;
  }

  .collage-tours__pieza--opera {
    right: 2%;
    top: 0;
    width: 40%;
  }

  .collage-tours__pieza--torre {
    left: 26%;
    top: 30%;
    width: 50%;
  }

  @keyframes tours-entra {
    from {
      opacity: 0;
      transform: translateY(90px) rotate(0deg) scale(0.82);
    }
    to {
      opacity: 1;
      transform: rotate(var(--giro));
    }
  }

  @keyframes tours-flota {
    from {
      transform: rotate(var(--giro)) translateY(0);
    }
    to {
      transform: rotate(var(--giro)) translateY(-12px);
    }
  }

  .collage-tours__marco {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 6px solid var(--color-blanc);
    border-radius: 22px;
    background-color: var(--color-papier);
    box-shadow: var(--shadow-alta);
  }

  /* El dibujo es apaisado y de trazo fino: va mas ancho que alto, sobre el
     calido, y se multiplica para que el papel no se vea blanco. */
  .collage-tours__marco--dibujo {
    aspect-ratio: 5 / 4;
    background-color: color-mix(in srgb, var(--color-papier) 80%, var(--color-blanc));
  }

  .collage-tours__marco--dibujo :global(img) {
    mix-blend-mode: multiply;
  }

  .collage-tours__marco :global(picture),
  .collage-tours__marco :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collage-tours__etiqueta {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-encre);
    color: var(--color-blanc);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .collage-tours__etiqueta--roja {
    background-color: var(--color-grenat);
  }

  /* La foto de la Opera queda detras de la de los tejados por abajo: su
     etiqueta va arriba, donde se ve. */
  .collage-tours__pieza--opera .collage-tours__etiqueta {
    top: 0.7rem;
    bottom: auto;
  }

  /* La ruta: por encima de las fotos, como un mapa dibujado a mano. */
  .ruta {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .ruta__camino {
    fill: none;
    stroke: var(--color-grenat);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 10;
    opacity: 0.85;
    animation: ruta-avanza 1.4s linear infinite;
  }

  @keyframes ruta-avanza {
    to {
      stroke-dashoffset: -24;
    }
  }

  .ruta__inicio {
    fill: var(--color-blanc);
    stroke: var(--color-grenat);
    stroke-width: 3;
  }

  .ruta__punto {
    fill: var(--color-grenat);
    stroke: var(--color-blanc);
    stroke-width: 3;
  }

  .ruta__halo {
    fill: color-mix(in srgb, var(--color-grenat) 25%, transparent);
    transform-box: fill-box;
    transform-origin: center;
    animation: ruta-late 1.6s ease-out infinite;
  }

  @keyframes ruta-late {
    from {
      transform: scale(0.6);
      opacity: 0.9;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .sello-tours {
    position: absolute;
    left: 4%;
    bottom: 0;
    display: grid;
    place-items: center;
    width: clamp(5.5rem, 4rem + 5vw, 7.25rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--color-encre);
    color: var(--color-blanc);
    box-shadow: var(--shadow-alta);
    animation: tours-sello 0.9s 1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes tours-sello {
    from {
      transform: scale(0) rotate(-120deg);
    }
    to {
      transform: none;
    }
  }

  .sello-tours__texto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--color-ciel);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    animation: tours-gira 22s linear infinite;
  }

  .sello-tours__ojo {
    display: block;
    width: 44%;
  }

  .sello-tours__ojo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes tours-gira {
    to {
      transform: rotate(360deg);
    }
  }

